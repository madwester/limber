---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
 title: string;
 description: string;
 image?: string;
 schema?: object | object[];
 noindex?: boolean;
}

const {
 title,
 description,
 image = '/images/og-default.jpg',
 schema,
 noindex = false,
} = Astro.props;

const siteUrl = 'https://limberco.com.au';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const pageTitle =
 title === 'Home'
 ? 'Limber | Movement Studio'
 : `${title} | Limber`;

const localBusinessSchema = {
 '@context': 'https://schema.org',
 '@type': 'LocalBusiness',
 '@id': `${siteUrl}/#business`,
 name: 'Limber',
 url: siteUrl,
 logo: `${siteUrl}/images/logo.png`,
 image: `${siteUrl}/images/og-default.jpg`,
 email: 'hello@limberco.com.au',
 // TODO: fill in address, phone, openingHours
 address: {
 '@type': 'PostalAddress',
 addressCountry: 'AU',
 },
 sameAs: [
 // TODO: add Instagram, Facebook URLs
 ],
};
---

<!doctype html>
<html lang="en-AU">
 <head>
 <meta charset="UTF-8" />
 <meta name="viewport" content="width=device-width, initial-scale=1.0" />
 <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
 <link rel="canonical" href={canonicalURL} />
 {noindex && <meta name="robots" content="noindex, nofollow" />}

 <title>{pageTitle}</title>
 <meta name="description" content={description} />

 <!-- Open Graph -->
 <meta property="og:type" content="website" />
 <meta property="og:url" content={canonicalURL} />
 <meta property="og:title" content={pageTitle} />
 <meta property="og:description" content={description} />
 <meta property="og:image" content={`${siteUrl}${image}`} />
 <meta property="og:locale" content="en_AU" />
 <meta property="og:site_name" content="Limber" />

 <!-- Twitter -->
 <meta name="twitter:card" content="summary_large_image" />
 <meta name="twitter:title" content={pageTitle} />
 <meta name="twitter:description" content={description} />
 <meta name="twitter:image" content={`${siteUrl}${image}`} />

 <!-- Structured data -->
 <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
 {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

 <!--
 Google Fonts: Cormorant Garamond + Lato
 Candu is self-hosted — see public/fonts/ and global.css
 -->
 <link rel="preconnect" href="https://fonts.googleapis.com" />
 <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
 <link
 href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Lato:wght@300;400;700&display=swap"
 rel="stylesheet"
 />
 </head>
 <!-- body bg is Cream 30% per brand guide; text is Limber Brown -->
 <body class="bg-limber-cream-bg text-limber-brown font-sans antialiased">
 <a
 href="#main-content"
 class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-limber-tericotta focus:text-limber-cream focus:px-4 focus:py-2 focus:rounded-md"
 >
 Skip to content
 </a>
 <Header />
 <main id="main-content">
 <slot />
 </main>
 <Footer />
 </body>
</html>
