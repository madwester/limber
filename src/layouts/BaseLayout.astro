---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
 title: string;
 description: string;
 image?: string;
 schema?: object | object[];
 noindex?: boolean;
 hideBanner?: boolean;
}

const {
 title,
 description,
 image = '/images/Limer_social_image.png',
 schema,
 noindex = false,
 hideBanner = false,
} = Astro.props;

const siteUrl = 'https://limberco.com.au';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const ogImage = image.startsWith('http') ? image : `${siteUrl}${image}`;
const pageTitle =
 title === 'Home'
 ? 'Limber | Movement Studio'
 : `${title} | Limber`;

const localBusinessSchema = {
 '@context': 'https://schema.org',
 '@type': 'HealthAndBeautyBusiness',
 '@id': `${siteUrl}/#business`,
 name: 'Limber',
 alternateName: 'Limber Co',
 url: siteUrl,
 logo: `${siteUrl}/images/LIMBERCo-logo.webp`,
 image: ogImage,
 email: 'hello@limberco.com.au',
 address: {
  '@type': 'PostalAddress',
  streetAddress: 'Shop 17/282-298 Lawrence Hargrave Drive',
  addressLocality: 'Thirroul',
  addressRegion: 'NSW',
  postalCode: '2515',
  addressCountry: 'AU',
 },
 geo: {
  '@type': 'GeoCoordinates',
  latitude: -34.3167,
  longitude: 150.9167,
 },
 priceRange: '$$',
 currenciesAccepted: 'AUD',
 paymentAccepted: 'Credit Card, Direct Debit',
 sameAs: [
  'https://www.instagram.com/limbercostudio',
  'https://www.facebook.com/limbercostudio',
 ],
};
---

<!doctype html>
<html lang="en-AU">
 <head>
 <meta charset="UTF-8" />
 <meta name="viewport" content="width=device-width, initial-scale=1.0" />
 <meta name="theme-color" content="#1a3a2a" />

 <!-- Favicon -->
 <link rel="icon" type="image/png" href="/images/favicon-illustration.png" />
 <link rel="apple-touch-icon" href="/images/favicon-illustration.png" />

 <!-- Canonical + robots -->
 <link rel="canonical" href={canonicalURL} />
 <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />

 <!-- Primary meta -->
 <title>{pageTitle}</title>
 <meta name="description" content={description} />
 <meta name="author" content="Limber" />

 <!-- Open Graph -->
 <meta property="og:type" content="website" />
 <meta property="og:url" content={canonicalURL} />
 <meta property="og:title" content={pageTitle} />
 <meta property="og:description" content={description} />
 <meta property="og:image" content={ogImage} />
 <meta property="og:image:width" content="1200" />
 <meta property="og:image:height" content="630" />
 <meta property="og:image:alt" content={pageTitle} />
 <meta property="og:locale" content="en_AU" />
 <meta property="og:site_name" content="Limber" />

 <!-- Twitter / X -->
 <meta name="twitter:card" content="summary_large_image" />
 <meta name="twitter:site" content="@limbercostudio" />
 <meta name="twitter:title" content={pageTitle} />
 <meta name="twitter:description" content={description} />
 <meta name="twitter:image" content={ogImage} />
 <meta name="twitter:image:alt" content={pageTitle} />

 <!-- Structured data -->
 <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
 {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

 <!--
 Google Fonts: Cormorant Garamond + Lato
 Candu is self-hosted — see public/fonts/ and global.css
 -->
 <link rel="preconnect" href="https://fonts.googleapis.com" />
 <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
 <link
 href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Lato:wght@300;400;700&display=swap"
 rel="stylesheet"
 />
 </head>
 <!-- body bg is Cream 30% per brand guide; text is Limber Brown -->
 <body class="bg-limber-cream-bg text-limber-brown font-sans antialiased">
 <a
 href="#main-content"
 class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-limber-tericotta focus:text-limber-cream focus:px-4 focus:py-2 focus:rounded-md"
 >
 Skip to content
 </a>
 <Header showBanner={!hideBanner} />
 <main id="main-content">
 <slot />
 </main>
 <Footer />
 </body>
</html>
