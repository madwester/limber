---
import Logo from './Logo.astro';

interface Props {
 showBanner?: boolean;
 bannerBg?: string;
 bannerText?: string;
 bannerTextAccent?: string;
}
const { showBanner = false, bannerBg = 'bg-limber-bright hover:bg-limber-bright', bannerText = 'text-limber-cream', bannerTextAccent = 'text-limber-cream' } = Astro.props;

const navItems = [
 {
 label: 'About',
 href: '/about',
 image: '/images/Limber_April26_99.jpg',
 children: [
 { label: 'Our Vibe', href: '/about/our-vibe' },
 { label: 'Our Tribe', href: '/about/our-tribe' },
 { label: 'Our Community', href: '/about/our-community' },
 ],
 },
 {
 label: 'Classes',
 href: '/classes',
 image: '/images/dropdown_classes.jpg',
 children: [
 { label: 'Our Classes', href: '/classes/our-classes' },
 { label: 'Timetable', href: '/classes/timetable' },
 { label: 'Privates', href: '/classes/privates' },
 { label: 'Corporates', href: '/classes/corporates' },
 ],
 },
 {
 label: 'Pricing',
 href: '/pricing',
 image: '/images/dropdown_pricing.jpg',
 children: [
 { label: 'Trial', href: '/pricing/trial' },
 { label: 'Memberships', href: '/pricing/memberships' },
 { label: 'Packs & Gift Cards', href: '/pricing/packs-and-gift-cards' },
 ],
 },
 { label: 'Journal', href: '/journal' },
 { label: 'Love Club', href: '/reviews' },
 { label: 'Contact', href: '/contact' },
];

const currentPath = Astro.url.pathname;
---

<div class="fixed top-0 left-0 right-0 z-[300]">
 {showBanner && (
  <a
   href="/pricing/packs-and-gift-cards"
   class:list={[bannerBg, 'block border-b-2 border-limber-brown px-4 py-2.5 text-center transition-colors']}
  >
   <span class:list={['font-headline text-sm', bannerTextAccent]}>Get your father the gift of movement</span>
   <span class:list={['font-sans text-sm ml-2', bannerTextAccent]}>→</span>
  </a>
 )}
<header class="bg-limber-green border-b-2 border-limber-vibe">
 <div class="px-4 sm:px-6 lg:px-8">
 <div class="flex items-center h-16 lg:h-20 py-3 lg:py-4">

 <!-- Logo — left aligned -->
 <a href="/" class="flex-shrink-0" aria-label="Limber — home">
    <Logo class="h-9 lg:h-12 w-auto" color="var(--color-limber-cream)" />
 </a>

 <!-- Desktop nav — right-aligned -->
 <div class="hidden lg:flex items-center gap-7 ml-auto" data-nav-bar>
 <nav class="flex items-center gap-7" aria-label="Main navigation">
 {
 navItems.map((item) =>
 item.children ? (
 <div class="relative" data-dropdown-group>
 <button
 type="button"
 data-dropdown-trigger
 class:list={[
 'font-display not-italic text-xl capitalize transition-colors hover:text-limber-vibe cursor-pointer',
 currentPath.startsWith(item.href)
 ? 'text-limber-vibe'
 : 'text-limber-cream',
 ]}
 >
 {item.label}
 </button>
 <!-- Full-width panel: links on the left at page padding, image on the right -->
 <div
 data-dropdown-panel
 class:list={["hidden fixed left-0 right-0 -mt-[2px] bg-limber-green border-b-2 border-limber-brown z-[51]", showBanner ? "top-[106px] lg:top-[122px]" : "top-16 lg:top-20"]}
 style="height: 200px;"
 >
 <div class="h-full flex items-center justify-between px-4 sm:px-6 lg:px-8 py-5">
 <div class="flex flex-col gap-1">
 {item.children.map((child) => (
 <a
 href={child.href}
 class:list={[
 'block px-3 py-2 font-display not-italic text-xl capitalize transition-colors hover:text-limber-vibe',
 currentPath === child.href
 ? 'text-limber-vibe'
 : 'text-limber-cream',
 ]}
 >
 {child.label}
 </a>
 ))}
 </div>
 <img
 src={item.image}
 alt={item.label}
 class="h-40 w-64 object-cover rounded-2xl border-2 border-limber-vibe flex-shrink-0"
 />
 </div>
 </div>
 </div>
 ) : (
 <a
 href={item.href}
 data-plain-link
 class:list={[
 'font-display not-italic text-xl capitalize transition-colors hover:text-limber-vibe',
 currentPath.startsWith(item.href)
 ? 'text-limber-vibe'
 : 'text-limber-cream',
 ]}
 >
 {item.label}
 </a>
 )
 )
 }
 </nav>

 <a
 href="/book-now"
 data-plain-link
 class="font-headline text-sm text-limber-green bg-limber-vibe border-2 border-limber-vibe rounded-full px-5 py-2 hover:bg-limber-bright hover:border-limber-bright transition-colors"
 >
 <span class="relative top-[2px]">Book Now</span>
 </a>
 </div>

 <!-- Mobile toggle -->
 <div class="flex items-center ml-auto lg:hidden">
 <button
 id="mobile-menu-btn"
 class="p-2 text-limber-cream hover:text-limber-vibe transition-colors flex flex-col justify-center gap-[5px] w-8 h-8"
 aria-label="Open menu"
 aria-expanded="false"
 aria-controls="mobile-menu"
 >
  <span class="burger-bar block h-[2px] w-6 bg-current transition-all duration-300 origin-center"></span>
  <span class="burger-bar block h-[2px] w-6 bg-current transition-all duration-300 origin-center"></span>
  <span class="burger-bar block h-[2px] w-6 bg-current transition-all duration-300 origin-center"></span>
 </button>
 </div>

 </div>
 </div>

 <!-- Mobile menu — slides in below header -->
 <div id="mobile-menu" class:list={["hidden lg:hidden fixed left-0 right-0 bottom-0 z-[200] bg-limber-green overflow-y-auto border-t-2 border-limber-vibe", showBanner ? "top-[108px]" : "top-[66px]"]}>
  <div class="flex flex-col px-8 py-8">
   <!-- Links -->
   <nav class="flex flex-col gap-1 flex-1 mobile-nav">
    {navItems.map((item) => (
     <div>
      {item.children ? (
       <p class="font-display text-lg text-limber-cream/40 py-1 mt-3">{item.label}</p>
      ) : (
       <a href={item.href} class="font-display text-2xl text-limber-cream hover:text-limber-vibe transition-colors py-2 block">{item.label}</a>
      )}
      {item.children && (
       <div class="flex flex-col gap-0.5">
        {item.children.map((child) => (
         <a href={child.href} class="font-display text-2xl text-limber-cream/80 hover:text-limber-vibe transition-colors py-1.5 block">{child.label}</a>
        ))}
       </div>
      )}
     </div>
    ))}
   </nav>

   <!-- Book now -->
   <div class="pt-8 pb-4">
    <a href="/book-now" class="block w-full text-center px-5 py-4 font-headline text-sm text-limber-green bg-limber-vibe hover:bg-limber-bright border-2 border-limber-vibe rounded-full transition-colors">
     <span class="relative top-[2px]">Book Now</span>
    </a>
   </div>
  </div>
 </div>
</header>
</div>

<!-- Fixed header offset — extra height when banner is showing -->
<div class:list={[showBanner ? 'h-[106px] lg:h-[122px]' : 'h-16 lg:h-20']} aria-hidden="true"></div>

<script>
 // ── Mobile menu ──
 const mobileBtn = document.getElementById('mobile-menu-btn');
 const mobileMenu = document.getElementById('mobile-menu');
 const mobileClose = document.getElementById('mobile-menu-close');

 const bars = mobileBtn?.querySelectorAll('.burger-bar') as NodeListOf<HTMLElement>;

 function openMenu() {
  mobileMenu?.classList.remove('hidden');
  // Lock scroll on all browsers including iOS Safari
  document.body.style.overflow = 'hidden';
  document.body.style.position = 'fixed';
  document.body.style.width = '100%';
  document.body.style.top = `-${window.scrollY}px`;
  mobileBtn?.setAttribute('aria-expanded', 'true');
  if (bars) {
   bars[0].style.transform = 'translateY(7px) rotate(45deg)';
   bars[1].style.opacity = '0';
   bars[2].style.transform = 'translateY(-7px) rotate(-45deg)';
  }
 }
 function closeMenu() {
  mobileBtn?.setAttribute('aria-expanded', 'false');
  if (bars) {
   bars[0].style.transform = '';
   bars[1].style.opacity = '';
   bars[2].style.transform = '';
  }
  // Restore scroll position
  const scrollY = document.body.style.top;
  document.body.style.overflow = '';
  document.body.style.position = '';
  document.body.style.width = '';
  document.body.style.top = '';
  window.scrollTo(0, -parseInt(scrollY || '0'));
  setTimeout(() => {
   mobileMenu?.classList.add('hidden');
  }, 300);
 }

 mobileBtn?.addEventListener('click', () => {
  mobileMenu?.classList.contains('hidden') ? openMenu() : closeMenu();
 });
 mobileClose?.addEventListener('click', closeMenu);

 // ── Desktop dropdowns ──
 // Uses a short timeout so the mouse can travel from the trigger down into the
 // panel without the panel vanishing during the gap.
 const navBar = document.querySelector('[data-nav-bar]');
 const groups = document.querySelectorAll('[data-dropdown-group]');
 let hideTimer: ReturnType<typeof setTimeout> | null = null;

 function scheduleHide() {
 hideTimer = setTimeout(hideAll, 120);
 }
 function cancelHide() {
 if (hideTimer) { clearTimeout(hideTimer); hideTimer = null; }
 }
 function hideAll() {
 groups.forEach((g) => {
 g.querySelector('[data-dropdown-panel]')?.classList.add('hidden');
 });
 }

 groups.forEach((group) => {
 const trigger = group.querySelector('[data-dropdown-trigger]');
 const panel = group.querySelector('[data-dropdown-panel]');

 trigger?.addEventListener('mouseenter', () => {
 cancelHide();
 hideAll();
 panel?.classList.remove('hidden');
 });

 panel?.addEventListener('mouseenter', () => cancelHide());
 panel?.addEventListener('mouseleave', () => scheduleHide());
 });

 // Plain links close immediately
 document.querySelectorAll('[data-plain-link]').forEach((link) => {
 link.addEventListener('mouseenter', () => { cancelHide(); hideAll(); });
 });

 // Leaving the whole nav bar schedules a hide (panel mouseleave handles the rest)
 navBar?.addEventListener('mouseleave', () => scheduleHide());
 document.addEventListener('click', (e) => {
 if (!navBar?.contains(e.target as Node)) hideAll();
 });
</script>
