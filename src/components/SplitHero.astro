---
interface Props {
  image: string;
  imageAlt: string;
  bgColor?: string;
}

const { image, imageAlt, bgColor = 'bg-limber-green' } = Astro.props;

const borderColor = bgColor === 'bg-limber-green' ? 'border-limber-vibe' : 'border-limber-green';
---

<section class:list={['split-hero border-b-2 lg:flex', bgColor, borderColor]}>

  <!-- Left: content via slot -->
  <div class:list={['lg:w-1/2 flex flex-col justify-start px-8 lg:px-14 py-16 lg:py-20', bgColor]}>
    <slot />
  </div>

  <!-- Right: image -->
  <div class="lg:w-1/2 flex-shrink-0">
    <img
      src={image}
      alt={imageAlt}
      class:list={['w-full h-64 lg:h-full object-cover object-center border-t-2 lg:border-t-0 lg:border-l-2', borderColor]}
    />
  </div>

</section>

<style>
  .split-hero {
    height: calc(100vh - 4rem);
  }
  @media (min-width: 1024px) {
    .split-hero {
      height: calc(100vh - 5rem);
    }
  }
</style>
