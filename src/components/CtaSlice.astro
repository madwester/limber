---
interface Button {
  label: string;
  href: string;
  variant?: 'primary' | 'outline'; // primary = vibe yellow, outline = cream border
}

interface Props {
  headingLine1: string;
  headingLine2: string;
  body: string;
  buttons: Button[];
  image: string;
  imageAlt?: string;
}

const {
  headingLine1,
  headingLine2,
  body,
  buttons,
  image,
  imageAlt = '',
} = Astro.props;
---

<section class="bg-limber-cream py-12 lg:py-16 border-t-2 border-neutral-900">
  <div class="px-4 sm:px-6 lg:px-8">
    <div class="bg-limber-green rounded-2xl border-2 border-neutral-900 overflow-hidden lg:flex items-stretch">

      <!-- Left: content -->
      <div class="flex flex-col justify-center px-8 lg:px-12 py-12 lg:py-14 flex-1">
        <h2 class="mb-3">
          <span class="font-headline uppercase text-3xl md:text-4xl lg:text-5xl text-limber-cream block leading-none mb-1">{headingLine1}</span>
          <em class="font-display uppercase not-italic italic font-medium text-4xl md:text-5xl lg:text-6xl text-limber-vibe block leading-none">{headingLine2}</em>
        </h2>
        <p class="font-sans text-limber-cream/70 leading-relaxed mb-8 max-w-sm">{body}</p>
        <div class="flex flex-wrap gap-3">
          {buttons.map((btn) => (
            <a
              href={btn.href}
              class:list={[
                'inline-flex items-center px-6 py-3 font-headline text-sm border-2 border-neutral-900 rounded-full transition-colors',
                btn.variant === 'outline'
                  ? 'text-limber-cream hover:border-limber-cream'
                  : 'text-limber-green bg-limber-vibe hover:bg-limber-bright',
              ]}
            >
              {btn.label}
            </a>
          ))}
        </div>
      </div>

      <!-- Right: image -->
      <div class="lg:w-2/5 flex-shrink-0 flex items-center px-8 lg:px-12 py-12 lg:py-14 lg:pl-0">
        <img
          src={image}
          alt={imageAlt}
          class="w-full h-64 lg:h-80 object-cover rounded-xl border-2 border-neutral-900"
        />
      </div>

    </div>
  </div>
</section>
