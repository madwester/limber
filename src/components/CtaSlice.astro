---
interface Button {
  label: string;
  href: string;
  variant?: 'primary' | 'outline'; // primary = vibe yellow, outline = cream border
}

interface Props {
  headingLine1: string;
  headingLine2: string;
  headingLine3?: string;
  body: string;
  buttons: Button[];
  image: string;
  imageAlt?: string;
  sectionBg?: string;
  accentColor?: string;
  primaryBtn?: string;
  showBorder?: boolean;
  cardBg?: string;
  imagePosition?: string;
  centerContent?: boolean;
}

const {
  headingLine1,
  headingLine2,
  headingLine3,
  body,
  buttons,
  image,
  imageAlt = '',
  sectionBg = 'bg-limber-vibe',
  accentColor = 'text-limber-bright',
  primaryBtn = 'text-limber-brown bg-limber-bright hover:bg-limber-vibe border-limber-bright',
  showBorder = true,
  cardBg = 'bg-limber-brown border-limber-brown',
  imagePosition = 'object-center',
  centerContent = false,
} = Astro.props;
---

<section class:list={[sectionBg, 'py-12 lg:py-16', showBorder && 'border-t-2 border-limber-green']}>
  <div class="px-4 sm:px-6 lg:px-8">
    <div class:list={['cta-card rounded-2xl border-2 overflow-hidden lg:flex items-stretch', cardBg]}>

      <!-- Image first on mobile -->
      <div class="lg:hidden px-6 pt-8 pb-0">
        <img
          src={image}
          alt={imageAlt}
          class:list={['w-full h-56 object-cover rounded-xl border-2 border-limber-vibe', imagePosition]}
        />
      </div>

      <!-- Content -->
      <div class:list={['flex flex-col justify-center px-6 lg:px-8 py-8 lg:py-10 flex-1', centerContent ? 'items-center text-center' : 'items-start text-left']}>
        {Astro.slots.has('heading') ? (
          <div class:list={['mb-3 cta-heading w-full', centerContent ? 'text-center' : 'text-left']}>
            <slot name="heading" />
          </div>
        ) : (
          <h2 class:list={['mb-3 cta-heading w-full', centerContent ? 'text-center' : 'text-left']}>
            <span class:list={['font-headline uppercase text-3xl md:text-4xl lg:text-5xl block leading-none -mb-1', accentColor]}>{headingLine1}</span>
            <span class="font-display italic font-medium text-4xl md:text-5xl lg:text-6xl text-limber-cream block leading-none" class:list={[headingLine3 ? 'mb-1' : '']}>{headingLine2}</span>
            {headingLine3 && <span class="font-display italic font-medium text-4xl md:text-5xl lg:text-6xl text-limber-cream block leading-none">{headingLine3}</span>}
          </h2>
        )}
        <p class:list={['font-sans text-limber-cream/70 leading-relaxed mb-8 max-w-sm w-full', centerContent ? 'text-center' : 'text-left']}>{body}</p>
        <div class:list={['flex flex-wrap gap-3 w-full', centerContent ? 'justify-center' : 'justify-start']}>
          {buttons.map((btn) => (
            <a
              href={btn.href}
              class:list={[
                'inline-flex items-center px-6 py-3 font-headline text-sm border-2 rounded-full transition-colors',
                btn.variant === 'outline'
                  ? 'text-limber-cream border-limber-cream hover:border-limber-tericotta hover:text-limber-tericotta'
                  : primaryBtn,
              ]}
            >
              <span class="relative top-[2px]">{btn.label}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Image on desktop (right side) -->
      <div class="hidden lg:flex lg:w-2/5 flex-shrink-0 items-center px-8 py-10 lg:pl-0">
        <img
          src={image}
          alt={imageAlt}
          class:list={['w-full h-64 lg:h-80 object-cover rounded-xl border-2 border-limber-vibe', imagePosition]}
        />
      </div>

    </div>
  </div>
</section>
