---
interface Button {
  label: string;
  href: string;
  variant?: 'primary' | 'outline';
  target?: string;
}

interface Props {
  image: string;
  imageAlt: string;
  imagePosition?: string;
  body: string;
  bodyItalic?: boolean;
  buttons: Button[];
  bgColor?: string;
  onDark?: boolean;
  sticker?: string;
  imageStyle?: string;
  imageSticker?: string;
  imageStickerColor?: string;
}

const {
  image,
  imageAlt,
  imagePosition = 'object-top',
  body,
  bodyItalic = false,
  buttons,
  bgColor = 'bg-limber-green',
  onDark = true,
  sticker,
  imageStyle,
  imageSticker,
  imageStickerColor = 'var(--color-limber-bright)',
} = Astro.props;

const bodyClass = bodyItalic
  ? `font-display italic text-xl leading-snug ${onDark ? 'text-limber-cream/80' : 'text-limber-brown/80'}`
  : `font-sans leading-relaxed ${onDark ? 'text-limber-cream/80' : 'text-limber-brown/80'}`;
---

<section class:list={[bgColor, 'border-b-2 px-4 sm:px-6 lg:px-8 pt-6 lg:pt-8 pb-16 lg:pb-24 mt-[10px]', bgColor === 'bg-limber-green' ? 'border-limber-vibe' : 'border-limber-green']}>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">

    <!-- Left: heading + body + buttons -->
    <div class="flex flex-col items-start order-2 lg:order-1">
      <div class="mb-4">
        <slot />
      </div>
      <p class:list={['mb-8 max-w-md', bodyClass]}>
        {body}
      </p>
      <div class="flex items-center gap-6">
        <div class="flex flex-wrap justify-start gap-3">
          {buttons.map((btn) => (
            <a
              class:list={[
                'inline-flex items-center px-8 py-4 font-headline text-sm border-2 rounded-full transition-colors flex-shrink-0',
                btn.variant === 'outline'
                  ? onDark
                    ? 'text-limber-cream border-limber-cream hover:bg-limber-brown hover:border-limber-vibe'
                    : 'text-limber-brown border-limber-green hover:bg-limber-green hover:text-limber-cream'
                  : 'text-limber-green bg-limber-vibe hover:bg-limber-bright border-limber-vibe',
              ]}
              href={btn.href}
              target={btn.target}
              rel={btn.target === '_blank' ? 'noopener noreferrer' : undefined}
            >
              <span class="relative top-[2px]">{btn.label}</span>
            </a>
          ))}
        </div>
        {sticker && (
          <img
            src={sticker}
            alt=""
            aria-hidden="true"
            class="lg:hidden w-20 h-20 rotate-[-15deg] pointer-events-none flex-shrink-0"
            style="filter: brightness(0) saturate(100%) invert(66%) sepia(62%) saturate(625%) hue-rotate(338deg) brightness(1.05);"
          />
        )}
      </div>
    </div>

    <!-- Right: image -->
    <div class="relative order-1 lg:order-2 lg:self-start">
      {sticker && (
        <img
          src={sticker}
          alt=""
          aria-hidden="true"
          class="hidden lg:block absolute -top-6 -left-6 z-10 w-24 h-24 rotate-[-15deg] pointer-events-none"
          style="filter: brightness(0) saturate(100%) invert(66%) sepia(62%) saturate(625%) hue-rotate(338deg) brightness(1.05);"
        />
      )}
      <div class="overflow-hidden rounded-2xl">
        <img
          alt={imageAlt}
          class:list={['w-full h-72 lg:h-[420px] object-cover rounded-2xl border-2', imagePosition, bgColor === 'bg-limber-green' ? 'border-limber-vibe' : 'border-limber-green']}
          style={imageStyle}
          src={image}
        />
      </div>
      {imageSticker && (
        <div
          aria-hidden="true"
          class="absolute bottom-4 right-4 lg:bottom-4 lg:right-auto lg:left-4 w-20 h-20 rotate-[8deg] pointer-events-none z-10"
          style={`background-color: ${imageStickerColor}; -webkit-mask-image: url('${imageSticker}'); mask-image: url('${imageSticker}'); -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat; -webkit-mask-size: contain; mask-size: contain; -webkit-mask-position: center; mask-position: center;`}
        ></div>
      )}
    </div>

  </div>
</section>
