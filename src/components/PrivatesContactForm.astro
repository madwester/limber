---
// Setup: formspree.io → New Form → set notification email to privates@limberco.com.au
// Then replace YOUR_FORM_ID below with the generated ID (e.g. "xpwzgkqj").
const FORMSPREE_ID = 'YOUR_FORM_ID';
---

<form
 id="privates-form"
 action={`https://formspree.io/f/${FORMSPREE_ID}`}
 method="POST"
 class="space-y-6"
 novalidate
>
 <input type="text" name="_gotcha" class="hidden" aria-hidden="true" tabindex="-1" />
 <input type="hidden" name="_subject" value="Private Session Enquiry — Limber" />

 <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
 <div>
 <label for="name" class="block font-headline text-xs text-limber-green mb-2">
 Full name <span class="text-limber-tericotta" aria-hidden="true">*</span>
 </label>
 <input
 type="text"
 id="name"
 name="name"
 required
 autocomplete="name"
 class="w-full px-4 py-3 rounded-xl border-2 border-limber-green/30 bg-limber-cream text-limber-brown placeholder:text-limber-brown/40 focus:outline-none focus:border-limber-tericotta transition font-sans text-sm"
 placeholder="Jane Smith"
 />
 </div>

 <div>
 <label for="email" class="block font-headline text-xs text-limber-green mb-2">
 Email address <span class="text-limber-tericotta" aria-hidden="true">*</span>
 </label>
 <input
 type="email"
 id="email"
 name="email"
 required
 autocomplete="email"
 class="w-full px-4 py-3 rounded-xl border-2 border-limber-green/30 bg-limber-cream text-limber-brown placeholder:text-limber-brown/40 focus:outline-none focus:border-limber-tericotta transition font-sans text-sm"
 placeholder="jane@example.com"
 />
 </div>
 </div>

 <div>
 <label for="phone" class="block font-headline text-xs text-limber-green mb-2">
 Phone number
 </label>
 <input
 type="tel"
 id="phone"
 name="phone"
 autocomplete="tel"
 class="w-full px-4 py-3 rounded-xl border-2 border-limber-green/30 bg-limber-cream text-limber-brown placeholder:text-limber-brown/40 focus:outline-none focus:border-limber-tericotta transition font-sans text-sm"
 placeholder="04xx xxx xxx"
 />
 </div>

 <div>
 <label for="availability" class="block font-headline text-xs text-limber-green mb-2">
 Preferred days &amp; times
 </label>
 <input
 type="text"
 id="availability"
 name="availability"
 class="w-full px-4 py-3 rounded-xl border-2 border-limber-green/30 bg-limber-cream text-limber-brown placeholder:text-limber-brown/40 focus:outline-none focus:border-limber-tericotta transition font-sans text-sm"
 placeholder="e.g. Weekday mornings, Saturday afternoons"
 />
 </div>

 <div>
 <label for="goals" class="block font-headline text-xs text-limber-green mb-2">
 What are you looking for? <span class="text-limber-tericotta" aria-hidden="true">*</span>
 </label>
 <textarea
 id="goals"
 name="goals"
 required
 rows="4"
 class="w-full px-4 py-3 rounded-xl border-2 border-limber-green/30 bg-limber-cream text-limber-brown placeholder:text-limber-brown/40 focus:outline-none focus:border-limber-tericotta transition resize-none font-sans text-sm"
 placeholder="Tell us about your goals, any injuries or areas of focus, and what you'd love to achieve with private sessions…"
 ></textarea>
 </div>

 <button
 type="submit"
 class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 font-headline text-sm text-limber-cream bg-limber-tericotta hover:bg-limber-brown border-2 border-limber-green rounded-full transition-colors disabled:opacity-60"
 >
 Send Enquiry
 <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
 </svg>
 </button>
</form>

<div id="form-success" class="hidden p-8 rounded-2xl bg-limber-green text-center">
 <svg class="w-10 h-10 text-limber-vibe mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
 </svg>
 <h3 class="font-headline text-xl text-limber-cream mb-1">Enquiry sent!</h3>
 <p class="font-sans text-sm text-limber-cream/80">We'll be in touch within 1–2 business days.</p>
</div>

<script>
 const form = document.getElementById('privates-form') as HTMLFormElement | null;
 const success = document.getElementById('form-success');

 form?.addEventListener('submit', async (e) => {
 e.preventDefault();
 const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
 btn.disabled = true;

 const res = await fetch(form.action, {
 method: 'POST',
 body: new FormData(form),
 headers: { Accept: 'application/json' },
 });

 if (res.ok) {
 form.classList.add('hidden');
 success?.classList.remove('hidden');
 } else {
 btn.disabled = false;
 alert('Something went wrong. Please try again or email privates@limberco.com.au directly.');
 }
 });
</script>
