---
const year = new Date().getFullYear();
---

<footer class="bg-limber-green text-limber-cream mt-0 border-t-2 border-neutral-900">
 <div class="px-4 sm:px-6 lg:px-8 py-12 lg:py-16">

  <!-- Top: brand + nav -->
  <div class="grid grid-cols-1 lg:grid-cols-4 gap-10 lg:gap-10">

   <!-- Brand -->
   <div class="flex flex-col items-center text-center lg:items-start lg:text-left lg:col-span-1">
    <a href="/" class="inline-block mb-4" aria-label="Limber — home">
     <img src="/images/LIMBERCo-logo.webp" alt="Limber" class="h-14 lg:h-16 w-auto brightness-0 invert" />
    </a>
    <p class="text-sm text-limber-cream/70 leading-relaxed font-sans max-w-xs">
     Movement studio dedicated to helping you feel strong, mobile, and at home in your body.
    </p>
    <div class="flex gap-4 mt-6">
     <a href="#" aria-label="Limber on Instagram" class="text-limber-cream/50 hover:text-limber-vibe transition-colors">
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
       <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
      </svg>
     </a>
     <a href="#" aria-label="Limber on Facebook" class="text-limber-cream/50 hover:text-limber-vibe transition-colors">
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
       <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
      </svg>
     </a>
    </div>
   </div>

   <!-- Nav columns: 2x2 on mobile, side by side on desktop -->
   <div class="grid grid-cols-2 sm:grid-cols-3 lg:col-span-3 lg:grid-cols-3 gap-8">

    <!-- Explore -->
    <div>
     <h3 class="font-headline text-xs text-limber-vibe mb-4">Explore</h3>
     <ul class="space-y-3 text-sm font-sans">
      <li><a href="/about/our-vibe" class="text-limber-cream/70 hover:text-limber-cream transition-colors">Our Vibe</a></li>
      <li><a href="/about/our-tribe" class="text-limber-cream/70 hover:text-limber-cream transition-colors">Our Tribe</a></li>
      <li><a href="/classes/our-classes" class="text-limber-cream/70 hover:text-limber-cream transition-colors">Our Classes</a></li>
      <li><a href="/classes/timetable" class="text-limber-cream/70 hover:text-limber-cream transition-colors">Timetable</a></li>
      <li><a href="/journal" class="text-limber-cream/70 hover:text-limber-cream transition-colors">Journal</a></li>
      <li><a href="/reviews" class="text-limber-cream/70 hover:text-limber-cream transition-colors">Love Wall</a></li>
     </ul>
    </div>

    <!-- Get Moving -->
    <div>
     <h3 class="font-headline text-xs text-limber-vibe mb-4">Get Moving</h3>
     <ul class="space-y-3 text-sm font-sans">
      <li><a href="/pricing/trial" class="text-limber-cream/70 hover:text-limber-cream transition-colors">Intro Trial</a></li>
      <li><a href="/pricing/memberships" class="text-limber-cream/70 hover:text-limber-cream transition-colors">Memberships</a></li>
      <li><a href="/pricing/packs-and-gift-cards" class="text-limber-cream/70 hover:text-limber-cream transition-colors">Packs & Gift Cards</a></li>
      <li><a href="/classes/privates" class="text-limber-cream/70 hover:text-limber-cream transition-colors">Privates</a></li>
      <li><a href="/classes/corporates" class="text-limber-cream/70 hover:text-limber-cream transition-colors">Corporates</a></li>
      <li><a href="/book-now" class="text-limber-cream/70 hover:text-limber-cream transition-colors">Book Now</a></li>
     </ul>
    </div>

    <!-- Get in Touch — spans full width on mobile so address has room -->
    <div class="col-span-2 sm:col-span-1">
     <h3 class="font-headline text-xs text-limber-vibe mb-4">Get in Touch</h3>
     <ul class="space-y-3 text-sm font-sans">
      <li>
       <a href="mailto:hello@limberco.com.au" class="text-limber-cream/70 hover:text-limber-cream transition-colors">
        hello@limberco.com.au
       </a>
      </li>
      <li class="font-headline text-xs text-limber-cream/70 leading-relaxed uppercase">
       Shop 17/282-298 Lawrence Hargrave Drive, Thirroul
      </li>
      <li class="text-limber-cream/50 text-xs italic">
       (next to coles. parking is a vibe.)
      </li>
     </ul>
     <div class="mt-6">
      <a
       href="/contact"
       class="inline-block font-headline text-xs text-limber-green bg-limber-vibe hover:bg-limber-bright border-2 border-neutral-900 px-5 py-2 rounded-full transition-colors"
      >
       Contact Us
      </a>
     </div>
    </div>

   </div>
  </div>

  <!-- Bottom: acknowledgement + legal -->
  <div class="mt-12 pt-8 border-t border-limber-cream/20 space-y-4">
   <p class="font-sans text-sm text-limber-cream/70 leading-relaxed max-w-2xl">
    we acknowledge the dharawal people as the traditional custodians of this land and pay respect to elders past, present and emerging.
   </p>
   <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
    <p class="font-sans text-xs text-limber-cream/40">&copy; {year} Limber. All rights reserved.</p>
    <div class="flex flex-wrap gap-x-6 gap-y-2">
     <a href="/terms-and-conditions" class="font-sans text-xs text-limber-cream/40 hover:text-limber-cream/70 transition-colors">Terms &amp; Conditions</a>
     <a href="/privacy" class="font-sans text-xs text-limber-cream/40 hover:text-limber-cream/70 transition-colors">Privacy Policy</a>
     <a href="/faqs" class="font-sans text-xs text-limber-cream/40 hover:text-limber-cream/70 transition-colors">FAQs</a>
    </div>
   </div>
  </div>

 </div>
</footer>
