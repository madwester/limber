---
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingHero from '../components/PricingHero.astro';
---

<BaseLayout
  title="Book Now"
  description="Book a Limber class online — pilates, yoga, barre and more. View the full timetable and reserve your spot instantly."
>

  <!-- ── HERO ── -->
  <PricingHero
    body="Find a session that works for you and reserve your spot in seconds."
    buttons={[
      { label: 'Book a class', href: '#schedule' },
      { label: 'New? Start for $99', href: '/pricing/trial', variant: 'outline' },
    ]}
    image="/images/Signature.jpg"
    imageAlt="Limber class"
    imagePosition="object-center"
  >
    <h1 class="mb-0">
      <span class="font-headline uppercase text-5xl md:text-6xl lg:text-7xl text-limber-vibe block leading-none -mb-1">book a</span>
      <span class="font-display italic font-medium text-5xl md:text-6xl lg:text-7xl text-limber-cream block leading-none">class</span>
    </h1>
  </PricingHero>

  <!-- ── SCHEDULE WIDGET ── -->
  <section class="bg-limber-vibe py-12 lg:py-16 border-b-2 border-limber-green">
    <div class="px-4 sm:px-6 lg:px-8">

      <div id="ribbon-schedule"></div>
      <script
        async
        type="module"
        host_id="46474"
        teacher_ids="[]"
        location_ids="[]"
        tag_ids="[]"
        default_filter="show-all"
        locale="en"
        src="https://momence.com/plugin/host-schedule/host-schedule.js"
      ></script>

    </div>
  </section>

</BaseLayout>

<style>
  /* ── Momence CSS variables ── */
  :root {
    --momenceColorBackground: #F7F4EE;  /* limber-cream-bg */
    --momenceColorPrimary: 102, 99, 51; /* limber-green */
    --momenceColorBlack: 11, 2, 4;      /* neutral-900 */
  }

  /* ── Font + base overrides ── */
  /* The widget injects directly into the DOM so these cascade in */
  #ribbon-schedule,
  #ribbon-schedule * {
    font-family: var(--font-sans, ui-sans-serif, system-ui, sans-serif) !important;
    letter-spacing: 0 !important;
  }

  /* Buttons inside the widget */
  #ribbon-schedule button,
  #ribbon-schedule a[role="button"],
  #ribbon-schedule [class*="button"],
  #ribbon-schedule [class*="Button"] {
    border-radius: 999px !important;
    font-family: var(--font-headline, ui-sans-serif, system-ui, sans-serif) !important;
  }

  /* Card / container rounding */
  #ribbon-schedule [class*="card"],
  #ribbon-schedule [class*="Card"],
  #ribbon-schedule [class*="container"],
  #ribbon-schedule [class*="Container"] {
    border-radius: 16px !important;
  }
</style>
