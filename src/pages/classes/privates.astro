---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaSlice from '../../components/CtaSlice.astro';
import PricingHero from '../../components/PricingHero.astro';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Private Sessions — Limber',
  description: 'One-on-one and semi-private Pilates sessions tailored to your individual goals at Limber.',
  provider: { '@type': 'LocalBusiness', name: 'Limber', url: 'https://limberco.com.au' },
};
---

<BaseLayout
  title="Privates + Semi-Privates"
  description="Private and semi-private Pilates sessions at Limber. Expert attention, your pace, your goals — whether you're recovering from injury, navigating pregnancy, or just want more personalised movement."
  schema={serviceSchema}
>

  <!-- ── HERO ── -->
  <PricingHero
    body="Are you recovering from injury, navigating pregnancy, have specific goals? Then our private and semi-privates sessions will be perfect for you."
    buttons={[
      { label: 'Book a private', href: 'mailto:hello@limberco.com.au' },
    ]}
    image="/images/privates-1.jpg"
    imageAlt="Limber private session"
    imagePosition="object-center"
  >
    <h1 class="mb-0">
      <span class="flex items-baseline gap-[0.2em] leading-none -mb-1">
        <span class="font-headline uppercase text-5xl md:text-6xl lg:text-7xl text-limber-vibe">privates</span>
        <span class="font-display not-uppercase italic font-medium text-5xl md:text-6xl lg:text-7xl text-limber-cream">&amp;</span>
        <span class="font-headline uppercase text-5xl md:text-6xl lg:text-7xl text-limber-vibe">semi-privates</span>
      </span>
    </h1>
  </PricingHero>

  <!-- ── ONE-ON-ONE ── -->
  <section class="bg-limber-green py-16 lg:py-24 border-b-2 border-limber-vibe">
    <div class="px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-2 lg:gap-16 items-start">

        <div>
          <h2 class="mb-6 stacked-heading">
            <span class="font-headline uppercase text-4xl md:text-5xl text-limber-vibe block leading-none -mb-1">one-on-one</span>
            <span class="font-display italic font-medium text-4xl md:text-5xl text-limber-cream block leading-none">Privates</span>
          </h2>
          <p class="font-sans text-limber-cream/80 leading-relaxed mb-4">
            Each new client wanting to join us for semi-privates will need to undergo 1 private session with us. This is where goals, bodily needs and a short dynamic assessment will be held so we can ensure you have a personalised plan moving into semi-privates.
          </p>
          <p class="font-sans text-limber-cream/80 leading-relaxed mb-6">
            The most personalised experience we offer. Just you and one of our highly trained teachers: 55 minutes designed entirely around what your body needs right now.
          </p>
          <p class="font-headline text-xs text-limber-vibe mb-3">Privates are great for</p>
          <ul class="space-y-3 mb-8">
            {[
              'post-injury recovery',
              'pre and postnatal care',
              'building foundations before joining group classes',
              'anyone who wants focused, individual attention',
            ].map((item) => (
              <li class="font-sans text-base text-limber-cream/80 flex justify-start gap-3">
                <span class="text-limber-vibe flex-shrink-0">—</span>
                {item}
              </li>
            ))}
          </ul>
          <p class="font-sans text-sm text-limber-cream/60 leading-relaxed italic">
            Our teachers are diploma-trained with a minimum of a comprehensive year-long program behind them, years of hands-on experience, and a genuine commitment to ongoing education. You're in excellent hands.
          </p>
        </div>

        <!-- Pricing card -->
        <div class="mt-10 lg:mt-0 self-start">
          <div class="p-8 lg:p-10 rounded-2xl bg-limber-cream border-2 border-limber-green">
            <p class="font-display italic text-lg text-limber-tericotta mb-2">Initial consult</p>
            <p class="font-headline text-5xl text-limber-green mb-1">$120</p>
            <p class="font-sans text-sm text-limber-brown/60 italic mb-6">55 minutes</p>
            <p class="font-sans text-sm text-limber-brown/80 leading-relaxed mb-8">
              Your first session is your introduction to limber. We'll get to know your body, your history and your goals, and work out the best path forward together. We will chat, move and set you up for success.
            </p>
            <div class="space-y-3">
              <a
                href="mailto:hello@limberco.com.au"
                class="flex items-center gap-2 font-headline text-sm text-limber-brown hover:text-limber-tericotta transition-colors"
              >
                → Book your first session: hello@limberco.com.au
              </a>
              <a
                href="tel:0475779651"
                class="flex items-center gap-2 font-headline text-sm text-limber-brown hover:text-limber-tericotta transition-colors"
              >
                → Or call us: 0475 779 651
              </a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ── SEMI-PRIVATES ── -->
  <section class="bg-limber-green py-16 lg:py-24 border-b-2 border-limber-vibe">
    <div class="px-4 sm:px-6 lg:px-8">

      <div class="lg:grid lg:grid-cols-2 lg:gap-16 items-start">

        <div>
          <h2 class="mb-6 stacked-heading">
            <span class="font-headline uppercase text-4xl md:text-5xl text-limber-vibe block leading-none">semi-privates</span>
          </h2>
          <p class="font-sans text-limber-cream/80 leading-relaxed mb-4">
            All the benefits of personalised attention, in a small, intimate group of up to four people.
          </p>
          <p class="font-sans text-limber-cream/80 leading-relaxed mb-4">
            Semi-privates are our most focused group experience. Small enough that your teacher genuinely knows what you need. Supportive enough that you're not doing it alone.
          </p>
          <p class="font-sans text-limber-cream/80 leading-relaxed">
            You will work individually on your own programme which will progress and adapt each season depending on your needs and goals.
          </p>
          <p class="font-display italic text-xl text-limber-vibe leading-snug mt-8">55 minutes · $120</p>
        </div>

        <div class="mt-10 lg:mt-0">
          <img
            src="/images/studio-2.png"
            alt="Limber semi-private session"
            class="w-full rounded-2xl border-2 border-limber-vibe"
          />
        </div>

      </div>

    </div>
  </section>

  <!-- ── CTA SLICE ── -->
  <CtaSlice
    headingLine1="ready to"
    headingLine2="Get started?"
    sectionBg="bg-limber-cream"
    showBorder={false}
    body="Get in touch and we'll match you with the right teacher and format for where you're at right now."
    buttons={[
      { label: 'Email us', href: 'mailto:hello@limberco.com.au', variant: 'primary' },
      { label: 'Call us: 0475 779 651', href: 'tel:0475779651', variant: 'outline' },
    ]}
    image="/images/privates-2.webp"
    imageAlt="Limber private session"
  />

</BaseLayout>
