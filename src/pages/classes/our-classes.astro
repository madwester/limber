---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FullBleedHero from '../../components/FullBleedHero.astro';

const classes = [
  {
    id: 'limber-signature',
    name: 'Limber Signature',
    tags: ['Mat Pilates', 'Flowing', 'Fiery', 'Full Body', 'Fun', 'Leaves You Feeling Brand New'],
    spotlight: 'Full body strength + core',
    energyGuide: 'Medium–high 🔥',
    soundsLike: 'https://open.spotify.com/playlist/6lC4ygC23BnCIMP8cff12q?si=1k7tivSoSUuneJAyHmmWAw',
    description: [
      'Our signature mat pilates class built around deep core connection and full body movement that flows seamlessly from one thing to the next. It pulls you into the present and sends you straight into flow state.',
      'It builds slowly, and intentionally, towards a full body peak that leaves you humbled, not destroyed. Think less "collapsed on the floor" and more "walking out with an after flow glow".',
    ],
    classNotes: 'All levels welcome · modifications available throughout',
    images: ['/images/classes/signature.jpg'],
  },
  {
    id: 'limbarre',
    name: 'Limbarre',
    nameSplit: ['Lim', 'Barre'],
    tags: ['Barre', 'Beat-Driven', 'Cardio', 'Genuinely The Most Fun Your Body Has Had All Week'],
    spotlight: 'Full body strength + cardio',
    energyGuide: 'High 🔥🔥',
    soundsLike: 'https://open.spotify.com/playlist/50gCAE4s6IcifiUbDQsDE2?si=I3TE6d05QtK0PGo9dMj3IQ',
    description: [
      "Beat-driven, cardio-infused, and fiery on the legs. So fun you'll forget they're burning. Think pliés, pulses, and pirouttes (joking).",
    ],
    classNotes: 'All levels welcome · pre-natal friendly · modifications available throughout',
    images: ['/images/classes/limbarre_1.jpg', '/images/classes/limbarre_2.jpg'],
  },
  {
    id: 'limber-strength',
    name: 'Limber Strength',
    tags: ['Pilates Meets Strength Training', 'Full Body'],
    spotlight: 'Full body strength + conditioning',
    energyGuide: 'High 🔥🔥',
    soundsLike: 'https://open.spotify.com/playlist/50gCAE4s6IcifiUbDQsDE2?si=I3TE6d05QtK0PGo9dMj3IQ',
    description: [
      'Pilates met strength training and honestly? Power couple of the century.',
      "Limber Strength takes everything you love about pilates: the intention, the precision, the mind-body connection, and adds dumbbells. You'll move through circuits and be encouraged to work your whole body close to its max rep.",
      "Weights are always your choice, but we will absolutely encourage you to pick up the heavier ones when you're ready.",
    ],
    classNotes: 'All levels welcome · pre-natal friendly · modifications available throughout',
    images: ['/images/classes/strength.jpg'],
  },
  {
    id: 'limber-chair',
    name: 'Limber Chair',
    tags: ['Pilates Apparatus', 'Full Body', 'Precise', 'Playful'],
    spotlight: 'Balance, stability, strength + mobility',
    energyGuide: 'Medium 🔥',
    soundsLike: 'https://open.spotify.com/playlist/50gCAE4s6IcifiUbDQsDE2?si=I3TE6d05QtK0PGo9dMj3IQ',
    description: [
      "A small but mighty machine. Not quite a reformer, not quite anything else, just its own brilliant thing. Springs that support, assist and offer up some seriously juicy and fiery movement.",
      "Sounds complicated. It isn't. Your teacher will be there to assist every step of the way.",
    ],
    classNotes: 'All levels welcome · pre-natal friendly · grip socks required',
    images: ['/images/classes/chair_1.jpg', '/images/classes/chair_2.jpg'],
  },
  {
    id: 'limber-up',
    name: 'Limber Up',
    tags: ['Mobility', 'Stretch', 'Release', 'The Permission Slip Your Body Has Been Waiting For'],
    spotlight: 'Mobility, flexibility + recovery',
    energyGuide: 'Low',
    soundsLike: 'https://open.spotify.com/playlist/50gCAE4s6IcifiUbDQsDE2?si=I3TE6d05QtK0PGo9dMj3IQ',
    description: [
      "It's giving spa day meets deep tissue massage. Might hurt a little, but it's absolutely worth it.",
      "Class starts with a dynamic mobility and exploratory warm-up, then melts into long, deeply myo release work. Perfect for those seeking recovery and mobility, and ideal if you're hitting higher impact classes during the week.",
    ],
    classNotes: 'All levels welcome · pre-natal friendly · modifications available throughout',
    images: ['/images/classes/recovery_classes_limber_up_1.jpg', '/images/classes/recovery_classes_limber_up_2.jpg'],
  },
  {
    id: 'limber-power-flow',
    name: 'Limber Power Flow',
    tags: ['Vinyasa Yoga', 'Strength + Flexibility'],
    spotlight: 'Strength, flexibility + breath',
    energyGuide: 'Medium–high 🔥',
    soundsLike: 'https://open.spotify.com/playlist/6lC4ygC23BnCIMP8cff12q?si=1k7tivSoSUuneJAyHmmWAw',
    description: [
      "Sequences build, fire arrives, and somewhere in the middle you'll find yourself completely in flow state.",
    ],
    classNotes: 'All levels welcome · pre-natal friendly · warm room',
    images: ['/images/classes/power_yoga_1.jpg', '/images/classes/power_yoga_2.jpg'],
  },
  {
    id: 'limber-unfurl',
    name: 'Limber Unfurl',
    tags: ['Yin + Somatic Movement', 'Deeply Restorative', 'The Quietest Hour Of Your Week'],
    spotlight: 'Deep release, connective tissue + nervous system',
    energyGuide: 'Low',
    soundsLike: 'https://open.spotify.com/playlist/6lC4ygC23BnCIMP8cff12q?si=1k7tivSoSUuneJAyHmmWAw',
    description: [
      "This is the one people don't know they need until they try it. And then they're hooked.",
      "Limber Unfurl is our deeply restorative yin and somatic movement class. Long passive holds that target the deep connective tissue in ways that flowing classes simply can't reach. One of the most powerful classes you can do for your body.",
    ],
    classNotes: 'All levels welcome · pre-natal friendly · warm room',
    images: ['/images/classes/unfurel_yin_yoga.jpg'],
  },
  {
    id: 'limber-mammas',
    name: 'Limber Mammas',
    tags: ['Pilates + Yoga', 'Postnatal', 'Bring The Baby', 'Bring The Chaos', "You're So Welcome Here"],
    spotlight: 'Core reconnection, strength + restoration',
    energyGuide: 'Medium',
    soundsLike: '#',
    description: [
      'For mums with bubs from 6 weeks to 2 years old. Naps, cries, giggles, all welcome. This is a session where motherhood in all its beautiful, messy, unpredictable glory is not just tolerated but genuinely celebrated.',
      "We'll guide you through gentle, strengthening pilates and yoga-inspired movement to rebuild your core, reconnect with your body, and release the tension that comes with keeping a small human alive.",
    ],
    classNotes: 'Medical clearance required from 6 weeks',
    images: ['/images/mamma.webp'],
  },
  {
    id: 'limboogie',
    name: 'Limboogie',
    nameSplit: ['Lim', 'Boogie'],
    tags: ['Dance', 'Movement', 'Pure Joy', 'No Experience Required', 'Just Bring Yourself'],
    spotlight: 'Joyful expression + full body movement',
    energyGuide: 'Medium–high 🔥',
    soundsLike: '#',
    description: [
      'Remember dancing around your bedroom as a kid with absolutely zero self-consciousness? Well, introducing Limboogie.',
      "Our dance-inspired movement class and it is exactly as fun as it sounds. No right or wrong way to move, just music, movement, and the kind of joy that makes you forget you're exercising.",
    ],
    classNotes: 'All levels welcome · pre-natal friendly · modifications available throughout',
    images: ['/images/Limber_April26_112.jpg'],
  },
  {
    id: 'limber-live-music',
    name: 'Limber Live Music',
    tags: ['Yoga', 'Immersive', 'Grounding', '1st & 3rd Tuesday'],
    spotlight: 'Nervous system + deep presence',
    energyGuide: 'Low',
    soundsLike: '#',
    description: [
      'We have started hosting live music sessions in some of our yoga classes. The music helps slow everything down, your breathing softens, your nervous system settles and you stop thinking about what\'s next.',
      'In a world that\'s chaotic and overstimulating we wanted to create a class that feels immersive, grounding and a little magic.',
    ],
    classNotes: 'All levels welcome · pre-natal friendly · modifications available throughout · 1st & 3rd Tuesday of the month',
    images: ['/images/limber_live_music.jpg', '/images/limber_live_music_1.jpg'],
  },
  {
    id: 'limber-breathe',
    name: 'Limber Breathe',
    tags: ['Breathwork', 'Nervous System', 'Deep Release', '60 Minutes'],
    spotlight: 'Breath + nervous system regulation',
    energyGuide: 'Varies by session',
    soundsLike: '#',
    description: [
      'Two distinct breathwork experiences, each guided by a specialist teacher.',
      'Rebirthing Breathwork with Ali Logan — Slower · Pre-natal friendly · 60 mins. Guided breathwork designed to help you cultivate safety within your nervous system and reconnect with yourself on a deeper level. Explore the connection between body, mind, and emotions, releasing stored tension, limiting patterns and unconscious beliefs.',
      'Dynamic Breathwork with Sam Bennett — Energising · Not pre-natal friendly · 60 mins. An energising breathwork designed to awaken the body, sharpen the mind and build resilience. A combination of breathwork techniques and guided holds — you will learn how to tap into your body\'s natural capacity for focus, vitality and calm under pressure.',
      'If you have any health or medical issues please reach out to us so we can ensure you are cared for during the session.',
    ],
    classNotes: 'Please reach out before booking if you have any health or medical conditions',
    images: ['/images/breathwork.jpg', '/images/breathwork-1.jpg'],
  },
];
---

<BaseLayout
  title="Our Classes"
  description="Explore every class at Limber — from mat Pilates to yin yoga, strength, barre, dance, and more."
>

  <!-- ── INTRO ── -->
  <FullBleedHero
    bgColor="bg-limber-brown"
    borderColor="border-limber-bright"
    image="/images/Yoga-classes.jpg"
    sectionBorderColor="border-limber-bright"
    imageAlt="Limber classes"
    imageHeight="h-80 lg:h-[600px]"
    contentPadding="px-4 sm:px-6 lg:px-8 pt-10 lg:pt-14 pb-16 lg:pb-20"
  >

    <!-- Heading -->
    <div class="mb-10">
      <h1 class="mb-0 stacked-heading">
        <span class="lg:flex lg:items-end lg:justify-start lg:gap-[0.2em] leading-none">
          <span class="font-headline uppercase text-4xl md:text-5xl lg:text-6xl text-limber-bright block leading-none">move</span>
          <span class="font-display italic font-medium text-5xl md:text-6xl lg:text-7xl text-limber-cream block leading-none">Your way</span>
        </span>
      </h1>
    </div>

    <!-- Body copy + first timer note -->
    <div class="lg:grid lg:grid-cols-2 lg:gap-16 items-start">
      <div class="space-y-4">
        <p class="font-sans text-limber-cream/80 leading-relaxed">
          We don't believe in one-size-fits-all movement. Some days you want to sweat. Some days you want to stretch. Some days you just want to lie on a mat and let someone else do the thinking.
        </p>
        <p class="font-sans text-limber-cream/80 leading-relaxed">
          That's why we built eight distinct classes. Each one designed to feel different, challenge you differently and leave you with a different kind of good. Whether you're here to build strength, find calm, move to a beat or just see what your body can do today, there's a class for that.
        </p>
        <p class="font-sans text-limber-cream/80 leading-relaxed">
          As always, listen to your body. Take it up, take it down. We're here to guide you.
        </p>
      </div>
      <div class="mt-8 lg:mt-0">
        <div class="bg-limber-cream rounded-2xl border-2 border-limber-bright p-6">
          <p class="font-headline text-xs text-limber-brown mb-2">Ready for your first class?</p>
          <p class="font-sans text-sm text-limber-brown/80 leading-relaxed mb-4">
            Take a look at our community guidelines.
          </p>
          <a href="/community-guidelines" class="font-headline text-xs text-limber-brown hover:text-limber-tericotta transition-colors block" style="text-align: left;">
            Community guidelines →
          </a>
        </div>
      </div>
    </div>

  </FullBleedHero>

  <!-- ── CLASSES ── -->

  <!-- Mobile: sticky tab bar -->
  <div class="lg:hidden sticky top-[112px] z-10 bg-limber-tericotta border-b-2 border-limber-green overflow-x-auto" style="scrollbar-width: none;">
    <nav class="flex min-w-max" aria-label="Class list">
      {classes.map((cls, i) => (
        <button
          type="button"
          data-nav-btn={cls.id}
          class:list={[
            'px-5 py-4 whitespace-nowrap border-r border-limber-brown/20 transition-colors hover:bg-limber-brown cursor-pointer',
            i === 0 ? 'bg-limber-brown' : 'bg-transparent',
          ]}
        >
          <span class="font-headline uppercase text-sm text-limber-cream">{cls.name}</span>
        </button>
      ))}
    </nav>
  </div>

  <!-- Flex wrapper: desktop sticky sidebar + shared sections -->
  <div class="lg:flex items-start border-b-2 border-limber-green">

    <!-- Desktop sticky sidebar -->
    <aside class="hidden lg:flex flex-col w-64 xl:w-72 flex-shrink-0 border-r-2 border-limber-green bg-limber-tericotta sticky top-[122px] h-[calc(100vh-7.625rem)]">
      <div class="px-6 py-5 border-b-2 border-limber-brown/30 flex-shrink-0">
        <p class="font-headline uppercase text-lg xl:text-xl text-limber-cream">Our Classes</p>
      </div>
      <nav class="flex-1 overflow-y-auto" aria-label="Class list">
        {classes.map((cls, i) => (
          <button
            type="button"
            data-nav-btn={cls.id}
            class:list={[
              'w-full text-left px-6 py-4 border-b border-limber-brown/20 transition-colors hover:bg-limber-brown cursor-pointer',
              i === 0 ? 'bg-limber-brown' : 'bg-transparent',
            ]}
          >
            <span class="font-headline uppercase text-sm text-limber-cream">{cls.name}</span>
          </button>
        ))}
      </nav>
    </aside>

    <!-- Shared class sections -->
    <div class="flex-1 bg-limber-cream divide-y-2 divide-limber-green">
      {classes.map((cls) => (
        <section id={cls.id} data-class-section class="p-5 sm:p-6 lg:p-10 xl:p-12 scroll-mt-[170px] lg:scroll-mt-[122px]">

          <!-- Heading + book -->
          <div class="mb-4 lg:flex lg:items-start lg:justify-between lg:gap-4">
            <h2 class="font-headline uppercase text-2xl lg:text-4xl xl:text-5xl text-limber-green leading-none mb-3 lg:mb-0">{cls.name}</h2>
            <a href="https://momence.com/m/411175" target="_blank" rel="noopener noreferrer" class="hidden lg:inline-flex items-center flex-shrink-0 px-6 py-3 font-headline text-xs text-limber-cream bg-limber-tericotta hover:bg-limber-brown border-2 border-limber-green rounded-full transition-colors">
              <span class="relative top-[2px]">Book a class</span>
            </a>
          </div>

          <!-- Tags -->
          <div class="flex flex-wrap gap-2 mb-6">
            {cls.tags.map(tag => (
              <span class="font-display italic text-sm font-[800] text-limber-green border border-limber-green px-3 py-1 rounded-full">{tag}</span>
            ))}
          </div>

          <!-- Image + content -->
          <div class="lg:grid lg:grid-cols-2 lg:gap-8 xl:gap-12 items-start">

            <!-- Image(s) -->
            <div class="mb-6 lg:mb-0">
              {cls.images.length === 1 ? (
                <img
                  src={cls.images[0]}
                  alt={cls.name}
                  class="w-full h-56 lg:h-72 object-cover rounded-2xl border-2 border-limber-green"
                />
              ) : (
                <div class="grid grid-cols-2 gap-3">
                  {cls.images.map((img, idx) => (
                    <img
                      src={img}
                      alt={`${cls.name} — photo ${idx + 1}`}
                      class="w-full h-40 lg:h-56 object-cover rounded-2xl border-2 border-limber-green"
                    />
                  ))}
                </div>
              )}
            </div>

            <!-- Meta + description -->
            <div>
              <!-- Class notes -->
              <p class="font-sans text-xs italic text-limber-brown/50 mb-3">{cls.classNotes}</p>

              <!-- Description -->
              <div class="space-y-3 mb-5">
                {cls.description.map(p => (
                  <p class="font-sans text-sm text-limber-brown/80 leading-relaxed">{p}</p>
                ))}
              </div>

              <!-- Meta card -->
              <div class:list={['grid gap-px bg-limber-green/10 rounded-2xl overflow-hidden border-2 border-limber-green grid-cols-1', cls.soundsLike && cls.soundsLike !== '#' ? 'sm:grid-cols-3' : 'sm:grid-cols-2']}>
                <div class="bg-limber-cream p-4">
                  <p class="font-headline text-xs text-limber-tericotta mb-1">Spotlight On</p>
                  <p class="font-sans text-xs text-limber-brown/80 leading-snug">{cls.spotlight}</p>
                </div>
                <div class="bg-limber-cream p-4">
                  <p class="font-headline text-xs text-limber-tericotta mb-1">Energy</p>
                  <p class="font-sans text-xs text-limber-brown/80">{cls.energyGuide}</p>
                </div>
                {cls.soundsLike && cls.soundsLike !== '#' && (
                  <div class="bg-limber-cream p-4">
                    <p class="font-headline text-xs text-limber-tericotta mb-1">Sounds Like</p>
                    <a href={cls.soundsLike} target="_blank" rel="noopener noreferrer" class="font-sans text-xs text-limber-tericotta hover:text-limber-brown transition-colors block leading-snug" style="text-align: left;">Playlist →</a>
                  </div>
                )}
              </div>
            </div>

          </div>

          <!-- Mobile book button -->
          <div class="lg:hidden mt-6">
            <a href="https://momence.com/m/411175" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center w-full px-6 py-3 font-headline text-xs text-limber-cream bg-limber-tericotta hover:bg-limber-brown border-2 border-limber-green rounded-full transition-colors">
              <span class="relative top-[2px]">Book a class</span>
            </a>
          </div>

        </section>
      ))}
    </div>

  </div>

  <!-- ── BOTTOM NOTE ── -->
  <section class="bg-limber-green py-16 lg:py-20 border-t-2 border-limber-vibe">
    <div class="px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-2 lg:gap-16 items-start">
        <div>
          <h2 class="mb-6 lg:mb-0">
            <p class="font-display italic text-xl text-limber-cream mb-3">A note on</p>
            <span class="font-headline uppercase text-4xl md:text-5xl lg:text-6xl text-limber-vibe block leading-none">injuries,</span>
            <span class="font-headline uppercase text-4xl md:text-5xl lg:text-6xl text-limber-vibe block leading-none">niggles</span>
            <span class="font-headline uppercase text-4xl md:text-5xl lg:text-6xl text-limber-vibe block leading-none">&amp; pregnancy</span>
          </h2>
        </div>
        <div class="space-y-4">
          <p class="font-sans text-limber-cream/80 leading-relaxed">
            Got something going on in your body? Always let your teacher know before class. We're trained, we care, and we will absolutely sort you out with modifications.
          </p>
          <p class="font-sans text-limber-cream/80 leading-relaxed">
            Pregnant or postnatal? Wonderful. Please email us at <a href="mailto:hello@limberco.com.au" class="text-limber-vibe hover:text-limber-cream transition-colors">hello@limberco.com.au</a> before booking so we can make sure you're in the right class and properly looked after.
          </p>
          <p class="font-sans text-limber-cream/80 leading-relaxed">
            All our teachers are fully qualified and committed to ongoing education. You're in good hands.
          </p>
          <div class="pt-4 flex justify-start">
            <a
              href="/book-now"
              class="inline-flex items-center px-8 py-4 font-headline text-sm text-limber-green bg-limber-vibe hover:bg-limber-bright border-2 border-limber-green rounded-full transition-colors"
            >
              <span class="relative top-[2px]">Book a class</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  const navBtns = document.querySelectorAll('[data-nav-btn]');
  const sections = document.querySelectorAll('[data-class-section]');

  function setActive(id: string) {
    navBtns.forEach((b) => {
      const isActive = b.getAttribute('data-nav-btn') === id;
      b.classList.toggle('bg-limber-brown', isActive);
      b.classList.toggle('text-limber-vibe', isActive);
      b.classList.toggle('text-limber-brown', !isActive);
      b.classList.toggle('bg-transparent', !isActive);
    });
    // Keep active sidebar item in view
    const activeBtn = document.querySelector(`[data-nav-btn="${id}"]`);
    activeBtn?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
  }

  // Click to scroll to section
  navBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-nav-btn');
      if (!id) return;
      const section = document.getElementById(id);
      section?.scrollIntoView({ behavior: 'smooth' });
      setActive(id);
    });
  });

  // Scrollspy — highlight sidebar item as sections scroll into view
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          setActive(entry.target.id);
        }
      });
    },
    {
      rootMargin: '-20% 0px -70% 0px',
      threshold: 0,
    }
  );

  sections.forEach((s) => observer.observe(s));

  // Activate from URL hash on load
  const hash = window.location.hash.replace('#', '');
  if (hash) {
    const el = document.getElementById(hash);
    if (el) {
      el.scrollIntoView();
      setActive(hash);
    }
  }
</script>
