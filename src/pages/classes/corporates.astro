---
import BaseLayout from '../../layouts/BaseLayout.astro';

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 name: 'Corporate Wellness — Limber',
 description: 'Limber offers corporate wellness programs including on-site and in-studio Pilates and movement classes for teams.',
 provider: { '@type': 'LocalBusiness', name: 'Limber', url: 'https://limberco.com.au' },
};
---

<BaseLayout
 title="Corporate Wellness"
 description="Bring the benefits of Pilates and movement to your workplace with Limber's corporate wellness programs. On-site or in-studio."
 schema={serviceSchema}
>
 <section class="bg-limber-vibe py-24 lg:py-36">
 <div class=" px-4 sm:px-6 lg:px-8">
 <a href="/classes" class="inline-flex items-center gap-2 font-headline text-xs text-limber-brown/60 hover:text-limber-brown transition-colors mb-10">
 <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
 Classes
 </a>
 <p class="font-headline text-xs text-limber-brown/60 mb-4">Classes</p>
 <h1 class="font-headline text-5xl md:text-6xl lg:text-7xl text-limber-brown leading-tight mb-6">
 Corporate Wellness
 </h1>
 <p class="font-sans text-lg text-limber-brown/80 leading-relaxed">
 Move your team well. Whether you're bringing us to the office or bringing your team to us, we make workplace wellness actually work.
 </p>
 </div>
 </section>

 <section class="py-20 bg-limber-cream-bg">
 <div class=" px-4 sm:px-6 lg:px-8">
 <h2 class="font-headline text-4xl text-limber-green mb-4">Why movement at work?</h2>
 <p class="font-sans text-limber-brown/80 mb-12">
 The research is clear — teams that move together perform better, feel better, and stick around longer.
 </p>
 <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
 {
 [
 { stat: '↑ Focus', body: 'Regular movement sessions improve concentration, creativity, and cognitive function.' },
 { stat: '↓ Sick days', body: 'Improved physical health means fewer absences and reduced healthcare costs.' },
 { stat: '↑ Retention', body: 'Wellness perks are consistently ranked among the top employee benefits.' },
 { stat: 'Stress relief', body: 'Pilates and mindful movement are evidence-backed tools for managing workplace stress.' },
 { stat: 'Team culture', body: 'Shared movement builds rapport, breaks down silos, and boosts morale.' },
 { stat: 'Flexibility', body: 'We work around your schedule — lunchtime, before work, or end of day.' },
 ].map(({ stat, body }) => (
 <div class="p-6 rounded-xl bg-limber-cream border-2 border-limber-green/20">
 <p class="font-headline text-xl text-limber-tericotta mb-2">{stat}</p>
 <p class="font-sans text-sm text-limber-brown/80 leading-relaxed">{body}</p>
 </div>
 ))
 }
 </div>
 </div>
 </section>

 <section class="py-16 bg-limber-green">
 <div class=" px-4 sm:px-6 lg:px-8">
 <h2 class="font-headline text-4xl text-limber-cream mb-10">How it works</h2>
 <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
 <div class="p-10 rounded-2xl bg-limber-cream/10 border-2 border-limber-cream/20">
 <h3 class="font-headline text-2xl text-limber-cream mb-3">In-studio sessions</h3>
 <p class="font-sans text-limber-cream/80 leading-relaxed">
 Bring your team to Limber for a dedicated class or series. We schedule exclusive timeslots for your group.
 </p>
 </div>
 <div class="p-10 rounded-2xl bg-limber-cream/10 border-2 border-limber-cream/20">
 <h3 class="font-headline text-2xl text-limber-cream mb-3">On-site classes</h3>
 <p class="font-sans text-limber-cream/80 leading-relaxed">
 We come to you. Our instructors travel to your workplace and set up a mat-based class in whatever space you have.
 </p>
 </div>
 </div>
 </div>
 </section>

 <section class="py-20 bg-limber-tericotta">
 <div class=" px-4 sm:px-6 text-center">
 <h2 class="font-headline text-4xl md:text-5xl text-limber-cream mb-4">
 Let's build something for your team
 </h2>
 <p class="font-sans text-limber-cream/80 mb-8">
 Get in touch and we'll put together a proposal tailored to your team size, goals, and budget.
 </p>
 <a href="/contact" class="inline-flex items-center px-8 py-4 font-headline text-sm text-limber-tericotta bg-limber-cream hover:bg-limber-bright border-2 border-neutral-900 rounded-full transition-colors">
 Get in Touch
 </a>
 </div>
 </section>
</BaseLayout>
