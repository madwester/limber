---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaSlice from '../../components/CtaSlice.astro';
import FullBleedHero from '../../components/FullBleedHero.astro';
import PricingHero from '../../components/PricingHero.astro';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Corporate Wellness — Limber',
  description: 'The Workplace Reset — a professionally facilitated movement experience designed specifically for modern workplaces.',
  provider: { '@type': 'LocalBusiness', name: 'Limber', url: 'https://limberco.com.au' },
};
---

<BaseLayout
  title="Corporate Wellness"
  description="The Workplace Reset — a professionally facilitated movement experience designed specifically for modern workplaces."
  schema={serviceSchema}
>

  <!-- ── HERO ── -->
  <FullBleedHero
    bgColor="bg-limber-brown"
    borderColor="border-limber-bright"
    image="/images/corporate-hero.jpg"
    imageAlt="Limber team session"
    imageHeight="h-[520px] lg:h-[640px]"
    contentPadding="px-4 sm:px-6 lg:px-8 pt-8 pb-0 lg:pt-10 lg:pb-0"
  >
    <div class="lg:grid lg:grid-cols-2 lg:gap-16 items-center">
      <div>
        <h1 class="stacked-heading mb-0">
          <span class="font-headline uppercase text-5xl md:text-6xl lg:text-7xl text-limber-bright block leading-none -mb-1">the <span class="font-display normal-case italic font-medium text-limber-cream relative top-[-0.15em] lg:top-0">Workplace</span></span>
          <span class="font-headline uppercase text-5xl md:text-6xl lg:text-7xl text-limber-bright block leading-none">reset</span>
        </h1>
      </div>
      <!-- Flower sticker on the right -->
      <div class="hidden lg:flex items-center justify-end">
        <div
          aria-hidden="true"
          class="w-36 h-36 rotate-[10deg]"
          style="background-color: var(--color-limber-vibe); -webkit-mask-image: url('/images/stickers/flower.svg'); mask-image: url('/images/stickers/flower.svg'); -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat; -webkit-mask-size: contain; mask-size: contain; -webkit-mask-position: center; mask-position: center;"
        ></div>
      </div>
    </div>
  </FullBleedHero>

  <!-- ── INTRO ── -->
  <section id="workplace-reset" class="bg-limber-brown pt-8 pb-16 lg:pt-10 lg:pb-20 border-b-2 border-limber-bright">
    <div class="px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-2 lg:gap-16 items-start">
        <div class="space-y-4">
          <p class="font-sans text-limber-cream/80 leading-relaxed">
            At Limber, we know that the benefits of movement extend far beyond the body. And in busy workplaces, it's often the first thing to fall away. Yet studies show that improving employee wellbeing through structured wellness programs not only has incredible uplift for the individual, but a reduction to lost productivity by up to 27%. The long hours at desks, high cognitive loads and nervous systems stuck in "on" mode present in more ways than tight shoulders and stiff hips.
          </p>
          <p class="font-sans text-limber-cream/80 leading-relaxed">Over time, we experience:</p>
          <ul class="space-y-2">
            {['Fatigue', 'Irritability', 'Reduced focus', 'Disconnected teams'].map((item) => (
              <li class="font-sans text-limber-cream/80 flex justify-start gap-3">
                <span class="text-limber-bright flex-shrink-0">•</span>
                {item}
              </li>
            ))}
          </ul>
          <p class="font-sans text-limber-cream/80 leading-relaxed">
            The Workplace Reset is a simple, professionally facilitated way to interrupt that pattern and bring people back into their bodies, and back into the room.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- ── WHAT IS IT + WHAT'S INCLUDED ── -->
  <section class="bg-limber-brown py-16 lg:py-24 border-b-2 border-limber-bright">
    <div class="px-4 sm:px-6 lg:px-8">

      <div class="lg:grid lg:grid-cols-2 lg:gap-16 items-start">

        <!-- Left: heading + text + what's included -->
        <div>
          <h2 class="stacked-heading mb-6">
            <span class="font-headline uppercase text-4xl md:text-5xl text-limber-bright block leading-none -mb-1">what</span>
            <span class="font-display italic font-medium text-4xl md:text-5xl text-limber-cream block leading-none">Exactly is the reset?</span>
          </h2>
          <p class="font-sans text-limber-cream/80 leading-relaxed mb-8">
            A blend of pilates foundations, mobility flow, gentle strength activation and breathwork — releasing desk-bound tension, improving posture, activating underused muscles, supporting spinal health and regulating the nervous system.
          </p>
          <div class="bg-limber-cream rounded-2xl border-2 border-limber-green p-8">
            <p class="font-headline text-xs text-limber-brown mb-6">What's included</p>
            <ul class="space-y-3">
              {[
                'Professionally facilitated session',
                'Mats and equipment provided',
                'Designed for mixed ability levels',
                '14 days of complimentary access to three short Limber reset videos for your team',
              ].map((item) => (
                <li class="flex items-center gap-3 border-b border-limber-green/10 pb-3 last:border-0 last:pb-0">
                  <span class="w-1.5 h-1.5 rounded-full bg-limber-brown flex-shrink-0"></span>
                  <p class="font-display not-italic text-lg text-limber-brown">{item}</p>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Right: image -->
        <div class="mt-10 lg:mt-0">
          <img
            src="/images/corporate.webp"
            alt="Limber workplace reset session"
            class="w-full h-[480px] object-cover rounded-2xl border-2 border-limber-bright"
          />
        </div>

      </div>
    </div>
  </section>

  <!-- ── WHY LIMBER ── -->
  <section class="bg-limber-brown py-16 lg:py-24 border-b-2 border-limber-bright">
    <div class="px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-2 lg:gap-16 items-start">
        <div>
          <h2 class="stacked-heading mb-6">
            <span class="font-headline uppercase text-4xl md:text-5xl text-limber-bright block leading-none -mb-1">why</span>
            <span class="font-display italic font-medium text-4xl md:text-5xl text-limber-cream block leading-none">Limber?</span>
          </h2>
          <p class="font-sans text-limber-cream/80 leading-relaxed mb-4">
            At Limber, we started with a simple belief: movement should genuinely feel good.
          </p>
          <p class="font-sans text-limber-cream/80 leading-relaxed mb-4">
            So much of traditional fitness is built on pressure. Pushing harder, doing more, fixing yourself. That never felt aligned for us.
          </p>
          <p class="font-sans text-limber-cream/80 leading-relaxed">
            We care about joyful movement, a more holistic approach, spaces where people can slow down, breathe and reconnect. In the workplace, that matters. Because when people feel supported rather than pushed, they show up clearer, calmer and more connected.
          </p>
        </div>
        <div class="mt-10 lg:mt-0">
          <img
            src="/images/Limber_April26_100.jpg"
            alt="Limber studio"
            class="w-full h-64 lg:h-80 object-cover rounded-2xl border-2 border-limber-bright"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA SLICE ── -->
  <CtaSlice
    headingLine1="Ready to reset"
    headingLine2="Your team?"
    body="We'd love to learn more about your team and tailor the experience to your workplace. Get in touch and we'll send through our full information pack."
    sectionBg="bg-limber-cream"
    cardBg="bg-limber-green border-limber-vibe"
    accentColor="text-limber-vibe"
    primaryBtn="text-limber-green bg-limber-vibe hover:bg-limber-bright border-limber-vibe"
    showBorder={false}
    buttons={[
      { label: 'Enquire now', href: 'mailto:limber.collab@gmail.com', variant: 'primary' },
      { label: 'Call us: 0452 610 210', href: 'tel:0452610210', variant: 'outline' },
    ]}
    image="/images/Limber_April26_98.jpg"
    imageAlt="Limber workplace reset session"
  />

</BaseLayout>
