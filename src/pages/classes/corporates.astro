---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaSlice from '../../components/CtaSlice.astro';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Corporate Wellness — Limber',
  description: 'The Workplace Reset — a professionally facilitated movement experience designed specifically for modern workplaces.',
  provider: { '@type': 'LocalBusiness', name: 'Limber', url: 'https://limberco.com.au' },
};
---

<BaseLayout
  title="Corporate Wellness"
  description="The Workplace Reset — a professionally facilitated movement experience designed specifically for modern workplaces."
  schema={serviceSchema}
>

  <!-- ── INTRO ── -->
  <section class="bg-limber-cream py-16 lg:py-20 border-b-2 border-neutral-900">
    <div class="px-4 sm:px-6 lg:px-8">

      <!-- Centered heading -->
      <div class="text-center mb-10">
        <h1>
          <span class="font-headline uppercase text-4xl md:text-5xl lg:text-6xl text-limber-green block leading-none mb-1">your team is</span>
          <em class="font-display uppercase not-italic italic font-medium text-5xl md:text-6xl lg:text-7xl text-limber-tericotta block leading-none">running on empty.</em>
        </h1>
      </div>

      <!-- Photo -->
      <div class="mb-12">
        <img
          src="/images/limber_studio_3_girls.jpg"
          alt="Limber team session"
          class="w-full h-80 lg:h-[520px] object-cover rounded-2xl border-2 border-neutral-900"
        />
      </div>

      <!-- Body copy -->
      <div class="lg:grid lg:grid-cols-2 lg:gap-16 items-start">
        <div class="space-y-4">
          <p class="font-sans text-limber-brown/80 leading-relaxed">
            long hours, high cognitive load, nervous systems stuck on "on." it shows up as tight shoulders and stiff hips — but over time it becomes fatigue, irritability, reduced focus and disconnected teams.
          </p>
          <p class="font-display italic text-xl text-limber-tericotta leading-snug">
            the workplace reset is limber's answer to that.
          </p>
          <p class="font-sans text-limber-brown/80 leading-relaxed">
            a professionally facilitated movement experience designed specifically for modern workplaces. not a generic fitness class. just a guided session that brings your team back into their bodies — and back into the room.
          </p>
        </div>
        <div class="mt-8 lg:mt-0">
          <p class="font-display italic text-xl text-limber-tericotta leading-snug py-5 border-b border-neutral-900/10">
            physically lighter, mentally clearer, more regulated.
          </p>
          <p class="font-display italic text-xl text-limber-tericotta leading-snug py-5 border-b border-neutral-900/10">
            more connected to each other.
          </p>
          <p class="font-display italic text-xl text-limber-tericotta leading-snug py-5">
            after just one session.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- ── WHAT IS IT + WHAT'S INCLUDED ── -->
  <section class="bg-limber-cream-bg py-16 lg:py-24 border-b-2 border-neutral-900">
    <div class="px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-2 lg:gap-16 items-start">

        <div>
          <h2 class="mb-6">
            <span class="font-headline uppercase text-4xl md:text-5xl text-limber-green block leading-none mb-1">what is the</span>
            <em class="font-display uppercase not-italic italic font-medium text-4xl md:text-5xl text-limber-tericotta block leading-none">workplace reset?</em>
          </h2>
          <p class="font-sans text-limber-brown/80 leading-relaxed mb-6">
            a blend of pilates foundations, mobility flow, gentle strength activation and breathwork. designed to:
          </p>
          <ul class="space-y-3 mb-8">
            {[
              'release desk-bound tension',
              'improve posture and mobility',
              'activate underused muscles',
              'support spinal health',
              'regulate the nervous system',
            ].map((item) => (
              <li class="font-sans text-base text-limber-brown/80 flex gap-3">
                <span class="text-limber-tericotta flex-shrink-0">—</span>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div class="p-8 lg:p-10 rounded-2xl bg-limber-cream border-2 border-neutral-900 self-start mt-8 lg:mt-0">
          <h3 class="font-headline uppercase text-2xl text-limber-brown mb-6">what's included.</h3>
          <ul class="space-y-4">
            {[
              'professionally facilitated session',
              'mats and equipment provided',
              'designed for mixed ability levels',
              '14 days of complimentary access to three short limber reset videos for your team to use at their desks',
            ].map((item) => (
              <li class="font-sans text-base text-limber-brown/80 flex gap-3">
                <span class="text-limber-tericotta flex-shrink-0">—</span>
                {item}
              </li>
            ))}
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- ── WHY LIMBER ── -->
  <section class="bg-limber-green py-16 lg:py-24 border-b-2 border-neutral-900">
    <div class="px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-2 lg:gap-16 items-start">
        <div>
          <h2 class="mb-6">
            <span class="font-headline uppercase text-4xl md:text-5xl text-limber-cream block leading-none mb-1">why</span>
            <em class="font-display uppercase not-italic italic font-medium text-4xl md:text-5xl text-limber-vibe block leading-none">limber?</em>
          </h2>
          <p class="font-sans text-limber-cream/80 leading-relaxed mb-4">
            at limber, we started with a simple belief — movement should genuinely feel good.
          </p>
          <p class="font-sans text-limber-cream/80 leading-relaxed mb-4">
            so much of traditional fitness is built on pressure. pushing harder, doing more, fixing yourself. that never felt aligned for us.
          </p>
          <p class="font-sans text-limber-cream/80 leading-relaxed">
            we care about joyful movement. a more holistic approach. spaces where people can slow down, breathe and reconnect. in the workplace, that matters. because when people feel supported rather than pushed, they show up clearer, calmer and more connected.
          </p>
        </div>
        <div class="mt-10 lg:mt-0">
          <img
            src="/images/Limber_April26_100.jpg"
            alt="Limber studio"
            class="w-full h-64 lg:h-80 object-cover rounded-2xl border-2 border-neutral-900"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA SLICE ── -->
  <CtaSlice
    headingLine1="ready to reset"
    headingLine2="your team?"
    body="we'd love to learn more about your team and tailor the experience to your workplace. get in touch and we'll send through our full information pack."
    buttons={[
      { label: 'enquire now', href: 'mailto:limber.collab@gmail.com', variant: 'primary' },
      { label: 'call us — 0452 610 210', href: 'tel:0452610210', variant: 'outline' },
    ]}
    image="/images/Limber_April26_106.jpg"
    imageAlt="Limber team session"
  />

</BaseLayout>
