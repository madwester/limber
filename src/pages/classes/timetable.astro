---
import BaseLayout from '../../layouts/BaseLayout.astro';

type ClassType = 'pilates' | 'yoga' | 'barre' | 'express' | 'breathwork' | 'other';

interface ClassEntry {
  name: string;
  type: ClassType;
  note?: string;
  time?: string;
}

const typeStyles: Record<ClassType, { bg: string; text: string; note: string; border: string }> = {
  pilates:    { bg: 'bg-limber-cream',     text: 'text-limber-green',  note: 'text-limber-green/50',  border: 'border-limber-green/40'  },
  yoga:       { bg: 'bg-limber-brown',     text: 'text-limber-cream',  note: 'text-limber-cream/60',  border: 'border-limber-brown/10'  },
  barre:      { bg: 'bg-limber-vibe',      text: 'text-limber-green',  note: 'text-limber-green/60',  border: 'border-limber-green/10'  },
  express:    { bg: 'bg-limber-bright',    text: 'text-limber-brown',  note: 'text-limber-brown/60',  border: 'border-limber-bright/10' },
  breathwork: { bg: 'bg-limber-tericotta', text: 'text-limber-cream',  note: 'text-limber-cream/60',  border: 'border-limber-tericotta/10' },
  other:      { bg: 'bg-limber-tericotta', text: 'text-limber-cream',  note: 'text-limber-cream/60',  border: 'border-limber-tericotta/10' },
};

// Columns: [Mon, Tue, Wed, Thu, Fri, Sat, Sun]
// Sat/Sun entries include their actual time in the `time` field so it shows inside the card.
const allDays = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];

const allSlots: Array<{ time: string; classes: (ClassEntry | null)[] }> = [
  { time: '5am', classes: [
    null,
    null,
    null,
    { name: 'Signature pilates', type: 'pilates' },
    null,
    null,
    null,
  ]},
  { time: '6am', classes: [
    { name: 'Strength pilates',  type: 'pilates' },
    { name: 'Chair pilates',     type: 'pilates' },
    { name: 'Strength pilates',  type: 'pilates' },
    { name: 'Limbarre',          type: 'barre'   },
    { name: 'Signature pilates', type: 'pilates' },
    { name: 'Signature pilates', type: 'pilates', time: '6:30am' },
    null,
  ]},
  { time: '7am', classes: [
    { name: 'Power flow yoga',   type: 'yoga'    },
    { name: 'Strength pilates',  type: 'pilates' },
    { name: 'Signature pilates', type: 'pilates' },
    { name: 'Signature pilates', type: 'pilates' },
    { name: 'Limbarre',          type: 'barre'   },
    { name: 'Strength pilates',  type: 'pilates', time: '7:30am' },
    { name: 'Signature pilates', type: 'pilates', time: '7:30am' },
  ]},
  { time: '8am', classes: [
    { name: 'Strength pilates',  type: 'pilates' },
    { name: 'Signature pilates', type: 'pilates' },
    { name: 'Power flow yoga',   type: 'yoga'    },
    { name: 'Strength pilates',  type: 'pilates' },
    { name: 'Chair pilates',     type: 'pilates' },
    { name: 'Chair pilates',     type: 'pilates', time: '8:30am' },
    { name: 'Limbarre',          type: 'barre',   time: '8:30am' },
  ]},
  { time: '9:15am', classes: [
    { name: 'Signature pilates', type: 'pilates' },
    { name: 'Chair pilates',     type: 'pilates' },
    { name: 'Strength pilates',  type: 'pilates' },
    { name: 'Limbarre',          type: 'barre'   },
    { name: 'Strength pilates',  type: 'pilates' },
    { name: 'Power flow yoga',   type: 'yoga',    time: '9:30am' },
    { name: 'Strength pilates',  type: 'pilates', time: '9:30am' },
  ]},
  { time: '10:15am', classes: [
    null,
    { name: 'Limbarre',          type: 'barre'                              },
    { name: 'Signature pilates', type: 'pilates', note: 'Babies welcome 👶' },
    { name: 'Chair pilates',     type: 'pilates'                            },
    { name: 'Limboogie',         type: 'other',   note: 'Babies welcome'   },
    null,
    null,
  ]},
  { time: '12:15pm', classes: [
    { name: 'Signature pilates', type: 'pilates', note: 'Express · 30 min' },
    null,
    { name: 'Power flow yoga',   type: 'yoga',    note: 'Express · 30 min' },
    null,
    { name: 'Limbarre',          type: 'barre',   note: 'Express · 30 min' },
    null, null,
  ]},
  { time: '4:30pm', classes: [
    { name: 'Limbarre',          type: 'barre',   note: 'Babies welcome 👶' },
    { name: 'Signature pilates', type: 'pilates'                             },
    { name: 'Chair pilates',     type: 'pilates'                             },
    null,
    { name: 'Power flow yoga',   type: 'yoga',    time: '5pm'               },
    null,
    null,
  ]},
  { time: '5:30pm', classes: [
    { name: 'Chair pilates',     type: 'pilates'                },
    { name: 'Strength pilates',  type: 'pilates'                },
    { name: 'Signature pilates', type: 'pilates'                },
    { name: 'Strength pilates',  type: 'pilates'                },
    { name: 'Unfurl yin yoga',   type: 'yoga',    time: '6pm'  },
    null,
    { name: 'Unfurl yin yoga',   type: 'yoga',    time: '5pm'  },
  ]},
  { time: '6:30pm', classes: [
    { name: 'Signature pilates', type: 'pilates' },
    { name: 'Limber up',         type: 'yoga'    },
    { name: 'Strength pilates',  type: 'pilates' },
    { name: 'Signature pilates', type: 'pilates' },
    { name: 'Breathwork',        type: 'other',  time: '7:15pm', note: '2nd & last Friday of the month' },
    null, null,
  ]},
  { time: '7:30pm', classes: [
    { name: 'Limber up',         type: 'yoga'    },
    { name: 'Unfurl yin yoga',   type: 'yoga'    },
    { name: 'Limber up',         type: 'yoga'    },
    { name: 'Unfurl yin yoga',   type: 'yoga'    },
    null,
    null, null,
  ]},
];

const legendItems: Array<{ label: string; type: ClassType }> = [
  { label: 'Pilates',    type: 'pilates'    },
  { label: 'Yoga',       type: 'yoga'       },
  { label: 'Barre',      type: 'barre'      },
  { label: 'Other',      type: 'other'      },
];
---

<BaseLayout
  title="Timetable"
  description="View the Limber weekly class schedule — pilates, yoga, barre and more, 7 days a week. Find your class and book your spot."
>

  <!-- ── HERO ── -->
  <section class="bg-limber-green border-b-2 border-limber-vibe px-8 lg:px-14 py-16 lg:py-24">
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8">
      <h1>
        <span class="font-headline uppercase text-5xl md:text-6xl lg:text-7xl text-limber-vibe block leading-none -mb-1">timetable</span>
        <span class="font-display italic font-medium text-6xl md:text-7xl lg:text-8xl text-limber-cream block leading-none">Find your flow</span>
      </h1>
      <div class="lg:pb-2 space-y-4 max-w-sm">
        <p class="font-sans text-limber-cream/80 leading-relaxed">
          7 days a week. Pilates, yoga, barre and more. Find a time that works for you and book your spot in seconds.
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            href="/book-now"
            class="inline-flex items-center px-8 py-4 font-headline text-sm text-limber-green bg-limber-vibe hover:bg-limber-bright border-2 border-limber-vibe rounded-full transition-colors"
          >
            <span class="relative top-[2px]">Book now</span>
          </a>
          <a
            href="/classes/our-classes"
            class="inline-flex items-center px-8 py-4 font-headline text-sm text-limber-cream border-2 border-limber-cream hover:border-limber-vibe hover:text-limber-vibe rounded-full transition-colors"
          >
            <span class="relative top-[2px]">Explore classes</span>
          </a>
        </div>
      </div>
    </div>
  </section>


  <!-- ── TIMETABLE ── -->
  <section class="bg-limber-cream py-16 lg:py-24 border-b-2 border-limber-green">
    <div class="px-4 sm:px-6 lg:px-8">

      <!-- Legend -->
      <div class="flex flex-wrap gap-2 mb-12">
        {legendItems.map((item) => (
          <div class:list={['inline-flex items-center gap-2 px-4 py-2 rounded-full border', typeStyles[item.type].bg, typeStyles[item.type].border]}>
            <span class:list={['font-headline text-xs', typeStyles[item.type].text]}>{item.label}</span>
          </div>
        ))}
      </div>

      <!-- ── ALL 7 DAYS ── -->
      <div class="overflow-x-auto -mx-4 sm:-mx-6 lg:mx-0 px-4 sm:px-6 lg:px-0" style="scrollbar-width: none;">
        <!-- Single grid so all 7 columns share the same track widths across every row -->
        <div class="grid" style="min-width: 700px; grid-template-columns: repeat(7, minmax(0, 1fr)); column-gap: 8px; row-gap: 8px;">

          <!-- Day headers -->
          {allDays.map((day, i) => (
            <div class:list={[
              'font-headline text-xs uppercase tracking-wide px-3',
              i >= 5 ? 'text-limber-tericotta/70' : 'text-limber-green/70',
            ]}>{day}</div>
          ))}

          <!-- Data cells — all slots flattened into the same grid -->
          {allSlots.map((slot) =>
            slot.classes.map((entry) => (
              <div style="min-height: 80px;">
                {entry ? (
                  <div class:list={['h-full rounded-xl px-3 py-3 flex flex-col border', typeStyles[entry.type].bg, typeStyles[entry.type].border]}>
                    <span class:list={['font-headline text-xs leading-none mb-1 opacity-60', typeStyles[entry.type].text]}>{slot.time}</span>
                    <p class:list={['font-headline text-sm leading-snug flex-1', typeStyles[entry.type].text]}>{entry.name}</p>
                    {entry.note && (
                      <p class:list={['font-sans text-xs leading-snug mt-1.5', typeStyles[entry.type].note]}>{entry.note}</p>
                    )}
                  </div>
                ) : (
                  <div class="h-full rounded-xl border border-dashed border-limber-green/10" style="min-height: 80px;"></div>
                )}
              </div>
            ))
          )}

        </div>
      </div>

    </div>
  </section>

  <!-- ── GOOD TO KNOW ── -->
  <section class="bg-limber-brown py-16 lg:py-24">
    <div class="px-4 sm:px-6 lg:px-8">

      <h2 class="mb-8">
        <span class="font-headline uppercase text-3xl md:text-4xl lg:text-5xl text-limber-bright block leading-none -mb-1">Good to</span>
        <span class="font-display italic font-medium text-4xl md:text-5xl lg:text-6xl text-limber-cream block leading-none">Know</span>
      </h2>

      <div class="lg:grid lg:grid-cols-2 lg:gap-12 items-start">

        <!-- Cards -->
        <div class="order-1">

      <div class="grid grid-cols-1 gap-4">

        <!-- Bookings + cancellations -->
        <div class="p-6 rounded-2xl border-2 bg-limber-brown border-limber-bright flex flex-col">
          <p class="font-headline text-sm text-limber-bright mb-3">Bookings &amp; cancellations</p>
          <p class="font-sans text-base text-limber-cream/80 leading-relaxed flex-1">Classes can be booked up to two weeks in advance. Spots fill fast so book early. On the waitlist? You can be added up to 45 minutes before class.<br /><br />Cancel up to 3 hours before class to avoid a late cancel fee. See our full policy in the T&Cs.</p>
        </div>

        <!-- New to Limber -->
        <div class="p-6 rounded-2xl border-2 bg-limber-brown border-limber-bright flex flex-col">
          <p class="font-headline text-sm text-limber-bright mb-3">New to Limber?</p>
          <p class="font-sans text-base text-limber-cream/80 leading-relaxed flex-1">First time? Start with The Limber Way: 21 days of unlimited classes, a personalised plan, and a real human in your corner. $99.</p>
          <a href="/pricing/trial" class="font-headline text-xs text-limber-bright hover:text-limber-vibe transition-colors mt-4">Learn more →</a>
        </div>

        <!-- Not sure what to book -->
        <div class="p-6 rounded-2xl border-2 bg-limber-brown border-limber-bright flex flex-col">
          <p class="font-headline text-sm text-limber-bright mb-3">Not sure what to book?</p>
          <p class="font-sans text-base text-limber-cream/80 leading-relaxed flex-1">Explore every class we offer — what it is, who it&apos;s for, and what to expect.</p>
          <a href="/classes/our-classes" class="font-headline text-xs text-limber-bright hover:text-limber-vibe transition-colors mt-4">Explore our classes →</a>
        </div>

        <!-- App buttons -->
        <div class="p-6 rounded-2xl border-2 bg-limber-brown border-limber-bright flex flex-col">
          <p class="font-headline text-sm text-limber-bright mb-3">Limber in your pocket</p>
          <p class="font-sans text-base text-limber-cream/80 leading-relaxed flex-1">Book classes, manage your membership, and check the timetable, all from your phone.</p>
          <div class="flex gap-6 mt-4">
            <a href="https://apps.apple.com/au/app/limber-co/id6744895425" target="_blank" rel="noopener noreferrer" class="font-headline text-xs text-limber-bright hover:text-limber-vibe transition-colors">App Store →</a>
            <a href="https://play.google.com/store/apps/details?id=com.ribbon.mobileApp&hl=en_AU" target="_blank" rel="noopener noreferrer" class="font-headline text-xs text-limber-bright hover:text-limber-vibe transition-colors">Google Play →</a>
          </div>
        </div>

        </div>{/* end cards */}
        </div>{/* end cards col */}

        <!-- Image — below cards on mobile, right col on desktop -->
        <div class="order-2 mt-8 lg:mt-0">
          <img
            src="/images/Limber_April26_170.jpg"
            alt="Limber studio"
            class="w-full h-64 lg:h-[520px] object-cover rounded-2xl border-2 border-limber-bright"
          />
        </div>

      </div>{/* end two-col grid */}

    </div>
  </section>

</BaseLayout>
