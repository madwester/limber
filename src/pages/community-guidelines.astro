---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaSlice from '../components/CtaSlice.astro';
import PricingHero from '../components/PricingHero.astro';
---

<BaseLayout
  title="Community Guidelines"
  description="The house rules at Limber — how we take care of each other and keep the space feeling good for everyone."
>

  <!-- ── HERO ── -->
  <PricingHero
    body="No one is in trouble. These are simply the things that help everyone feel good here, and help us protect the space we've all built together. We trust you and appreciate you more than you know."
    buttons={[{ label: 'Book a class', href: '/book-now' }]}
    image="/images/limber_in_studio_2025.webp"
    imageAlt="Limber studio"
    imagePosition="object-center"
  >
<h1 class="mb-0 leading-none">
      <span class="font-headline uppercase text-4xl md:text-5xl lg:text-6xl text-limber-vibe">our </span><span class="font-display italic font-medium text-5xl md:text-6xl lg:text-7xl text-limber-cream">House rules</span>
    </h1>
  </PricingHero>

  <!-- ── CONTENT ── -->
  <section class="bg-limber-green py-20 lg:py-28">
    <div class="px-4 sm:px-6 lg:px-8">
      <div id="guidelines-masonry" style="columns: 2; column-gap: 1rem;">
        {(() => { return [
          {
            title: 'Before you arrive',
            body: 'Book via the Limber co app up to 14 days in advance. Bring your own sweat towel, a water bottle, and grip socks for chair pilates (don\'t have any? we sell them in studio).',
          },
          {
            title: 'Arriving at the studio',
            body: 'Please wait until 15 minutes before your class begins. If there\'s a session running before yours, the cool-down is intentional. Aim to be on your mat 5–10 minutes early. Soft voices on the couches please.',
          },
          {
            title: 'On being on time',
            body: 'The occasional late arrival, we completely understand. Running late? Message us and we\'ll let you know if you can slip in. Arriving after class has begun may be treated as a no-show.',
          },
          {
            title: 'Phone-free space',
            body: 'Phone in your bag please. That hour is yours. Protect it. Accidental ring? Happens to us all. Emergency? Just let your teacher know before class.',
          },
          {
            title: 'Class cancellations',
            body: 'Our 3 hour cancellation policy exists so every member has a fair chance to get into class. Cancel via the app or website. Late cancels: session forfeited. No shows: session forfeited. Club members incur a $10 no-show or $5 late cancel fee. One fee waived per month. 12 hours notice for public holidays.',
          },
          {
            title: 'Waitlists',
            body: 'Jump on the waitlist if a class is full. You can be added up to 1 hour before class. The 3 hour cancellation policy applies to waitlisted spots too. Please cancel if you can no longer make it.',
          },
          {
            title: 'Tell your teacher',
            body: 'Any injury, niggle, or advice from a doctor? Tell your teacher before class begins. We\'ll note it and make sure you\'re offered appropriate options. We respect your privacy completely.',
          },
          {
            title: 'Pregnancy',
            body: 'You\'re welcome in our classes throughout an uncomplicated pregnancy. Our teachers understand pregnancy exercise guidelines and will always offer modifications. Concerns? Email hello@limberco.com.au.',
          },
          {
            title: 'Studio facilities',
            body: 'Secure storage for your belongings. Gender-neutral bathroom and change rooms. Drinking water provided.',
          },
          {
            title: 'Our community',
            body: 'Limber is an inclusive space for every body, regardless of age, size, ability, gender identity, sexuality, background or experience level. This is a space built on kindness. Let\'s keep it that way.',
          },
          {
            title: 'Age policy',
            body: 'We welcome members from age 14 without a guardian. Under 18s can only attend classes where the teacher holds a Working with Children Check. Babies and toddlers are welcome at Limber Mammas classes only.',
          },
          {
            title: 'Discounts',
            body: 'Full-time students and health care card holders: 10% off all packs and memberships. Seniors aged 60+ also receive 10% off. Email hello@limberco.com.au with proof to get set up.',
          },
          {
            title: 'Refunds',
            body: 'Refunds are not available for change of mind, unused sessions, or circumstances external to the business. Sessions cannot be transferred to another person.',
          },
          {
            title: 'Lost property',
            body: 'Socks. Scrunchies. Five water bottles we\'re considering naming. We clear lost property at the end of each month. Come rescue your things before they get rehomed.',
          },
          { type: 'link', href: '/classes/timetable', label: 'See our timetable →', sub: 'Pilates, yoga, barre and more. 7 days a week. Find a time that works for you and book your spot.' },
          { type: 'link', href: 'mailto:hello@limberco.com.au', label: 'Get in touch →', sub: 'Something unclear? A question about your booking or membership? We\'re always happy to help. hello@limberco.com.au' },
          ].map((item) => (
            <div class="break-inside-avoid mb-4">
              {(item as any).type === 'link'
                ? <a href={(item as any).href} class="bg-limber-vibe rounded-2xl p-6 border-2 border-limber-green flex flex-col justify-between hover:bg-limber-bright transition-colors block">
                    <p class="font-sans text-xs text-limber-green/70 mb-3">{(item as any).sub}</p>
                    <span class="font-headline uppercase text-sm text-limber-green">{(item as any).label}</span>
                  </a>
                : <div class="bg-limber-cream rounded-2xl p-6 border-2 border-limber-vibe">
                    <p class="font-headline uppercase text-sm text-limber-green mb-3">{(item as any).title}</p>
                    <p class="font-sans text-sm text-limber-brown/80 leading-relaxed">{(item as any).body}</p>
                  </div>
              }
            </div>
          ));
        })()}
      </div>
    </div>
  </section>

  <script>
    const m = document.getElementById('guidelines-masonry');
    function setCols() { if (m) m.style.columns = window.innerWidth >= 1024 ? '4' : window.innerWidth >= 640 ? '2' : '1'; }
    setCols(); window.addEventListener('resize', setCols);
  </script>

  <CtaSlice
    headingLine1="Ready to find"
    headingLine2="Your people?"
    body="Come say hi, book a class, or just have a nosy around. We'd love to have you."
    image="/images/Limber_April26_176.jpg"
    imageAlt="Limber community"
    sectionBg="bg-limber-cream-bg"
    showBorder={false}
    buttons={[
      { label: 'Book a Class', href: '/book-now' },
      { label: 'see our classes', href: '/classes/our-classes', variant: 'outline' },
    ]}
  />

</BaseLayout>
