---
import BaseLayout from '../layouts/BaseLayout.astro';
import FullBleedHero from '../components/FullBleedHero.astro';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Limber — questions, feedback, or just a hello. We'd love to hear from you."
  schema={{
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'Contact Limber',
    description: 'Get in touch with Limber studio.',
    url: 'https://limberco.com.au/contact',
    mainEntity: {
      '@type': 'LocalBusiness',
      name: 'Limber',
      email: 'hello@limberco.com.au',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Shop 17/282-298 Lawrence Hargrave Drive',
        addressLocality: 'Thirroul',
        addressRegion: 'NSW',
        postalCode: '2515',
        addressCountry: 'AU',
      },
    },
  }}
>

  <!-- ── HERO ── -->
  <div class="relative">
    <FullBleedHero
      bgColor="bg-limber-brown"
      borderColor="border-limber-bright"
      image="/images/Limber_April26_141.jpg"
      imageAlt="Limber studio"
      imageHeight="h-[480px]"
      contentPadding="px-4 sm:px-6 lg:px-8 py-10 lg:py-14"
    >
      <h1 class="mb-0">
        <span class="flex items-baseline gap-[0.2em] leading-none -mb-1">
          <span class="font-headline uppercase text-4xl md:text-5xl lg:text-6xl text-limber-bright">love</span>
          <span class="font-display italic font-medium text-5xl md:text-6xl lg:text-7xl text-limber-cream">to hear</span>
        </span>
        <span class="flex items-baseline gap-[0.2em] leading-none">
          <span class="font-display italic font-medium text-5xl md:text-6xl lg:text-7xl text-limber-cream">From</span>
          <span class="font-headline uppercase text-4xl md:text-5xl lg:text-6xl text-limber-bright">you</span>
        </span>
      </h1>
    </FullBleedHero>
    <!-- Sticker: 75px below bottom of image (image=480px), 200px from right, desktop only -->
    <div
      aria-hidden="true"
      class="absolute top-[555px] right-8 lg:right-[200px] w-36 h-36 -rotate-6 pointer-events-none z-10"
      style="background-color: var(--color-limber-bright); -webkit-mask-image: url('/images/stickers/sticker-black.svg'); mask-image: url('/images/stickers/sticker-black.svg'); -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat; -webkit-mask-size: contain; mask-size: contain; -webkit-mask-position: center; mask-position: center;"
    ></div>
  </div>

  <!-- ── BODY ── -->
  <section class="bg-limber-brown pb-16 lg:pb-24 border-b-2 border-limber-bright">
    <div class="px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24">

        <!-- Left: info -->
        <div>

          <div class="p-6 rounded-2xl bg-limber-cream border-2 border-limber-bright space-y-6">

            <div>
              <p class="font-headline text-xs text-limber-bright mb-2">Studio address</p>
              <p class="font-sans text-base text-limber-brown/80 leading-relaxed">Shop 17 / 282–298 Lawrence Hargrave Drive<br />Thirroul NSW</p>
              <p class="font-sans text-sm text-limber-brown/40 italic mt-1">Next to Coles. parking is a vibe.</p>
            </div>

            <div class="border-t border-limber-brown/10"></div>

            <div>
              <p class="font-headline text-xs text-limber-bright mb-2">Email</p>
              <a href="mailto:hello@limberco.com.au" class="font-sans text-base text-limber-brown/80 hover:text-limber-bright transition-colors">
                hello@limberco.com.au
              </a>
            </div>

            <div class="border-t border-limber-brown/10"></div>

            <div>
              <p class="font-headline text-xs text-limber-bright mb-2">Studio hours</p>
              <table class="font-sans text-base text-limber-brown/80 w-full">
                <tbody>
                  <tr><td class="pr-6 py-1">Monday – Thursday</td><td>6:00am – 8:30pm</td></tr>
                  <tr><td class="pr-6 py-1">Friday</td><td>6:00am – 6:30pm</td></tr>
                  <tr><td class="pr-6 py-1">Saturday</td><td>6:30am – 9:30am</td></tr>
                  <tr><td class="pr-6 py-1">Sunday</td><td>8:30am – 7:00pm</td></tr>
                </tbody>
              </table>
            </div>

          </div>

        </div>

        <!-- Right: form -->
        <div class="sticky top-24 lg:top-28 self-start">

          <form id="contact-form" action="https://formspree.io/f/mbdeepav" method="POST" novalidate class="space-y-5">
            <input type="text" name="_gotcha" class="hidden" aria-hidden="true" tabindex="-1" />
            <input type="hidden" name="_subject" value="New enquiry — Limber" />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="firstName" class="block font-headline text-xs text-limber-cream mb-2">
                  first name <span class="text-limber-bright" aria-hidden="true">*</span>
                </label>
                <input
                  type="text" id="firstName" name="firstName" required
                  autocomplete="given-name"
                  placeholder="Jane"
                  class="w-full px-4 py-3 rounded-xl border-2 border-limber-bright/30 bg-limber-cream text-limber-brown placeholder:text-limber-brown/30 focus:outline-none focus:border-limber-bright transition font-sans text-base"
                />
              </div>
              <div>
                <label for="lastName" class="block font-headline text-xs text-limber-cream mb-2">
                  last name <span class="text-limber-bright" aria-hidden="true">*</span>
                </label>
                <input
                  type="text" id="lastName" name="lastName" required
                  autocomplete="family-name"
                  placeholder="Smith"
                  class="w-full px-4 py-3 rounded-xl border-2 border-limber-bright/30 bg-limber-cream text-limber-brown placeholder:text-limber-brown/30 focus:outline-none focus:border-limber-bright transition font-sans text-base"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="email" class="block font-headline text-xs text-limber-cream mb-2">
                  email <span class="text-limber-bright" aria-hidden="true">*</span>
                </label>
                <input
                  type="email" id="email" name="email" required
                  autocomplete="email"
                  placeholder="jane@example.com"
                  class="w-full px-4 py-3 rounded-xl border-2 border-limber-bright/30 bg-limber-cream text-limber-brown placeholder:text-limber-brown/30 focus:outline-none focus:border-limber-bright transition font-sans text-base"
                />
              </div>
              <div>
                <label for="phoneNumber" class="block font-headline text-xs text-limber-cream mb-2">
                  phone <span class="text-limber-bright" aria-hidden="true">*</span>
                </label>
                <input
                  type="tel" id="phoneNumber" name="phoneNumber" required
                  autocomplete="tel"
                  placeholder="04XX XXX XXX"
                  class="w-full px-4 py-3 rounded-xl border-2 border-limber-bright/30 bg-limber-cream text-limber-brown placeholder:text-limber-brown/30 focus:outline-none focus:border-limber-bright transition font-sans text-base"
                />
              </div>
            </div>

            <div>
              <label for="enquiry" class="block font-headline text-xs text-limber-cream mb-2">
                what's your enquiry? <span class="text-limber-bright" aria-hidden="true">*</span>
              </label>
              <textarea
                id="enquiry" name="enquiry" required rows="5"
                placeholder="How can we help?"
                class="w-full px-4 py-3 rounded-xl border-2 border-limber-bright/30 bg-limber-cream text-limber-brown placeholder:text-limber-brown/30 focus:outline-none focus:border-limber-bright transition resize-none font-sans text-base"
              ></textarea>
            </div>

            <div id="form-error" class="hidden px-4 py-3 rounded-xl bg-red-50 border border-red-200">
              <p class="font-sans text-sm text-red-700">Something went wrong. Please try again or email <a href="mailto:hello@limberco.com.au" class="underline">hello@limberco.com.au</a> directly.</p>
            </div>

            <button
              type="submit" id="submit-btn"
              class="inline-flex items-center gap-2 px-8 py-4 font-headline text-sm text-limber-brown bg-limber-bright hover:bg-limber-vibe border-2 border-limber-bright rounded-full transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
            >
              <span id="btn-label">send message</span>
            </button>

          </form>

          <!-- Success state -->
          <div id="contact-success" class="hidden p-10 rounded-2xl bg-limber-cream border-2 border-limber-bright text-center">
            <span class="font-display italic font-medium text-4xl text-limber-bright block leading-none mb-4">Thank you</span>
            <p class="font-sans text-base text-limber-brown/80 leading-relaxed">We'll be in touch within 1–2 business days.</p>
          </div>

        </div>

      </div>
    </div>
  </section>

</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const success = document.getElementById('contact-success');
  const errorBox = document.getElementById('form-error');
  const btn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const btnLabel = document.getElementById('btn-label');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!btn || !btnLabel) return;
    btn.disabled = true;
    btnLabel.textContent = 'sending…';
    errorBox?.classList.add('hidden');

    const res = await fetch((form as HTMLFormElement).action, {
      method: 'POST',
      body: new FormData(form),
      headers: { Accept: 'application/json' },
    });

    if (res.ok) {
      form.classList.add('hidden');
      success?.classList.remove('hidden');
    } else {
      btn.disabled = false;
      btnLabel.textContent = 'send message';
      errorBox?.classList.remove('hidden');
    }
  });
</script>
