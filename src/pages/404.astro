---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — Page Not Found"
  description="This page doesn't exist."
  noindex={true}
>

  <section class="bg-limber-green min-h-[80vh] flex flex-col items-center justify-center text-center px-8 py-24 relative border-b-2 border-limber-vibe">

    <div
      aria-hidden="true"
      class="absolute top-28 right-12 w-32 h-32 rotate-[15deg] pointer-events-none hidden lg:block"
      style="background-color: var(--color-limber-bright); -webkit-mask-image: url('/images/stickers/sticker-1.svg'); mask-image: url('/images/stickers/sticker-1.svg'); -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat; -webkit-mask-size: contain; mask-size: contain; -webkit-mask-position: center; mask-position: center;"
    ></div>
    <div
      aria-hidden="true"
      class="absolute bottom-12 left-10 w-24 h-24 -rotate-[10deg] pointer-events-none hidden lg:block"
      style="background-color: var(--color-limber-vibe); -webkit-mask-image: url('/images/stickers/flower.svg'); mask-image: url('/images/stickers/flower.svg'); -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat; -webkit-mask-size: contain; mask-size: contain; -webkit-mask-position: center; mask-position: center;"
    ></div>

    <div class="relative z-10 max-w-lg mx-auto">

      <h1 class="mb-6">
        <span class="font-headline uppercase text-8xl md:text-9xl text-limber-cream block leading-none -mb-2">404</span>
        <span class="font-display italic font-medium text-4xl md:text-5xl lg:text-6xl text-limber-cream block leading-none">Page not&nbsp;found</span>
      </h1>

      <p class="font-sans text-limber-cream/70 leading-relaxed max-w-xs mx-auto mb-10">
        This one doesn't exist. Let's get you back on track.
      </p>

      <div class="flex flex-wrap gap-4 justify-center">
        <a
          href="/"
          class="inline-flex items-center px-8 py-4 font-headline text-sm text-limber-green bg-limber-vibe hover:bg-limber-bright border-2 border-limber-vibe rounded-full transition-colors"
        >
          <span class="relative top-[2px]">Take me home</span>
        </a>
        <a
          href="/classes/our-classes"
          class="inline-flex items-center px-8 py-4 font-headline text-sm text-limber-cream border-2 border-limber-cream/30 hover:border-limber-cream rounded-full transition-colors"
        >
          <span class="relative top-[2px]">See our classes</span>
        </a>
      </div>

    </div>

  </section>

</BaseLayout>
