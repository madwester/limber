---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — Lost?"
  description="Looks like this page took an unplanned rest day."
  noindex={true}
>

  <section class="bg-limber-green min-h-[80vh] flex flex-col items-center justify-center text-center px-8 py-24 relative overflow-hidden">

    <!-- Background stickers -->
    <img
      src="/images/stickers/sticker-1.svg"
      alt=""
      aria-hidden="true"
      class="absolute top-10 left-8 w-24 h-24 -rotate-12 opacity-40 pointer-events-none"
    />
    <img
      src="/images/stickers/sticker-2.svg"
      alt=""
      aria-hidden="true"
      class="absolute bottom-16 right-10 w-32 h-32 rotate-6 opacity-40 pointer-events-none"
    />
    <img
      src="/images/stickers/sticker-3.svg"
      alt=""
      aria-hidden="true"
      class="absolute top-16 right-16 w-20 h-20 rotate-12 opacity-30 pointer-events-none hidden lg:block"
    />
    <img
      src="/images/stickers/grow-sticker-1.svg"
      alt=""
      aria-hidden="true"
      class="absolute bottom-10 left-16 w-28 h-28 -rotate-6 opacity-30 pointer-events-none hidden lg:block"
    />

    <!-- Content -->
    <div class="relative z-10">

      <p class="font-headline text-xs text-limber-vibe mb-6 tracking-widest">Error 404</p>

      <h1 class="mb-6">
        <span class="font-headline uppercase text-6xl md:text-8xl lg:text-9xl text-limber-cream block leading-none mb-2">oops</span>
        <span class="font-display italic font-medium text-5xl md:text-6xl lg:text-7xl text-limber-vibe block leading-none">you lost the plot</span>
      </h1>

      <p class="font-sans text-limber-cream/70 text-lg leading-relaxed max-w-md mx-auto mb-4">
        This page took an unplanned rest day.
      </p>
      <p class="font-display italic text-xl text-limber-vibe mb-10">
        Honestly? Same.
      </p>

      <div class="flex flex-wrap gap-4 justify-center">
        <a
          href="/"
          class="inline-flex items-center px-8 py-4 font-headline text-sm text-limber-green bg-limber-vibe hover:bg-limber-bright border-2 border-limber-vibe rounded-full transition-colors"
        >
          Take me home
        </a>
        <a
          href="/classes/our-classes"
          class="inline-flex items-center px-8 py-4 font-headline text-sm text-limber-cream hover:bg-limber-brown border-2 border-limber-cream/30 hover:border-limber-brown rounded-full transition-colors"
        >
          See our classes
        </a>
      </div>

    </div>

  </section>

</BaseLayout>
