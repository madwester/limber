---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaSlice from '../../components/CtaSlice.astro';
import PricingHero from '../../components/PricingHero.astro';

const memberships = [
  {
    id: 'club',
    name: 'Limber Club',
    freq: 'The whole studio is yours',
    price: '$60',
    period: 'per week',
    note: '$8.50 a day. Unlimited classes. We\'ll let you do the maths.',
    description: 'For the Limber devotee who wants to show up as much as they want, whenever they want.',
    popular: true,
    details: [
      'Unlimited classes',
      'Up to 2 classes per day (1 pilates/barre + 1 yoga)',
      'Weekends: 1 class per day',
      'Auto-renewed fortnightly',
      '12 week minimum commitment',
      '20% off your first Aura Sweat session',
    ],
    cta: 'Join unlimited',
    href: 'https://momence.com/m/405108',
    bg: 'bg-limber-brown',
    textColor: 'text-limber-cream',
    subColor: 'text-limber-bright/80',
    descColor: 'text-limber-cream/90',
    ctaClass: 'text-limber-brown bg-limber-bright hover:bg-limber-vibe border-limber-bright',
    dividerColor: 'border-limber-cream/20',
  },
  {
    id: 'compact',
    name: 'Limber Compact',
    freq: '2 classes per week + 1 lunch/Limber up',
    price: '$48',
    period: 'per week',
    note: '$16 per class. A steal.',
    description: 'For the regular mover who likes a little variety.',
    details: [
      '2 group classes per week',
      'Plus 1 lunch express or Limber up class',
      'Credits don\'t roll over',
      'Auto-renewed weekly',
      '12 week minimum commitment',
    ],
    cta: 'Join compact',
    href: 'https://momence.com/m/405112',
    bg: 'bg-limber-cream',
    textColor: 'text-limber-green',
    subColor: 'text-limber-brown/70',
    descColor: 'text-limber-brown/80',
    ctaClass: 'text-limber-brown bg-limber-bright hover:bg-limber-vibe border-limber-bright',
  },
  {
    id: 'chill',
    name: 'Limber Chill',
    freq: '1 class per week',
    price: '$25',
    period: 'per week',
    note: 'That\'s one marg. We know which one your body will thank you for.',
    description: 'For when you want to dip your toes in and find your rhythm.',
    details: [
      '1 class per week',
      'Credits don\'t roll over',
      'Auto-renewed weekly',
      '12 week minimum commitment',
    ],
    cta: 'Join Limber chill',
    href: 'https://momence.com/m/405116',
    bg: 'bg-limber-cream',
    textColor: 'text-limber-green',
    subColor: 'text-limber-brown/70',
    descColor: 'text-limber-brown/80',
    ctaClass: 'text-limber-brown bg-limber-bright hover:bg-limber-vibe border-limber-bright',
  },
  {
    id: 'combo',
    name: 'Limber Combo',
    freq: 'Semi-private + group + stretch weekly',
    price: '$60',
    period: 'per week',
    note: 'One drop in class costs the same. Have we gone mad?!',
    description: 'For the person who wants a little more personalised attention alongside their group classes.',
    details: [
      '1-on-1 needed first',
      '1 semi-private session per week',
      '1 group class per week',
      '1 lunch express or Limber up class per week',
      'Credits don\'t roll over',
      'Auto-renewed fortnightly',
      '12 week minimum commitment',
    ],
    cta: 'Join combo',
    href: 'https://momence.com/m/405114',
    bg: 'bg-limber-cream',
    textColor: 'text-limber-green',
    subColor: 'text-limber-brown/70',
    descColor: 'text-limber-brown/80',
    ctaClass: 'text-limber-brown bg-limber-bright hover:bg-limber-vibe border-limber-bright',
  },
];

const perks = [
  { title: 'Welcome bag', body: 'Tea, incense, a Limber sticker, a goal tracker card so you can keep growing, and a few other good things to get you started.' },
  { title: 'Bring a friend', body: 'One free guest pass per month. Share the love.' },
  { title: 'Community events', body: 'Book club, hiking club, craft club and more. All free. All yours.' },
  { title: 'Workshop discounts', body: 'Members get discounted access to special events and workshops.' },
  { title: 'Aura sweat', body: 'Unlimited members get 20% off your first session. Code sent via email after joining.' },
  { title: 'Limber app access', body: 'Timetable, bookings, member perks, all in your pocket.' },
  { title: 'Limber community WhatsApp', body: 'The moment you join you\'re added to our member community. Real conversations, real people, zero spam.' },
  { title: 'We notice when you\'re not here', body: 'If we haven\'t seen you in a while, we\'ll reach out. Not to guilt trip, just because we genuinely care.' },
];
---

<BaseLayout
  title="Memberships"
  description="Find your Limber membership — from 1 class a week to unlimited. Real support, real community, no pushy sales."
>

  <!-- ── HERO ── -->
  <PricingHero
    body="However you like to move, there's a membership that fits. We've designed our options to be flexible, accessible and easy to change as your life does. No long term lock-ins or guesswork. And if you're ever unsure where to start, we'll help you figure it out. We're here to help you find your groove."
    buttons={[{ label: 'Find yours', href: '#memberships' }, { label: 'New here? Start our intro', href: '/pricing/trial', variant: 'outline' }]}
    image="/images/turn-around.jpg"
    imageAlt="Limber studio"
    imagePosition="object-center"
  >
    <h1 class="mb-0">
      <span class="flex items-baseline gap-[0.35em] leading-none -mb-1">
        <span class="font-display italic font-medium text-5xl md:text-6xl lg:text-7xl text-limber-cream">Make</span>
        <span class="font-headline uppercase text-5xl md:text-6xl lg:text-7xl text-limber-vibe">LIMBER</span>
      </span>
      <span class="font-display italic font-medium text-5xl md:text-6xl lg:text-7xl text-limber-cream block leading-none">Your thing</span>
    </h1>
  </PricingHero>

  <!-- ── WHAT EVERY MEMBER GETS ── -->
  <section class="bg-limber-green py-20 lg:py-28 border-b-2 border-limber-vibe">
    <div class="px-4 sm:px-6 lg:px-8">

      <h2 class="mb-4">
        <span class="font-headline uppercase text-4xl md:text-5xl lg:text-6xl text-limber-vibe block leading-none -mb-1">what every</span>
        <span class="font-display italic font-medium text-5xl md:text-6xl lg:text-7xl text-limber-cream block leading-none">member gets</span>
      </h2>
      <p class="font-sans text-limber-cream/70 leading-relaxed mb-14 max-w-lg">
        Because being part of Limber is more than just classes.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {perks.map((perk) => (
          <div class="bg-limber-cream rounded-2xl border-2 border-limber-green p-6">
            <p class="font-headline text-sm text-limber-green mb-2">{perk.title}</p>
            <p class="font-sans text-sm text-limber-brown/70 leading-relaxed">{perk.body}</p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ── MEMBERSHIPS ── -->
  <section id="memberships" class="bg-limber-green py-20 lg:py-28 border-b-2 border-limber-vibe scroll-mt-[120px] lg:scroll-mt-[140px]">
    <div class="px-4 sm:px-6 lg:px-8">

      <h2 class="mb-14">
        <span class="block leading-none -mb-1">
          <span class="font-headline uppercase text-4xl md:text-5xl lg:text-6xl text-limber-vibe">find </span><span class="font-display italic font-medium text-5xl md:text-6xl lg:text-7xl text-limber-cream">Your</span>
        </span>
        <span class="font-display italic font-medium text-5xl md:text-6xl lg:text-7xl text-limber-cream block leading-none">membership</span>
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {memberships.map((m) => (
          <div class:list={['rounded-2xl border-2 p-7 flex flex-col relative', m.bg, (m as any).popular ? 'border-limber-bright' : 'border-limber-brown']}>
            {(m as any).popular && (
              <span class="absolute -top-3 left-1/2 -translate-x-1/2 font-headline text-xs text-limber-brown bg-limber-bright px-3 py-1 rounded-full whitespace-nowrap">Most popular</span>
            )}
            <p class:list={['font-headline text-2xl leading-none mb-1 lg:min-h-[3.5rem]', m.textColor]}>{m.name}</p>
            <p class:list={['font-sans text-base lg:min-h-[5rem] mb-4', m.subColor]}>{m.freq}</p>
            <div class:list={['border-t mb-6', (m as any).dividerColor || 'border-limber-green/10']}></div>
            <div class="flex items-baseline gap-1 mb-1">
              <span class:list={['font-sans text-5xl', m.textColor]}>{m.price.slice(0, 1)}</span>
              <span class:list={['font-sans text-5xl font-bold', m.textColor]}>{m.price.slice(1)}</span>
              <span class:list={['font-sans text-xs', m.subColor]}>{m.period}</span>
            </div>
            <p class:list={['font-sans text-sm leading-snug lg:min-h-[3.5rem] mb-5', m.subColor]}>{m.note}</p>
            <div class:list={['border-t mb-5', (m as any).dividerColor || 'border-limber-green/10']}></div>
            <p class:list={['font-sans text-sm leading-relaxed lg:min-h-[4rem] mb-4', m.descColor]}>{m.description}</p>
            <ul class="space-y-2 mb-8 flex-1">
              {m.details.map((d) => (
                <li class:list={['flex items-start gap-2 font-sans text-xs', m.subColor]}>
                  <span class="w-1 h-1 rounded-full bg-current flex-shrink-0 mt-1.5"></span>
                  {d}
                </li>
              ))}
            </ul>
            <a
              href={(m as any).href || '/book-now'}
              target="_blank"
              rel="noopener noreferrer"
              class:list={[
                'block text-center px-5 py-3 font-headline text-xs border-2 rounded-full transition-colors',
                m.ctaClass,
              ]}
            >
              <span class="relative top-[2px]">{m.cta}</span>
            </a>
          </div>
        ))}
      </div>

      <p class="mt-8 font-sans text-xs text-limber-cream/50 max-w-2xl">
        All memberships are billed via direct debit and auto-renew as noted above. A 12 week minimum commitment applies to all memberships. see our <a href="/terms-and-conditions" class="underline hover:text-limber-cream/80 transition-colors">terms & conditions</a> for full details.
      </p>

    </div>
  </section>

  <!-- ── HUMANS OF LIMBER ── -->
  <section class="bg-limber-green py-20 lg:py-28 border-b-2 border-limber-vibe">
    <div class="px-4 sm:px-6 lg:px-8 mb-12">
      <h2 class="mb-4 stacked-heading">
        <span class="font-display italic font-medium text-5xl md:text-6xl lg:text-7xl text-limber-cream block leading-none">Meet the</span>
        <span class="font-headline uppercase text-3xl md:text-5xl lg:text-6xl text-limber-vibe block leading-none">humans of limber</span>
      </h2>
      <p class="font-sans text-limber-cream/70 leading-relaxed">Real people. Real stories.</p>
    </div>

    <!-- Filmstrip -->
    <div class="overflow-hidden">
    <div class="flex items-end gap-2 px-4 sm:px-6 lg:px-8 overflow-x-auto lg:overflow-visible py-6" style="scrollbar-width: none;">
      {[
        { src: '/images/members/Donna.jpg',      name: 'Donna',  h: 420, rotate: 'rotate-2',   z: 'z-10', bg: false, hasStory: true  },
        { src: '/images/members/Athena.jpg',     name: 'Athena', h: 460, rotate: '-rotate-3',  z: 'z-20', bg: false, hasStory: true  },
        { src: '/images/members/Elise.jpg',      name: 'Elise',  h: 400, rotate: 'rotate-1',   z: 'z-10', bg: false, hasStory: true  },
        { src: '/images/background/2.jpg',       name: '',       h: 435, rotate: '-rotate-2',  z: 'z-10', bg: true,  hasStory: false },
        { src: '/images/members/Selen.jpg',      name: 'Selen',  h: 440, rotate: '-rotate-2',  z: 'z-30', bg: false, hasStory: true  },
        { src: '/images/members/Chan.jpg',       name: 'Chan',   h: 410, rotate: 'rotate-3',   z: 'z-20', bg: false, hasStory: false },
        { src: '/images/members/Laura.jpg',      name: 'Laura',  h: 450, rotate: '-rotate-1',  z: 'z-10', bg: false, hasStory: false },
        { src: '/images/members/Matt.jpg',       name: 'Matt',   h: 395, rotate: 'rotate-2',   z: 'z-20', bg: false, hasStory: false },
        { src: '/images/background/19.jpg',      name: '',       h: 420, rotate: '-rotate-2',  z: 'z-20', bg: true,  hasStory: false },
        { src: '/images/members/Drew.jpg',       name: 'Drew',   h: 430, rotate: '-rotate-2',  z: 'z-10', bg: false, hasStory: false },
        { src: '/images/members/Helen.jpg',      name: 'Helen',  h: 415, rotate: 'rotate-1',   z: 'z-30', bg: false, hasStory: false },
      ].map((m) => (
        <button
          class:list={[
            `${m.bg ? 'hidden lg:block lg:flex-1' : 'flex-shrink-0 w-[60vw] sm:w-[40vw] lg:flex-1 lg:w-auto'} member-card rounded-2xl border-2 border-limber-vibe overflow-hidden shadow-xl ${m.hasStory ? 'cursor-pointer group' : ''} transition-transform duration-150 ${m.hasStory ? 'hover:scale-105 hover:border-limber-cream' : ''} relative`,
            m.rotate, m.z,
          ]}
          style={`height: ${m.h}px;`}
          data-name={m.name}
          disabled={!(m as any).hasStory}
        >
          <img src={m.src} alt={m.name} class="w-full h-full object-cover object-top" loading="lazy" style="will-change: transform;" />
          {m.hasStory && <p class="absolute inset-0 flex items-center justify-center font-headline uppercase text-sm text-limber-cream opacity-0 group-hover:opacity-100 transition-opacity duration-150">{m.name}</p>}
        </button>
      ))}
    </div>
    </div>
  </section>

  <!-- ── MEMBER MODAL ── -->
  <div id="member-modal" class="fixed inset-0 z-[400] hidden">
    <div class="absolute inset-0 bg-limber-brown/80" id="member-modal-backdrop"></div>
    <div class="relative h-full flex items-center justify-center p-4 lg:p-8">
      <div class="bg-limber-green rounded-2xl border-2 border-limber-vibe w-full max-w-3xl max-h-[90vh] overflow-y-auto">
        <div class="flex justify-end p-6 pb-0">
          <button id="member-modal-close" class="font-headline text-xs text-limber-vibe hover:text-limber-cream transition-colors uppercase tracking-widest cursor-pointer">Close ✕</button>
        </div>
        <div class="lg:grid lg:grid-cols-2 gap-8 p-6 lg:p-10 items-start">
          <div id="member-photo-wrap" class="mb-8 lg:mb-0">
            <img id="member-photo" src="" alt="" class="w-full object-cover object-top rounded-xl border-2 border-limber-vibe" style="height: calc(var(--spacing) * 88);" />
          </div>
          <div>
            <h2 id="member-name" class="font-headline uppercase text-5xl text-limber-vibe block leading-none -mb-1"></h2>
            <div id="member-qa" class="space-y-6 mt-8"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script define:vars={{ membersData: [
    { name: 'Donna', qa: [
      { q: 'Before you found something that worked — what got in the way?', a: 'Stress and expectation got in the way. I put so much focus on end results instead of finding a sustainable regime. There is empowerment in letting go and accepting.' },
      { q: 'What did movement feel like back then?', a: "It all worked ok, till it didn't. The classic case of that children's book 'Who Sank the Boat' — I used to end up injured a lot because I did not pay attention to the warnings." },
      { q: 'What does home feel like in your body?', a: "I'm over 60 and so happy to still be doing regular Pilates and strength training. A few years ago I had a life-changing health scare. Accepting and celebrating what I can do instead of focussing on what I can no longer achieve has been a game changer." },
    ]},
    { name: 'Athena', qa: [
      { q: 'Before you found something that worked — what got in the way?', a: "I used the unrelenting busyness of motherhood as an excuse. Movement felt like a luxury, or a chore on a to-do list I didn't have the capacity to action." },
      { q: 'What does home feel like in your body?', a: "Being at home in my body means feeling strong and capable whilst still feeling safe and nurtured. Motherhood and hormonal shifts have brought many changes — but I've just been feeling very thankful for being in my healthy body right now." },
      { q: 'Where do you find joy in movement now?', a: "These days I find joy in ocean swimming, surfing, riding my bike, and in the chair, strength and cardio dance classes at Limber." },
    ]},
    { name: 'Elise', qa: [
      { q: 'I stopped trying to be good at movement and started…', a: 'Seeing it as a form of devotion to myself. A way for my mind and body to harmonise as one. I leave a class with a sense of accomplishment, and an even greater sense of appreciation for myself.' },
      { q: 'What does a genuinely good day look like for you?', a: 'A genuinely good day feels like being able to hold a steady undercurrent of grace in all that I encounter. I add kindling to keep it alive — often in the form of movement, presence, connection, and gratitude.' },
    ]},
    { name: 'Selen', qa: [
      { q: 'Before you found something that worked — what got in the way?', a: "Movement felt very all-or-nothing. I was always chasing routines that looked 'perfect' instead of listening to what my body actually needed. Through pregnancy and postpartum, movement became more about feeling strong, grounded, and like myself again." },
      { q: 'What does home feel like in your body?', a: "Home in my body feels calm, capable, and connected. It's being able to move without punishing myself or feeling like I have to earn rest. I appreciate my body so much more now for what it can do, not just how it looks." },
      { q: 'Where do you find joy in movement now?', a: 'The best moments are when I leave feeling lighter mentally, stronger physically, and more present in myself. Sometimes it\'s as simple as finishing a class feeling energised instead of depleted.' },
    ]},
    { name: 'Chan', qa: [] },
    { name: 'Laura', qa: [{ q: '', a: 'Story coming soon.' }] },
    { name: 'Matt', qa: [{ q: '', a: 'Story coming soon.' }] },
    { name: 'Drew', qa: [{ q: '', a: 'Story coming soon.' }] },
    { name: 'Helen', qa: [{ q: '', a: 'Story coming soon.' }] },
  ]}}>
    const modal = document.getElementById('member-modal');
    const backdrop = document.getElementById('member-modal-backdrop');
    const closeBtn = document.getElementById('member-modal-close');
    const photo = document.getElementById('member-photo');
    const photoWrap = document.getElementById('member-photo-wrap');
    const nameEl = document.getElementById('member-name');
    const qaEl = document.getElementById('member-qa');

    document.querySelectorAll('.member-card').forEach((btn) => {
      btn.addEventListener('click', () => {
        const name = btn.getAttribute('data-name');
        const member = membersData.find((m) => m.name === name);
        if (!member) return;
        photo.src = `/images/members/${name}.jpg`;
        photo.alt = name;
        nameEl.textContent = name;
        qaEl.innerHTML = member.qa.length
          ? member.qa.map((item) => `
              <div>
                ${item.q ? `<p class="font-headline text-xs uppercase tracking-widest text-limber-vibe mb-2">${item.q}</p>` : ''}
                <p class="font-sans leading-relaxed text-limber-cream/80">${item.a}</p>
              </div>`).join('')
          : '<p class="font-sans text-limber-cream/60">Story coming soon.</p>';
        modal.classList.remove('hidden');
        const scrollY = window.scrollY;
        document.body.style.position = 'fixed';
        document.body.style.top = `-${scrollY}px`;
        document.body.style.width = '100%';
        document.body.dataset.scrollY = String(scrollY);
      });
    });

    function close() {
      modal.classList.add('hidden');
      const scrollY = parseInt(document.body.dataset.scrollY || '0', 10);
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.width = '';
      window.scrollTo(0, scrollY);
    }
    closeBtn.addEventListener('click', close);
    backdrop.addEventListener('click', close);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
  </script>

  <!-- ── COMMUNITY ── -->
  <CtaSlice
    headingLine1="more than"
    headingLine2="a membership"
    body="When you join Limber, you're not just booking classes. You're joining a community that shows up for each other, inside the studio and beyond it."
    image="/images/Limber_April26_169.jpg"
    imageAlt="Limber community"
    sectionBg="bg-limber-cream"
    accentColor="text-limber-bright"
    primaryBtn="text-limber-brown bg-limber-bright hover:bg-limber-vibe border-limber-bright"
    showBorder={false}
    buttons={[
      { label: 'Our community →', href: '/about/our-community' },
    ]}
  />

</BaseLayout>
