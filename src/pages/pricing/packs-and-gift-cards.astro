---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaSlice from '../../components/CtaSlice.astro';
import PricingHero from '../../components/PricingHero.astro';

const groupPacks = [
  {
    name: '5 Class Pack',
    price: '$145',
    note: 'valid for 3 months from date of purchase',
    perClass: '$29 per class.',
    bg: 'bg-limber-cream-bg',
    textColor: 'text-limber-green',
    subColor: 'text-limber-brown/70',
  },
  {
    name: '10 Class Pack',
    price: '$270',
    note: 'valid for 6 months from date of purchase',
    perClass: '$27 per class. that\'s a very good deal and we know it.',
    bg: 'bg-limber-vibe',
    textColor: 'text-limber-green',
    subColor: 'text-limber-green/80',
  },
];

const groupPackTerms = [
  'valid for all group classes',
  'single client use only',
  'non-refundable and non-transferable',
  'extensions available for injury or illness with medical certificate only',
];

const lunchPackTerms = [
  'valid for lunch express classes only',
  'single client use only',
  'non-refundable and non-transferable',
];

const semiPackTerms = [
  'valid for semi-private sessions only',
  'single client use only',
  'non-refundable and non-transferable',
  'a 1:1 intro session required before your first semi-private',
];

const faqs = [
  {
    q: 'Can I share my pack with a friend?',
    a: 'Packs are single client use only. They\'re linked to your account and can\'t be transferred.',
  },
  {
    q: 'What if I get injured?',
    a: 'We can extend your pack with a medical certificate from a doctor or physio. Just get in touch.',
  },
  {
    q: 'Can I use my pack for any class?',
    a: 'Group packs are valid for all group classes. Lunch express packs are valid for lunch express classes only. Semi-private packs are for semi-private sessions only.',
  },
  {
    q: 'Do packs auto-renew?',
    a: 'No, packs are a one-off purchase. You\'ll be prompted to repurchase when yours runs low.',
  },
];
---

<BaseLayout
  title="Packs + Gift Cards"
  description="Buy class packs or gift cards at Limber. Group class packs, Lunch Express packs, semi-private packs, and gift cards in any amount."
  schema={{
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Limber Class Packs',
    description: 'Class packs and gift cards at Limber movement studio in Thirroul, NSW.',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        item: {
          '@type': 'Offer',
          name: '5 Class Pack',
          description: 'Valid for all group classes. Valid for 3 months from date of purchase.',
          price: '145',
          priceCurrency: 'AUD',
          seller: { '@type': 'Organization', name: 'Limber', url: 'https://limberco.com.au' },
        },
      },
      {
        '@type': 'ListItem',
        position: 2,
        item: {
          '@type': 'Offer',
          name: '10 Class Pack',
          description: 'Valid for all group classes. Valid for 6 months from date of purchase.',
          price: '270',
          priceCurrency: 'AUD',
          seller: { '@type': 'Organization', name: 'Limber', url: 'https://limberco.com.au' },
        },
      },
      {
        '@type': 'ListItem',
        position: 3,
        item: {
          '@type': 'Offer',
          name: 'Lunch Express 10 Class Pack',
          description: 'Valid for lunch express classes only. Valid for 6 months from date of purchase.',
          price: '220',
          priceCurrency: 'AUD',
          seller: { '@type': 'Organization', name: 'Limber', url: 'https://limberco.com.au' },
        },
      },
      {
        '@type': 'ListItem',
        position: 4,
        item: {
          '@type': 'Offer',
          name: 'Semi-Private 5 Pack',
          description: 'Valid for semi-private sessions only. Valid for 3 months from date of purchase.',
          price: '250',
          priceCurrency: 'AUD',
          seller: { '@type': 'Organization', name: 'Limber', url: 'https://limberco.com.au' },
        },
      },
    ],
  }}
>

  <!-- ── HERO ── -->
  <PricingHero
    body="Perfect if you like flexibility or travel a lot. Pick your pack, book when it suits you, and move at your own pace."
    buttons={[]}
    image="/images/limber_studio_3_girls.jpg"
    imageAlt="Limber studio"
    imagePosition="object-center"
    imageSticker="/images/stickers/sticker-1.svg"
    imageStickerColor="var(--color-limber-bright)"
  >
    <h1 class="mb-0">
      <span class="flex items-baseline gap-[0.2em] leading-none -mb-1">
        <span class="font-headline uppercase text-5xl md:text-6xl lg:text-7xl text-limber-vibe">PACKS</span>
        <span class="font-display italic font-medium text-5xl md:text-6xl lg:text-7xl text-limber-cream">&amp;</span>
      </span>
      <span class="flex items-baseline gap-[0.2em] leading-none">
        <span class="font-headline uppercase text-5xl md:text-6xl lg:text-7xl text-limber-vibe">GIFT</span>
        <span class="font-display italic font-medium text-5xl md:text-6xl lg:text-7xl text-limber-cream">Cards</span>
      </span>
    </h1>
  </PricingHero>

  <!-- ── PACKS ── -->
  <section id="packs" class="bg-limber-green py-20 lg:py-28 border-b-2 border-limber-vibe">
    <div class="px-4 sm:px-6 lg:px-8">

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">

        <!-- 5 Class Pack — cream -->
        <div class="rounded-2xl border-2 border-limber-brown p-7 bg-limber-cream flex flex-col" id="5-class-pack">
          <p class="font-display italic text-lg text-limber-brown/40 mb-3">Group classes</p>
          <p class="font-headline text-2xl text-limber-green mb-4">5 Class Pack</p>
          <div class="border-t border-limber-brown/10 mb-5"></div>
          <p class="mb-1"><span class="font-sans text-5xl text-limber-green">$</span><span class="font-sans text-5xl font-bold text-limber-green">145</span></p>
          <p class="font-sans text-sm text-limber-brown/70 leading-snug mb-5">$29 per class</p>
          <div class="border-t border-limber-brown/10 mb-5"></div>
          <p class="font-sans text-sm text-limber-brown/70 mb-4">Valid for 3 months from date of purchase</p>
          <ul class="space-y-2 mb-8 flex-1">
            {groupPackTerms.map((term) => (
              <li class="font-sans text-sm text-limber-brown/60 flex gap-2">
                <span class="text-limber-brown/40 flex-shrink-0">—</span>
                {term}
              </li>
            ))}
          </ul>
          <a href="https://momence.com/m/405119" target="_blank" rel="noopener noreferrer" class="block w-full text-center px-6 py-3.5 font-headline text-sm text-limber-brown bg-limber-bright hover:bg-limber-vibe border-2 border-limber-bright rounded-full transition-colors"><span class="relative top-[2px]">Buy now</span></a>
          <a href="https://momence.com/m/405119?g=gift" target="_blank" rel="noopener noreferrer" class="block w-full text-center px-6 py-3.5 font-headline text-sm text-limber-brown border-2 border-limber-brown hover:bg-limber-brown hover:text-limber-cream rounded-full transition-colors mt-2"><span class="relative top-[2px]">Gift to someone</span></a>
        </div>

        <!-- 10 Class Pack — brown -->
        <div class="rounded-2xl border-2 border-limber-bright p-7 bg-limber-brown flex flex-col">
          <p class="font-display italic text-lg text-limber-cream/50 mb-3">Group classes</p>
          <p class="font-headline text-2xl text-limber-cream mb-4">10 Class Pack</p>
          <div class="border-t border-limber-bright/20 mb-5"></div>
          <p class="mb-1"><span class="font-sans text-5xl text-limber-bright">$</span><span class="font-sans text-5xl font-bold text-limber-bright">270</span></p>
          <p class="font-sans text-sm text-limber-cream/80 leading-snug mb-5">$27 per class</p>
          <div class="border-t border-limber-bright/20 mb-5"></div>
          <p class="font-sans text-sm text-limber-cream/80 mb-4">Valid for 6 months from date of purchase</p>
          <ul class="space-y-2 mb-8 flex-1">
            {groupPackTerms.map((term) => (
              <li class="font-sans text-sm text-limber-cream/70 flex gap-2">
                <span class="text-limber-cream/40 flex-shrink-0">—</span>
                {term}
              </li>
            ))}
          </ul>
          <a href="https://momence.com/m/405118" target="_blank" rel="noopener noreferrer" class="block w-full text-center px-6 py-3.5 font-headline text-sm text-limber-brown bg-limber-bright hover:bg-limber-vibe border-2 border-limber-bright rounded-full transition-colors"><span class="relative top-[2px]">Buy now</span></a>
          <a href="https://momence.com/m/405118?g=gift" target="_blank" rel="noopener noreferrer" class="block w-full text-center px-6 py-3.5 font-headline text-sm text-limber-bright border-2 border-limber-bright hover:bg-limber-bright hover:text-limber-brown rounded-full transition-colors mt-2"><span class="relative top-[2px]">Gift to someone</span></a>
        </div>

        <!-- Lunch Express Pack — cream -->
        <div class="rounded-2xl border-2 border-limber-brown p-7 bg-limber-cream flex flex-col">
          <p class="font-display italic text-lg text-limber-brown/40 mb-3">Lunch express</p>
          <p class="font-headline text-2xl text-limber-green mb-4">Lunch Express 10 Class Pack</p>
          <div class="border-t border-limber-brown/10 mb-5"></div>
          <p class="mb-1"><span class="font-sans text-5xl text-limber-green">$</span><span class="font-sans text-5xl font-bold text-limber-green">220</span></p>
          <p class="font-sans text-sm text-limber-brown/70 leading-snug mb-5">$22 per class</p>
          <div class="border-t border-limber-brown/10 mb-5"></div>
          <p class="font-sans text-sm text-limber-brown/70 mb-4">Valid for 6 months from date of purchase</p>
          <ul class="space-y-2 mb-8 flex-1">
            {lunchPackTerms.map((term) => (
              <li class="font-sans text-sm text-limber-brown/60 flex gap-2">
                <span class="text-limber-brown/40 flex-shrink-0">—</span>
                {term}
              </li>
            ))}
          </ul>
          <a href="https://momence.com/m/405120" target="_blank" rel="noopener noreferrer" class="block w-full text-center px-6 py-3.5 font-headline text-sm text-limber-brown bg-limber-bright hover:bg-limber-vibe border-2 border-limber-bright rounded-full transition-colors"><span class="relative top-[2px]">Buy now</span></a>
          <a href="https://momence.com/m/405120?g=gift" target="_blank" rel="noopener noreferrer" class="block w-full text-center px-6 py-3.5 font-headline text-sm text-limber-brown border-2 border-limber-brown hover:bg-limber-brown hover:text-limber-cream rounded-full transition-colors mt-2"><span class="relative top-[2px]">Gift to someone</span></a>
        </div>

        <!-- Semi-Private Pack — brown -->
        <div class="rounded-2xl border-2 border-limber-bright p-7 bg-limber-brown flex flex-col">
          <p class="font-display italic text-lg text-limber-cream/50 mb-3">Semi-private</p>
          <p class="font-headline text-2xl text-limber-cream mb-4">Semi-Private 5 Pack</p>
          <div class="border-t border-limber-bright/20 mb-5"></div>
          <p class="mb-1"><span class="font-sans text-5xl text-limber-bright">$</span><span class="font-sans text-5xl font-bold text-limber-bright">250</span></p>
          <p class="font-sans text-sm text-limber-cream/80 leading-snug mb-5">$50 per session</p>
          <div class="border-t border-limber-bright/20 mb-5"></div>
          <p class="font-sans text-sm text-limber-cream/80 mb-4">Valid for 3 months from date of purchase</p>
          <ul class="space-y-2 mb-8 flex-1">
            {semiPackTerms.map((term) => (
              <li class="font-sans text-sm text-limber-cream/70 flex gap-2">
                <span class="text-limber-cream/40 flex-shrink-0">—</span>
                {term}
              </li>
            ))}
          </ul>
          <a href="https://momence.com/m/405137" target="_blank" rel="noopener noreferrer" class="block w-full text-center px-6 py-3.5 font-headline text-sm text-limber-brown bg-limber-bright hover:bg-limber-vibe border-2 border-limber-bright rounded-full transition-colors"><span class="relative top-[2px]">Buy now</span></a>
          <a href="https://momence.com/m/405137?g=gift" target="_blank" rel="noopener noreferrer" class="block w-full text-center px-6 py-3.5 font-headline text-sm text-limber-bright border-2 border-limber-bright hover:bg-limber-bright hover:text-limber-brown rounded-full transition-colors mt-2"><span class="relative top-[2px]">Gift to someone</span></a>
        </div>

    </div>
  </section>

  <!-- ── FAQs ── -->
  <section class="bg-limber-brown py-20 lg:py-28">
    <div class="px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-2 lg:gap-16 items-start">
        <div>
      <h2 class="mb-12">
        <span class="font-headline uppercase text-4xl md:text-5xl lg:text-6xl text-limber-bright block leading-none -mb-1">frequently</span>
        <span class="font-display italic font-medium text-5xl md:text-6xl lg:text-7xl text-limber-cream block leading-none">Asked questions</span>
      </h2>
      <div>
        {faqs.map((item) => (
          <div class="py-6 border-b border-limber-bright/20 last:border-0">
            <p class="font-headline text-sm text-limber-bright mb-2">{item.q}</p>
            <p class="font-sans text-base text-limber-cream/80 leading-relaxed">{item.a}</p>
          </div>
        ))}
      </div>
        </div>
        <div class="mt-12 lg:mt-0">
          <img
            src="/images/Limber_April26_136.jpg"
            alt="Limber studio"
            class="w-full h-72 lg:h-[480px] object-cover object-[center_25%] rounded-2xl border-2 border-limber-bright"
          />
        </div>
      </div>
    </div>
  </section>

  <CtaSlice
    headingLine1="rather commit"
    headingLine2="To a membership?"
    body="If you're moving regularly, a membership works out better value than packs. We've got options from one class a week all the way to unlimited."
    image="/images/Limber_April26_176.jpg"
    imageAlt="Limber community"
    sectionBg="bg-limber-cream"
    showBorder={false}
    buttons={[
      { label: 'View memberships', href: '/pricing/memberships' },
      { label: 'Get in touch', href: '/contact', variant: 'outline' },
    ]}
  />

</BaseLayout>
