---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaSlice from '../../components/CtaSlice.astro';
import PricingHero from '../../components/PricingHero.astro';
import { trialReviews } from '../../data/reviews';
---

<BaseLayout
  title="The Limber Way — Intro Trial"
  description="New to Limber? The Limber Way is 21 days of unlimited classes, a personalised plan, and a real human in your corner. $99 for new members."
  hideBanner={true}
>

  <!-- ── HERO ── -->
  <section class="bg-limber-green border-b-2 border-limber-vibe">
    <div class="h-[520px] lg:h-[640px] overflow-hidden border-b-2 border-limber-vibe">
      <img
        src="/images/Limber_April26_173.jpg"
        alt="Limber studio"
        class="w-full h-full object-cover object-[center_53%]"
        style="transform: scale(1.15); transform-origin: center 53%;"
      />
    </div>
    <div class="px-4 sm:px-6 lg:px-8 py-10 lg:py-14">
      <div class="lg:grid lg:grid-cols-2 lg:gap-16 items-end">
        <!-- Left: heading + CTAs -->
        <div>
          <h1 class="mb-8">
            <span class="font-display italic font-medium text-5xl md:text-6xl lg:text-7xl text-limber-cream block leading-none -mb-1">Welcome to the</span>
            <span class="font-headline uppercase text-5xl md:text-6xl lg:text-7xl text-limber-vibe block leading-none">Limber way</span>
          </h1>
          <div class="space-y-4 mb-8 max-w-md">
            <p class="font-display italic text-xl text-limber-vibe leading-snug">It's not just an intro pass. It's a proper welcome.</p>
            <p class="font-sans text-limber-cream/80 leading-relaxed">21 days of unlimited classes, a personalised plan built around you, and a real human in your corner the whole way.</p>
            <p class="font-sans text-limber-cream/80 leading-relaxed">No wandering in and hoping for the best. No guessing which class to try first. No "good luck in there."</p>
            <p class="font-display italic text-xl text-limber-vibe leading-snug">Just a genuinely supported start: the Limber way.</p>
          </div>
          <div class="flex flex-wrap justify-center lg:justify-start gap-3">
            <a href="https://momence.com/Limber-Co/membership/The-Limber-way-reset---21-day-programme-/411175" target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-8 py-4 font-headline text-sm text-limber-green bg-limber-vibe hover:bg-limber-bright border-2 border-limber-vibe rounded-full transition-colors">
              Start for $99
            </a>
            <a href="#how-it-works" class="inline-flex items-center px-8 py-4 font-headline text-sm text-limber-cream border-2 border-limber-cream hover:border-limber-vibe hover:text-limber-vibe rounded-full transition-colors">
              Tell me more
            </a>
          </div>
        </div>

        <!-- Right: what's included card -->
        <div class="mt-8 lg:mt-0">
          <div class="bg-limber-cream rounded-2xl border-2 border-limber-green p-8">
            <p class="font-headline text-xs text-limber-brown mb-6">What's included</p>
            <ul class="space-y-3">
              {['Unlimited classes for 21 days', 'Personalised plan', 'Regular check-ins', 'A real human in your corner'].map((spec) => (
                <li class="flex items-center gap-3 border-b border-limber-green/10 pb-3 last:border-0 last:pb-0">
                  <span class="w-1.5 h-1.5 rounded-full bg-limber-brown flex-shrink-0"></span>
                  <p class="font-display not-italic text-lg text-limber-brown">{spec}</p>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── HOW IT WORKS ── -->
  <section id="how-it-works" class="bg-limber-green py-20 lg:py-28 border-b-2 border-limber-vibe">
    <div class="px-4 sm:px-6 lg:px-8">

      <h2 class="mb-16">
        <span class="flex items-baseline gap-[0.2em] leading-none -mb-1">
          <span class="font-headline uppercase text-4xl md:text-5xl lg:text-6xl text-limber-vibe">HOW</span>
          <span class="font-display italic font-medium text-5xl md:text-6xl lg:text-7xl text-limber-cream">it works</span>
        </span>
      </h2>

      <!-- Horizontal scroll on mobile, 5-col grid on desktop -->
      <div class="flex gap-4 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-4 -mx-4 sm:-mx-6 lg:mx-0 pl-4 sm:pl-6 lg:pl-0 [scroll-padding-left:1rem] sm:[scroll-padding-left:1.5rem] lg:grid lg:grid-cols-5 lg:overflow-visible lg:pb-0" style="scrollbar-width: none;">
        {[
          {
            n: '01',
            title: 'You claim your spot',
            body: 'Grab your Limber way for $99 and we\'ll be in touch straight away.',
          },
          {
            n: '02',
            title: 'We have a proper chat',
            body: 'Your studio lead will reach out and set up a call or catch up. No awkward formalities, just a real conversation.',
          },
          {
            n: '03',
            title: 'Your welcome ritual card',
            body: 'We\'ll go through your why, your goals, and whether you\'d like extra support. This isn\'t a form. It\'s the starting point.',
          },
          {
            n: '04',
            title: 'Your personalised plan',
            body: 'Your studio lead maps out exactly which classes to start with and helps you get your first bookings sorted.',
          },
          {
            n: '05',
            title: 'You show up, we check in',
            body: 'You do your classes, we check in regularly. You\'re never just left to figure it out alone.',
          },
        ].map((step) => (
          <div class="snap-start flex-shrink-0 w-[80vw] sm:w-[45vw] lg:w-auto flex flex-col bg-limber-cream border-2 border-limber-green rounded-2xl p-6 last:mr-4 sm:last:mr-6">
            <span class="font-headline text-xs text-limber-tericotta mb-6">{step.n}</span>
            <p class="font-headline text-base text-limber-green leading-snug mb-3 flex-1">{step.title}</p>
            <p class="font-sans text-base text-limber-brown/60 leading-relaxed">{step.body}</p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ── LOVE NOTES ── -->
  <section class="bg-limber-green py-20 lg:py-28 border-b-2 border-limber-vibe">
    <div class="px-4 sm:px-6 lg:px-8">

      <h2 class="mb-14">
        <span class="flex items-baseline gap-[0.2em] leading-none -mb-1">
          <span class="font-headline uppercase text-4xl md:text-5xl lg:text-6xl text-limber-vibe">WHAT</span>
          <span class="font-display italic font-medium text-5xl md:text-6xl lg:text-7xl text-limber-cream">people</span>
        </span>
        <span class="flex items-baseline gap-[0.2em] leading-none">
          <span class="font-display italic font-medium text-5xl md:text-6xl lg:text-7xl text-limber-cream">are</span>
          <span class="font-headline uppercase text-4xl md:text-5xl lg:text-6xl text-limber-vibe">SAYING</span>
        </span>
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-10">
        {trialReviews.map((item, i) => (
          <div class:list={[
            'p-7 rounded-2xl border-2',
            i === 0 ? 'bg-limber-cream border-limber-green' : i === 1 ? 'bg-limber-vibe border-limber-green' : 'bg-limber-cream border-limber-green',
          ]}>
            <p class:list={[
              'font-display italic text-lg leading-relaxed mb-5',
              'text-limber-brown/80',
            ]}>
              "{item.body}"
            </p>
            <p class="font-headline text-xs text-limber-brown/50">
              — {item.name}
            </p>
          </div>
        ))}
      </div>

      <a href="/reviews" class="inline-flex items-center px-6 py-3 font-headline text-sm text-limber-green bg-limber-vibe hover:bg-limber-bright border-2 border-limber-vibe rounded-full transition-colors">
        Read more
      </a>

    </div>
  </section>

  <!-- ── FAQs ── -->
  <section class="bg-limber-cream pt-20 lg:pt-28 pb-8 lg:pb-10">
    <div class="px-4 sm:px-6 lg:px-8">

      <h2 class="mb-12">
        <span class="font-headline uppercase text-4xl md:text-5xl lg:text-6xl text-limber-green block leading-none -mb-1">frequently</span>
        <span class="font-display italic font-medium text-5xl md:text-6xl lg:text-7xl text-limber-brown block leading-none">asked questions</span>
      </h2>

      <div class="max-w-2xl space-y-0">
        {[
          {
            q: 'Is the Limber way for new members only?',
            a: 'Yes, it\'s designed specifically for people joining Limber for the first time.',
          },
          {
            q: 'What if I\'ve done the Limber way before?',
            a: 'Once per client I\'m afraid. But we\'d love to chat about the best membership option for you.',
          },
          {
            q: 'When can I start?',
            a: 'Whenever you\'re ready. There\'s no set start date. Your 21 days begins the moment you claim your spot.',
          },
          {
            q: 'Can I pause my Limber way?',
            a: 'The Limber way runs as a continuous 21 days and can\'t be paused. If you have questions just get in touch.',
          },
        ].map((item) => (
          <div class="py-6 border-b border-limber-green/20 last:border-0">
            <p class="font-headline text-sm text-limber-green mb-2">{item.q}</p>
            <p class="font-sans text-base text-limber-brown/80 leading-relaxed">{item.a}</p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <CtaSlice
    headingLine1="ready to"
    headingLine2="start properly?"
    sectionBg="bg-limber-cream"
    showBorder={false}
    body="Pilates obsessive, total movement newbie, yoga devotee, or someone who's been watching from afar. Hi. We've been waiting for you."
    image="/images/Communtity1.jpg"
    imagePosition="object-[center_25%]"
    imageAlt="Limber community"
    buttons={[
      { label: 'Start for $99', href: 'https://momence.com/Limber-Co/membership/The-Limber-way-reset---21-day-programme-/411175' },
      { label: 'Get in touch', href: '/contact', variant: 'outline' },
    ]}
  />

</BaseLayout>
