---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Overlapping Images — Test"
  description="Image layout experiments"
  noindex={true}
  hideBanner={true}
>

  <section class="bg-limber-cream-bg py-16 border-b-2 border-neutral-900">
    <div class="px-8 lg:px-14">
      <p class="font-headline text-xs text-limber-tericotta mb-2">test page</p>
      <h1 class="font-headline uppercase text-4xl text-limber-green">overlapping image experiments</h1>
    </div>
  </section>

  <!-- ── EXPERIMENT 5: Horizontal filmstrip overlap ── -->
  <section class="bg-limber-green py-24 border-b-2 border-neutral-900 overflow-hidden">
    <div class="px-8 lg:px-14 mb-10">
      <p class="font-headline text-xs text-limber-vibe">experiment 01</p>
      <p class="font-display italic text-xl text-limber-cream">filmstrip overlap</p>
    </div>
    <div class="flex items-end justify-center px-8 lg:px-14 gap-3">
      {[
        { src: '/images/Limber_April26_99.jpg',    h: 224, rotate: '-rotate-3', z: 'z-10' },
        { src: '/images/Limber_April26_134.jpg',   h: 288, rotate: 'rotate-2',  z: 'z-20' },
        { src: '/images/Limber_April26_137.jpg',   h: 256, rotate: '-rotate-1', z: 'z-10' },
        { src: '/images/Limber_April26_141.jpg',   h: 320, rotate: 'rotate-3',  z: 'z-30' },
