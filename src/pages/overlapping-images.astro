        { src: '/images/Limber_April26_170.jpg',   h: 256, rotate: '-rotate-1', z: 'z-20' },
        { src: '/images/Limber_April26_174.jpg',   h: 296, rotate: 'rotate-2',  z: 'z-10' },
        { src: '/images/Limber_Lily.jpg',           h: 272, rotate: '-rotate-3', z: 'z-20' },
      ].map((img, i) => (
        <div
          class:list={[
            'flex-shrink-0 w-[10%] rounded-2xl border-2 border-neutral-900 overflow-hidden shadow-xl',
            img.rotate, img.z,
          ]}
          style={`height: ${img.h}px;`}
