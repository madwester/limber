---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaSlice from '../components/CtaSlice.astro';
import Logo from '../components/Logo.astro';
import { reviews } from '../data/reviews';

const schema = {
 '@context': 'https://schema.org',
 '@type': 'WebSite',
 name: 'Limber',
 url: 'https://limberco.com.au',
};

const classesTaster = [
 { name: 'Limber Signature', description: 'Flowing, fiery, full body mat pilates. The one that started it all.', image: '/images/classes/signature.jpg' },
 { name: 'Limbarre', nameSplit: ['Lim', 'Barre'], description: 'Move to the beat, work the whole body, leave with a dopamine hit.', image: '/images/classes/limbarre_1.jpg' },
 { name: 'Limber Strength', description: 'Pilates meets functional strength training, meant for each other.', image: '/images/classes/strength.jpg' },
 { name: 'Limber Chair', description: 'This small machine packs a mighty punch. Springs that bring both the support and the fire.', image: '/images/classes/chair_1.jpg' },
 { name: 'Limber Up', description: 'Our self-prescribed 45 minutes of self care.', image: '/images/classes/recovery_classes_limber_up_1.jpg' },
 { name: 'Limber Power Flow', description: '"Power" says it all: Vinyasa flow that works the whole body and mind.', image: '/images/classes/power_yoga_1.jpg' },
 { name: 'Limber Unfurl', description: 'The art of doing less to go deeper. Long holds, deep connective tissue work and an hour to unwind.', image: '/images/classes/unfurel_yin_yoga.jpg' },
 { name: 'Limboogie', nameSplit: ['Lim', 'Boogie'], description: 'Cardio so disguised in fun you won\'t even notice you\'re working out. The most joy you\'ll have exercising. No experience (or coordination) required.', image: '/images/Limber_April26_112.jpg' },
 { name: 'Limber Breathe', description: 'Two distinct breathwork experiences — rebirthing with Ali Logan or dynamic with Sam Bennett. Both 60 minutes.', image: '/images/breathwork.jpg' },
 { name: 'Limber Live Music', description: 'Live music sessions in our yoga classes. Immersive, grounding and a little magic.', image: '/images/limber_live_music.jpg' },
];
---

<BaseLayout
 title="Home"
 description="Limber is a movement studio offering Pilates, yoga, and mobility classes. Authentic movement, real community, zero pretension."
 schema={schema}
>

 <!-- ── HERO IMAGE — right under nav ── -->
 <div class="relative overflow-hidden w-full h-[520px] lg:h-[680px] border-b-2 border-limber-vibe">
  <img
   src="/images/home_page_hero.jpg"
   alt="Limber studio"
   class="w-full h-full object-cover object-[center_25%]"
  />
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
   <Logo class="w-64 lg:w-96 h-auto" color="var(--color-limber-cream)" />
  </div>
 </div>

 <!-- ── SECTION 1 — HERO TEXT ── -->
 <section class="bg-limber-green pt-16 pb-20 lg:pt-20 lg:pb-28">
  <div class="px-4 sm:px-6 lg:px-8">
   <div class="relative">
    <h1 class="leading-none mb-8">
     <span class="font-headline uppercase text-4xl md:text-5xl lg:text-6xl text-limber-vibe block leading-none">
      movement that
     </span>
     <span class="font-display italic font-medium text-5xl md:text-6xl lg:text-7xl text-limber-cream block leading-none">
      Makes you feel <span class="text-limber-cream whitespace-nowrap">like this</span>
     </span>
    </h1>

    <p class="font-sans text-lg text-limber-cream/80 leading-relaxed mb-1 max-w-xl">
     Remember when movement genuinely felt good?
    </p>
    <p class="font-sans text-lg text-limber-cream/80 leading-relaxed mb-8">
     We're bringing that feeling back.
    </p>

<img
     src="/images/stickers/flower.svg"
     alt=""
     aria-hidden="true"
     class="absolute lg:right-0 lg:bottom-0 w-24 h-24 lg:w-32 lg:h-32 rotate-[12deg] pointer-events-none"
     style="right: calc(var(--spacing) * -6); bottom: calc(var(--spacing) * -23); filter: brightness(0) saturate(100%) invert(66%) sepia(62%) saturate(625%) hue-rotate(338deg) brightness(1.05);"
    />
   </div>

   <div class="flex flex-wrap justify-start gap-4 mb-12 mt-8">
    <a
     href="/pricing/trial"
     class="inline-flex items-center px-8 py-4 font-headline text-sm text-limber-green bg-limber-vibe hover:bg-limber-bright border-2 border-limber-vibe rounded-full transition-colors"
    >
     <span class="relative top-[2px]">Start for $99</span>
    </a>
    <a
     href="/classes/our-classes"
     class="inline-flex items-center px-8 py-4 font-headline text-sm text-limber-vibe border-2 border-limber-vibe rounded-full transition-colors"
    >
     <span class="relative top-[2px]">Browse classes first</span>
    </a>
   </div>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-12 px-4 sm:px-6 lg:px-8">
   <!-- Image 1 -->
   <div class="rounded-2xl border-2 border-limber-vibe overflow-hidden h-72 lg:h-[480px]">
    <img
     src="/images/Communtity1.jpg"
     alt="Limber studio"
     class="w-full h-full object-cover"
    />
   </div>
   <!-- Image 2 -->
   <div
    class="rounded-2xl border-2 border-limber-vibe h-72 lg:h-[480px] relative"
    style="background-image: url('/images/Limber_April26_151.jpg'); background-size: cover; background-position: center; border-radius: 1rem;"
   >
   </div>
   <!-- Image 3 -->
   <div class="rounded-2xl border-2 border-limber-vibe overflow-hidden h-72 lg:h-[480px]">
    <img
     src="/images/overlapping/overlapping-legs.png"
     alt="Limber class"
     class="w-full h-full object-cover"
    />
   </div>
  </div>
 </section>

 <!-- ── SECTION 2 — THE LIMBER WAY ── -->
 <section class="bg-limber-green py-20 lg:py-28 border-t-2 border-limber-vibe">
  <div class="px-4 sm:px-6 lg:px-8">
   <div class="lg:grid lg:grid-cols-2 lg:gap-16 items-start">

    <!-- Left: copy -->
    <div class="text-left">
     <h2 class="mb-6">
      <span class="flex items-baseline flex-wrap gap-[0.2em] leading-snug">
       <span class="font-headline uppercase text-4xl md:text-5xl lg:text-6xl text-limber-vibe">new around here?</span>
       <span class="font-display italic font-medium text-4xl md:text-5xl lg:text-6xl text-limber-cream">We have got something for you</span>
      </span>
     </h2>
     <p class="font-display text-xl italic text-limber-vibe mb-6">
      The Limber Way: $99 · 21 days · unlimited classes
     </p>
     <p class="font-sans text-limber-cream/80 leading-relaxed mb-10">
      Pilates obsessed, a yoga devotee, or a total movement newbie? Let's do this.<br />
     The Limber Way is your guided first 21 days. Unlimited classes, a personalised plan and check in's the whole way.<br />
     This is how the Limber love story begins.
     </p>
     <div class="flex flex-wrap justify-start gap-4">
      <a
       href="/pricing/trial"
       class="inline-flex items-center px-8 py-4 font-headline text-sm text-limber-green bg-limber-vibe hover:bg-limber-bright border-2 border-limber-vibe rounded-full transition-colors"
      >
       <span class="relative top-[2px]">Start for $99</span>
      </a>
      <a
       href="/pricing/trial"
       class="inline-flex items-center px-8 py-4 font-headline text-sm text-limber-cream border-2 border-limber-cream rounded-full transition-colors"
      >
       <span class="relative top-[2px]">Tell me more</span>
      </a>
     </div>
    </div>

    <!-- Right: image + specs card -->
    <div class="mt-12 lg:mt-0 space-y-4">
     <img
      src="/images/limber_in_studio_2025.webp"
      alt="Limber class in session"
      class="w-full h-64 lg:h-72 object-cover rounded-2xl border-2 border-limber-vibe"
     />
     <div class="bg-limber-cream rounded-2xl border-2 border-limber-green p-8">
      <p class="font-headline text-xs text-limber-brown mb-6">What's included</p>
      <ul class="space-y-3">
       {['Unlimited classes', 'Personalised plan', 'Regular check-ins', '21 days'].map((spec) => (
        <li class="flex items-center gap-3 border-b border-limber-green/10 pb-3 last:border-0 last:pb-0">
         <span class="w-1.5 h-1.5 rounded-full bg-limber-brown flex-shrink-0"></span>
         <p class="font-display not-italic text-lg text-limber-brown">{spec}</p>
        </li>
       ))}
      </ul>
     </div>
    </div>

   </div>
  </div>
 </section>

 <!-- ── SECTION 3 — WHAT IS LIMBER ── -->
 <section class="bg-limber-vibe py-20 lg:py-28 border-t-2 border-limber-green">
  <div class="px-4 sm:px-6 lg:px-8">
   <div class="lg:grid lg:grid-cols-2 lg:gap-16 items-center">

    <!-- Left: image -->
    <div class="mb-10 lg:mb-0 relative">
     <img
      src="/images/Limber_April26_102.jpg"
      alt="Limber studio"
      class="w-full h-80 lg:h-[560px] object-cover rounded-2xl border-2 border-limber-green"
     />
     <img
      src="/images/stickers/sticker-3.svg"
      alt=""
      aria-hidden="true"
      class="absolute -bottom-12 w-24 h-24 lg:w-32 lg:h-32 rotate-12" style="right: calc(var(--spacing) * -6);"
     />
    </div>

    <!-- Right: heading + copy + CTA -->
    <div class="text-left">
     <h2 class="leading-none mb-8 stacked-heading">
      <span class="font-display italic font-medium text-5xl md:text-6xl lg:text-7xl text-limber-cream block leading-none">To help people</span>
      <span class="font-headline uppercase text-4xl md:text-5xl lg:text-6xl text-limber-brown block leading-none mt-4">feel at home</span>
      <span class="font-display italic font-medium text-5xl md:text-6xl lg:text-7xl text-limber-cream block leading-none">In their bodies</span>
     </h2>
     <div class="space-y-4 mb-10">
      <p class="font-sans text-limber-brown/80 leading-relaxed">
       Believe it or not, movement should feel genuinely good.
      </p>
      <p class="font-sans text-limber-brown/80 leading-relaxed">
       At Limber, we follow the principles of pilates, yoga and strength training, layered with our own unique method. We call it the Limber secret sauce. (We can't tell you what it is. But you'll feel it.)
      </p>
      <p class="font-sans text-limber-brown/80 leading-relaxed">
       Our classes are designed to meet you wherever you're at; challenging you without destroying you, building confidence, connection and a newfound love of movement.
      </p>
      <p class="font-sans text-limber-brown/80 leading-relaxed">
       Because movement should make you feel better than before you walked in the door.
      </p>
     </div>
     <div class="flex justify-start">
      <a
       href="/about/our-vibe"
       class="inline-flex items-center px-8 py-4 font-headline text-sm text-limber-cream bg-limber-brown hover:bg-limber-tericotta border-2 border-limber-brown rounded-full transition-colors"
      >
       <span class="relative top-[2px]">Learn what we're all about</span>
      </a>
     </div>
    </div>

   </div>
  </div>
 </section>

 <!-- ── SECTION 4 — CLASSES CAROUSEL ── -->
 <section class="py-20 lg:py-28 bg-limber-vibe border-t-2 border-limber-green" style="overflow-x: clip;">
  <div class="px-4 sm:px-6 lg:px-8">

   <!-- Header row -->
   <div class="mb-6">
    <h2>
     <span class="flex items-baseline gap-[0.2em] leading-none">
      <span class="font-headline uppercase text-4xl md:text-5xl lg:text-6xl text-limber-brown">Limber</span>
      <span class="font-display italic font-medium text-5xl md:text-6xl lg:text-7xl text-limber-brown">Lineup</span>
     </span>
    </h2>
   </div>

   <!-- Carousel track — negative margins extend to viewport edges, left padding only for inset -->
   <div id="carousel-track"
    class="flex gap-4 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-4 -mx-4 sm:-mx-6 lg:-mx-8 pl-4 sm:pl-6 lg:pl-8 [scroll-padding-left:1rem] sm:[scroll-padding-left:1.5rem] lg:[scroll-padding-left:2rem]"
    style="scrollbar-width: none;"
   >
    {classesTaster.map((cls) => (
     <a
      href={`/classes/our-classes#${cls.name.toLowerCase().replace(/\s+/g, '-')}`}
      class="snap-start flex-shrink-0 w-[80vw] sm:w-[45vw] lg:w-[30vw] bg-limber-cream rounded-2xl border-2 border-limber-green overflow-hidden hover:border-limber-tericotta transition-colors group last:mr-4 sm:last:mr-6 lg:last:mr-8 flex flex-col"
     >
      <div class="overflow-hidden">
       <img
        src={cls.image}
        alt={cls.name}
        loading="lazy"
        decoding="async"
        class="w-full h-44 object-cover border-b-2 border-limber-green group-hover:scale-105 transition-transform duration-300"
       />
      </div>
      <div class="px-4 py-6">
       <p class="font-headline uppercase text-xl text-limber-green group-hover:text-limber-tericotta transition-colors leading-none mb-2">{cls.name}</p>
       <p class="font-sans text-sm text-limber-brown/70 leading-relaxed">{cls.description}</p>
      </div>
     </a>
    ))}
   </div>

   <!-- Learn more button -->
   <div class="flex justify-center mt-10">
    <a
     href="/classes/our-classes"
     class="inline-flex items-center px-8 py-4 font-headline text-sm text-limber-green border-2 border-limber-green rounded-full hover:bg-limber-green hover:text-limber-vibe transition-colors"
    >
     <span class="relative top-[2px]">Learn more about our classes</span>
    </a>
   </div>

  </div>
 </section>

 <!-- ── TESTIMONIALS ── -->
 <section class="py-20 lg:py-28 pb-10 lg:pb-12 bg-limber-cream border-t-2 border-limber-green">
  <div class="px-4 sm:px-6 lg:px-8">
   <div class="mb-12">
    <h2>
     <span class="flex items-baseline gap-[0.15em] leading-none -mb-1">
      <span class="font-headline uppercase text-4xl md:text-5xl lg:text-6xl text-limber-green">WHAT</span>
      <span class="font-display italic font-medium text-5xl md:text-6xl lg:text-7xl text-limber-green">Our</span>
     </span>
     <span class="flex flex-wrap items-baseline gap-x-[0.15em] leading-none mt-4">
      <span class="font-headline uppercase text-4xl md:text-5xl lg:text-6xl text-limber-green">COMMUNITY</span>
      <span class="font-display italic font-medium text-5xl md:text-6xl lg:text-7xl text-limber-green whitespace-nowrap">Is saying</span>
     </span>
    </h2>
   </div>

   <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {
     reviews.slice(0, 3).map((r, i) => {
      const cards = [
       { bg: 'bg-limber-green', border: 'border-limber-vibe', stars: 'text-limber-vibe', quote: 'text-limber-cream', name: 'text-limber-vibe' },
       { bg: 'bg-limber-vibe', border: 'border-limber-green', stars: 'text-limber-green', quote: 'text-limber-green', name: 'text-limber-brown' },
       { bg: 'bg-limber-green', border: 'border-limber-vibe', stars: 'text-limber-vibe', quote: 'text-limber-cream', name: 'text-limber-vibe' },
      ];
      const c = cards[i % cards.length];
      return (
       <blockquote class:list={['p-8 rounded-2xl border-2', c.bg, c.border]}>
        <div class="flex gap-1 mb-5">
         {Array.from({ length: r.rating }).map(() => (
          <svg class:list={['w-4 h-4', c.stars]} fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
           <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
         ))}
        </div>
        <p class:list={['font-display text-lg leading-relaxed mb-5', c.quote]}>"{r.body}"</p>
        <footer class:list={['font-headline text-xs', c.name]}>{r.name}</footer>
       </blockquote>
      );
     })
    }
   </div>

   <div class="text-center mt-10">
    <a href="/reviews" class="font-headline text-sm text-limber-green hover:text-limber-tericotta transition-colors">
     Read all the love →
    </a>
   </div>
  </div>
 </section>

 <!-- ── SECTION 5 — APP DOWNLOAD ── -->
 <CtaSlice
  headingLine1="limber in"
  headingLine2="Your pocket"
  body="Book classes, manage your membership, and check the timetable, all from your phone."
  image="/images/Limber_April26_170.jpg"
  imageAlt="Limber app"
  sectionBg="bg-limber-cream"
  showBorder={false}
  sticker="/images/stickers/sticker-2.svg"
  buttons={[
    { label: 'App Store', href: 'https://apps.apple.com/au/app/limber-co/id6744895425', target: '_blank' },
    { label: 'Google Play', href: 'https://play.google.com/store/apps/details?id=com.ribbon.mobileApp&hl=en_AU', target: '_blank', variant: 'outline' },
  ]}
 />


</BaseLayout>

<script>
  const track = document.getElementById('carousel-track');
  const prevBtn = document.getElementById('carousel-prev');
  const nextBtn = document.getElementById('carousel-next');

  function getCardWidth() {
    const first = track?.querySelector(':scope > a') as HTMLElement | null;
    if (!first) return 0;
    return first.offsetWidth + 16; // card width + gap-4
  }

  const prevMobile = document.getElementById('carousel-prev-mobile');
  const nextMobile = document.getElementById('carousel-next-mobile');

  prevBtn?.addEventListener('click', () => { track?.scrollBy({ left: -getCardWidth(), behavior: 'smooth' }); });
  nextBtn?.addEventListener('click', () => { track?.scrollBy({ left: getCardWidth(), behavior: 'smooth' }); });
  prevMobile?.addEventListener('click', () => { track?.scrollBy({ left: -getCardWidth(), behavior: 'smooth' }); });
  nextMobile?.addEventListener('click', () => { track?.scrollBy({ left: getCardWidth(), behavior: 'smooth' }); });
</script>
