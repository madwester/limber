---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaSlice from '../../components/CtaSlice.astro';
import FullBleedHero from '../../components/FullBleedHero.astro';
---

<BaseLayout
  title="Our Vibe"
  description="What Limber is really about — joyful movement, real community, and a place to feel at home in your body."
>

  <!-- ── OUR VIBE — full-bleed image + content ── -->
  <FullBleedHero
    bgColor="bg-limber-green"
    borderColor="border-limber-vibe"
    image="/images/Limber_April26_102.jpg"
    sectionBorderColor="border-limber-vibe"
    imageAlt="Limber studio"
    contentPadding="px-4 sm:px-6 lg:px-8 py-16 lg:py-20"
  >
    <div class="relative">
    <div class="lg:grid lg:grid-cols-2 lg:gap-16 items-start">
    <div>
    <h1 class="flex items-baseline justify-start gap-[0.25em] leading-none mb-10">
      <span class="font-headline uppercase text-4xl md:text-5xl lg:text-6xl text-limber-vibe">our</span>
      <span class="font-display italic font-medium text-5xl md:text-6xl lg:text-7xl text-limber-cream">Vibe</span>
    </h1>

    <p class="font-display italic text-2xl lg:text-3xl text-limber-cream leading-snug mb-8">
      A place that knows you. That celebrates loudly.<br />Where community actually means something?<br />You just found your people.
    </p>

    <div class="space-y-4 mb-8 max-w-lg">
      <p class="font-sans text-limber-cream/80 leading-relaxed">
        When we opened Limber, we wanted to bring movement back to what it should be. Something you love, not a chore. Not something to measure, or use as a tool to punish yourself with.
      </p>
      <p class="font-sans text-limber-cream/80 leading-relaxed">
        After years inside traditional fitness spaces, we saw how often movement became about aesthetics, intensity and burnout. We wanted something different. So we built it. A studio rooted in pilates, yoga and strength training. A space where joy comes first, feeling good is the priority, and community is more than just a word on a website.
      </p>
    </div>

    <div class="flex flex-wrap gap-6 items-center pt-6 border-t border-limber-vibe/30 mb-8">
      {[
        { sticker: 'sticker-1.svg', text: 'Belonging.', rotate: '-rotate-6' },
        { sticker: 'sticker-2.svg', text: 'Joyful movement.', rotate: 'rotate-6' },
        { sticker: 'sticker-3.svg', text: 'Embodied wellbeing.', rotate: '-rotate-3' },
      ].map((item) => (
        <div class="flex items-center gap-3">
          <div
            aria-hidden="true"
            class:list={['w-14 h-14 flex-shrink-0', item.rotate]}
            style={`background-color: var(--color-limber-vibe); -webkit-mask-image: url('/images/stickers/${item.sticker}'); mask-image: url('/images/stickers/${item.sticker}'); -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat; -webkit-mask-size: contain; mask-size: contain; -webkit-mask-position: center; mask-position: center;`}
          ></div>
          <p class="font-display italic text-xl text-limber-cream">{item.text}</p>
        </div>
      ))}
    </div>
    </div>{/* end left col */}

    <!-- Right: image -->
    <div class="hidden lg:block mt-12 lg:mt-0">
      <img
        src="/images/Limber_April26_137.jpg"
        alt="Limber studio"
        class="w-full h-[480px] lg:h-[560px] object-cover rounded-2xl border-2 border-limber-vibe"
      />
    </div>

    </div>{/* end grid */}
    </div>{/* end relative */}
  </FullBleedHero>

  <!-- ── MISSION ── -->
  <section class="bg-limber-green py-20 lg:py-28 border-b-2 border-limber-vibe">
    <div class="px-4 sm:px-6 lg:px-8">
      <div class="relative text-center">
        <p class="font-display italic text-xl text-limber-cream mb-5">Our mission</p>

        <h2 class="leading-none mx-auto max-w-3xl stacked-heading">
          <span class="font-display italic font-medium text-5xl md:text-6xl lg:text-7xl text-limber-cream block leading-none">To help people</span>
          <span class="font-headline uppercase text-4xl md:text-5xl lg:text-6xl text-limber-vibe block leading-none mt-4">feel at home</span>
          <span class="font-display italic font-medium text-5xl md:text-6xl lg:text-7xl text-limber-cream block leading-none">In their bodies</span>
        </h2>
        <img
          src="/images/stickers/green-sticker-3.svg"
          alt=""
          aria-hidden="true"
          class="absolute top-0 right-0 w-28 h-28 lg:w-40 lg:h-40 rotate-[10deg] pointer-events-none hidden lg:block"
          style="filter: brightness(0) saturate(100%) invert(66%) sepia(62%) saturate(625%) hue-rotate(338deg) brightness(1.05);"
        />
      </div>
    </div>
  </section>

  <!-- ── THREE PILLARS ── -->
  <section class="bg-limber-green py-20 lg:py-28 border-b-2 border-limber-vibe">
    <div class="px-4 sm:px-6 lg:px-8">
      <h2 class="stacked-heading mb-12">
        <span class="font-headline uppercase text-4xl md:text-5xl lg:text-6xl text-limber-vibe block leading-none -mb-1">what makes</span>
        <span class="font-display italic font-medium text-5xl md:text-6xl lg:text-7xl text-limber-cream block leading-none">Limber, Limber</span>
      </h2>
      <div class="grid gap-6 lg:grid-cols-3">
        {[
          {
            title: 'Good company',
            body: [
              "You're in good company. Sure, our teachers are brilliant, but the crew in the room might be the best part. Movement may have been why we started, but the people are why we stayed.",
              "It starts small, with a chat on the mat or a coffee after class. But we've been known to find any excuse to meet outside the studio, from book clubs to our very own festival.",
              "We pay attention, too. We'll know your name, your niggles and your pet peeves. This place is yours as much as it's ours, and we'd like to think we're the kind of company you'd want to keep.",
            ],
            link: { label: 'Meet the team →', href: '/about/our-tribe' },
          },
          {
            title: 'It follows you home',
            body: [
              "Yes, you'll be working those glutes. The abs will be on fire too. But we built our practice for your nervous system as much as your muscles.",
              "The balance Lily went looking for became our own method. We call it the five Fs. Fun, Feeling and Flow are how it feels. Functional and Fire are what it does.",
              "That feeling follows you home in the best way. It's in the back that holds up the toddler and the head that's a lot quieter by bedtime. That's what we mean by feels good, does good.",
            ],
            link: { label: 'Explore our classes →', href: '/classes/our-classes' },
          },
          {
            title: 'We know our stuff',
            body: [
              "Wellness is our job, but it's not our entire personality. Keeping up with every new trend wears us out too, so we stick to what actually works.",
              "We stay across the research, invest in our teachers' training and keep refining how we teach, so it works for all kinds of bodies, not just the bendy few.",
              "In class, you'll always know why you're doing what you're doing. It's meant to be fun, but it's also meant to challenge you. We know our stuff, and before long so will you.",
            ],
            link: { label: 'Start your 21 days →', href: '/pricing/trial' },
          },
        ].map((pillar) => (
          <div class="rounded-2xl border-2 border-limber-vibe/40 p-8 lg:p-10 flex flex-col">
            <h3 class="font-display italic font-medium text-3xl lg:text-4xl text-limber-cream leading-tight mb-6">{pillar.title}</h3>
            <div class="space-y-4 mb-8 flex-1">
              {pillar.body.map((para) => (
                <p class="font-sans text-limber-cream/80 leading-relaxed">{para}</p>
              ))}
            </div>
            <a href={pillar.link.href} class="font-headline text-sm text-limber-vibe hover:text-limber-cream transition-colors">{pillar.link.label}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── THE STARTING POINT ── -->
  <section class="bg-limber-green py-20 lg:py-28 border-b-2 border-limber-vibe">
    <div class="px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-2 lg:gap-16 items-center">

        <!-- Photo — shows first on mobile -->
        <div class="mb-10 lg:hidden lg:max-w-[480px] lg:ml-auto">
          <img
            src="/images/overlapping/overlapping-lily-jumping.png"
            alt="Lily, founder of Limber"
            class="w-full h-72 object-cover object-[center_25%] rounded-2xl border-2 border-limber-vibe"
          />
        </div>

        <!-- Quote -->
        <blockquote class="border-l-4 border-limber-vibe pl-8">
          <p class="font-display italic text-2xl lg:text-3xl text-limber-cream leading-snug mb-6">
            "I danced professionally for years. It made me fall completely out of love with movement. Pilates gave me the joy back. And that's exactly what I wanted to build here. Limber exists to give people what movement is actually supposed to be. Joyful, healing, freeing."
          </p>
          <footer class="flex items-center gap-3 mb-8">
            <span class="font-headline text-sm text-limber-vibe">Lily, </span>
            <span class="font-display italic text-lg text-limber-cream">Founder</span>
          </footer>
          <a href="/limber-journal/the-people-are-why-we-stayed" class="font-headline text-sm text-limber-vibe hover:text-limber-cream transition-colors">
            Read more about our story →
          </a>
        </blockquote>

        <!-- Photo — desktop only (already shown above on mobile) -->
        <div class="hidden lg:block lg:max-w-[480px] lg:ml-auto">
          <img
            src="/images/overlapping/overlapping-lily-jumping.png"
            alt="Lily, founder of Limber"
            class="w-full h-96 object-cover object-[center_25%] rounded-2xl border-2 border-limber-vibe"
          />
        </div>

      </div>
    </div>
  </section>

  <CtaSlice
    headingLine1="Ready to find"
    headingLine2="Your people?"
    body="Come say hi, book a class, or just have a nosy around. We'd love to have you."
    image="/images/Limber_April26_176.jpg"
    imageAlt="Limber community"
    accentColor="text-limber-bright"
    primaryBtn="text-limber-brown bg-limber-bright hover:bg-limber-vibe border-limber-bright"
    sectionBg="bg-limber-cream"
    buttons={[
      { label: 'View memberships', href: '/pricing/memberships' },
      { label: 'See our classes', href: '/classes/our-classes', variant: 'outline' },
    ]}
  />

</BaseLayout>
