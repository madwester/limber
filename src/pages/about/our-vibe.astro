---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaSlice from '../../components/CtaSlice.astro';
import FullBleedHero from '../../components/FullBleedHero.astro';
---

<BaseLayout
  title="Our Vibe"
  description="What Limber is really about — joyful movement, real community, and a place to feel at home in your body."
>

  <!-- ── OUR VIBE — full-bleed image + content ── -->
  <FullBleedHero
    bgColor="bg-limber-green"
    borderColor="border-limber-vibe"
    image="/images/Limber_April26_102.jpg"
    sectionBorderColor="border-limber-vibe"
    imageAlt="Limber studio"
    contentPadding="px-8 lg:px-14 py-16 lg:py-20"
  >
    <div class="lg:grid lg:grid-cols-2 lg:gap-16 items-start">
    <div>
    <h1 class="flex items-end justify-center lg:justify-start gap-[0.25em] leading-none mb-10">
      <span class="font-headline uppercase text-4xl md:text-5xl lg:text-6xl text-limber-vibe">our</span>
      <span class="font-display italic font-medium text-5xl md:text-6xl lg:text-7xl text-limber-cream">vibe</span>
    </h1>

    <p class="font-display italic text-2xl lg:text-3xl text-limber-cream leading-snug mb-8">
      A place that knows you. That celebrates loudly.<br />Where community actually means something?<br /><span class="text-xl lg:text-2xl font-bold">You just found your people.</span>
    </p>

    <div class="space-y-4 mb-8 max-w-lg">
      <p class="font-sans text-limber-cream/80 leading-relaxed">
        When we opened Limber, we wanted to bring movement back to what it should be. Something you love, not a chore. Not something to measure, or use as a tool to punish yourself with. A place where community is genuinely valued and not just a word on a website.
      </p>
      <p class="font-sans text-limber-cream/80 leading-relaxed">
        No pressure, no expectations. Just space to move in a way that feels good for you.
      </p>
    </div>

    <div class="flex flex-wrap gap-6 items-center pt-6 border-t border-limber-vibe/30 mb-8">
      {[
        { sticker: 'sticker-1.svg', text: 'Belonging.', rotate: '-rotate-6' },
        { sticker: 'sticker-2.svg', text: 'Joyful movement.', rotate: 'rotate-6' },
        { sticker: 'sticker-3.svg', text: 'Embodied wellbeing.', rotate: '-rotate-3' },
      ].map((item) => (
        <div class="flex items-center gap-3">
          <div
            aria-hidden="true"
            class:list={['w-14 h-14 flex-shrink-0', item.rotate]}
            style={`background-color: var(--color-limber-vibe); -webkit-mask-image: url('/images/stickers/${item.sticker}'); mask-image: url('/images/stickers/${item.sticker}'); -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat; -webkit-mask-size: contain; mask-size: contain; -webkit-mask-position: center; mask-position: center;`}
          ></div>
          <p class="font-display italic text-xl text-limber-cream">{item.text}</p>
        </div>
      ))}
    </div>
    </div>{/* end left col */}

    <!-- Right: image -->
    <div class="mt-12 lg:mt-0">
      <img
        src="/images/Limber_April26_137.jpg"
        alt="Limber studio"
        class="w-full h-[480px] lg:h-[560px] object-cover rounded-2xl border-2 border-limber-vibe"
      />
    </div>

    </div>{/* end grid */}
  </FullBleedHero>

  <!-- ── MISSION ── -->
  <section class="bg-limber-green py-20 lg:py-28 border-b-2 border-limber-vibe">
    <div class="px-4 sm:px-6 lg:px-8">
      <div class="relative text-center">
        <p class="font-display italic text-xl text-limber-cream mb-5">Our mission</p>

        <h2 class="leading-none mx-auto max-w-3xl stacked-heading">
          <span class="font-display italic font-medium text-5xl md:text-6xl lg:text-7xl text-limber-cream block leading-none">To help people</span>
          <span class="font-headline uppercase text-4xl md:text-5xl lg:text-6xl text-limber-vibe block leading-none mt-4">feel at home</span>
          <span class="font-display italic font-medium text-5xl md:text-6xl lg:text-7xl text-limber-cream block leading-none">in their bodies</span>
        </h2>
        <img
          src="/images/stickers/green-sticker-3.svg"
          alt=""
          aria-hidden="true"
          class="absolute top-0 right-0 w-28 h-28 lg:w-40 lg:h-40 rotate-[10deg] pointer-events-none hidden lg:block"
          style="filter: brightness(0) saturate(100%) invert(66%) sepia(62%) saturate(625%) hue-rotate(338deg) brightness(1.05);"
        />
      </div>
    </div>
  </section>

  <!-- ── THE STARTING POINT ── -->
  <section class="bg-limber-green py-20 lg:py-28 border-b-2 border-limber-vibe">
    <div class="px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-2 lg:gap-16 items-center">

        <!-- Quote -->
        <blockquote class="border-l-4 border-limber-vibe pl-8">
          <p class="font-display italic text-2xl lg:text-3xl text-limber-cream leading-snug mb-6">
            "I danced professionally for years. It made me fall completely out of love with movement. Pilates gave me the joy back. And that's exactly what I wanted to build here. Limber exists to give people what movement is actually supposed to be. Joyful, healing, freeing."
          </p>
          <footer class="flex items-center gap-3 mb-8">
            <span class="font-headline text-sm text-limber-vibe">Lily, </span>
            <span class="font-display italic text-lg text-limber-cream">Founder</span>
          </footer>
          <a href="/journal/the-people-are-why-we-stayed" class="font-headline text-sm text-limber-vibe hover:text-limber-cream transition-colors">
            Read more about our story →
          </a>
        </blockquote>

        <!-- Photo -->
        <div class="mt-12 lg:mt-0 lg:max-w-[480px] lg:ml-auto">
          <img
            src="/images/overlapping/overlapping-lily-jumping.png"
            alt="Lily, founder of Limber"
            class="w-full h-72 lg:h-96 object-cover object-[center_25%] rounded-2xl border-2 border-limber-vibe"
          />
        </div>

      </div>
    </div>
  </section>

  <CtaSlice
    headingLine1="Ready to find"
    headingLine2="your people?"
    body="Come say hi, book a class, or just have a nosy around. We'd love to have you."
    image="/images/Limber_April26_176.jpg"
    imageAlt="Limber community"
    accentColor="text-limber-bright"
    primaryBtn="text-limber-brown bg-limber-bright hover:bg-limber-vibe border-limber-bright"
    sectionBg="bg-limber-cream"
    buttons={[
      { label: 'View memberships', href: '/pricing/memberships' },
      { label: 'See our classes', href: '/classes/our-classes', variant: 'outline' },
    ]}
  />

</BaseLayout>
