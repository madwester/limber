---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaSlice from '../../components/CtaSlice.astro';
import PricingHero from '../../components/PricingHero.astro';

const teamSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Limber Team',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      item: {
        '@type': 'Person',
        name: 'Lily',
        jobTitle: 'Founder',
        worksFor: { '@type': 'Organization', name: 'Limber' },
      },
    },
    {
      '@type': 'ListItem',
      position: 2,
      item: {
        '@type': 'Person',
        name: 'Maddy',
        jobTitle: 'Studio Lead',
        worksFor: { '@type': 'Organization', name: 'Limber' },
      },
    },
  ],
};
---

<BaseLayout
  title="Our Tribe"
  description="Meet the humans behind Limber — Lily, founder, and Maddy, studio lead."
  schema={teamSchema}
>

  <!-- ── HERO ── -->
  <PricingHero
    image="/images/Limber_team.jpg"
    imageAlt="The Limber team"
    imagePosition="object-center"
    body="passionate, qualified, and genuinely here for you. every class, every session, every check-in — we show up because we love what we do."
    buttons={[{ label: 'book a class', href: '/book-now' }]}
    bgColor="bg-limber-cream"
    onDark={false}
  >
    <p class="font-display italic text-xl text-limber-tericotta mb-4">the humans behind limber.</p>
    <h1 class="mb-0">
      <span class="font-headline uppercase text-4xl md:text-5xl lg:text-6xl text-limber-green block leading-none mb-1">our</span>
      <em class="font-display uppercase not-italic italic font-medium text-5xl md:text-6xl lg:text-7xl text-limber-tericotta block leading-none">tribe.</em>
    </h1>
  </PricingHero>

  <!-- ── LILY ── -->
  <section class="bg-limber-cream py-20 lg:py-28 border-b-2 border-neutral-900">
    <div class="px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-2 lg:gap-16 items-start">

        <!-- Photo -->
        <div class="mb-12 lg:mb-0 lg:sticky lg:top-28">
          <img
            src="/images/Limber_Lily.jpg"
            alt="Lily, founder of Limber"
            class="w-full h-[480px] lg:h-[600px] object-cover rounded-2xl border-2 border-neutral-900"
          />
        </div>

        <!-- Bio -->
        <div>
          <p class="font-headline text-xs text-limber-tericotta mb-3">meet the founder</p>
          <h2 class="mb-8">
            <em class="font-display uppercase not-italic italic font-medium text-5xl md:text-6xl lg:text-7xl text-limber-green block leading-none">lily.</em>
          </h2>
          <div class="space-y-5">
            <p class="font-sans text-limber-brown/80 leading-relaxed">
              from her early years to a thriving professional dance career, lily's love for movement has been at the heart of everything she does. after her dance career, she naturally discovered a passion for teaching, where she seamlessly blends her expertise to create movement that's not only effective but truly enjoyable.
            </p>
            <p class="font-display italic text-xl text-limber-tericotta leading-snug">
              for lily, movement is more than just a passion — it's a lifelong companion.
            </p>
            <p class="font-sans text-limber-brown/80 leading-relaxed">
              one that's supported her through every stage of life, from her dance career to embracing motherhood.
            </p>
            <p class="font-sans text-limber-brown/80 leading-relaxed">
              lily is dedicated to building a community where movement goes beyond physical well-being, serving as a powerful tool for self-discovery. she envisions limber as a welcoming space where prosperity flourishes, fuelled by the shared love for movement.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ── MADDY ── -->
  <section class="bg-limber-cream-bg py-20 lg:py-28 border-b-2 border-neutral-900">
    <div class="px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-2 lg:gap-16 items-start">

        <!-- Bio -->
        <div class="order-2 lg:order-1">
          <p class="font-headline text-xs text-limber-tericotta mb-3">meet the studio lead</p>
          <h2 class="mb-8">
            <em class="font-display uppercase not-italic italic font-medium text-5xl md:text-6xl lg:text-7xl text-limber-green block leading-none">maddy.</em>
          </h2>
          <div class="space-y-5">
            <p class="font-sans text-limber-brown/80 leading-relaxed">
              yoga first found maddy in her teenage years as a way to tend to an aching body, then as a quiet refuge for her heart and mind. through seasons of recovery, anxiety, and healing, she discovered that yoga is not about striving, but softening — not about fixing, but listening.
            </p>
            <p class="font-display italic text-xl text-limber-tericotta leading-snug">
              in time, this practice became her way of holding space for others to come home to themselves.
            </p>
            <p class="font-sans text-limber-brown/80 leading-relaxed">
              maddy specialises in pre and postnatal yoga and has pursued further training in pranayama, creative sequencing, and pelvic floor and women's health education. her classes offer a blend of strong, flowing movement and deeply grounding stillness. supporting each student to meet themselves with care, curiosity, and strength, no matter their season of life.
            </p>
            <p class="font-sans text-limber-brown/80 leading-relaxed">
              rooted in presence over perfection, her teaching honours the shifting nature of every body and every journey. whether guiding someone through early parenthood, returning from injury, or simply seeking connection, maddy invites students to trust their inner knowing, move with intention, and feel held just as they are.
            </p>
          </div>
        </div>

        <!-- Photo -->
        <div class="order-1 lg:order-2 mb-12 lg:mb-0 lg:sticky lg:top-28">
          <img
            src="/images/Limber_Maddy.jpg"
            alt="Maddy, studio lead at Limber"
            class="w-full h-[480px] lg:h-[600px] object-cover rounded-2xl border-2 border-neutral-900"
          />
        </div>

      </div>
    </div>
  </section>

  <CtaSlice
    headingLine1="come move"
    headingLine2="with us."
    body="book a class, start your intro trial, or just come say hi. we'd love to meet you."
    image="/images/Limber_April26_176.jpg"
    imageAlt="Limber community"
    buttons={[
      { label: 'book a class', href: '/book-now' },
      { label: 'start the limber way — $99', href: '/pricing/trial', variant: 'outline' },
    ]}
  />

</BaseLayout>
