---
import BaseLayout from '../../layouts/BaseLayout.astro';

const team = [
 {
 name: 'Instructor Name',
 role: 'Studio Founder & Lead Instructor',
 bio: 'Replace with bio — qualifications, specialisations, and what they love about movement.',
 },
 {
 name: 'Instructor Name',
 role: 'Pilates & Mobility Instructor',
 bio: 'Replace with bio — qualifications, specialisations, and what they love about movement.',
 },
 {
 name: 'Instructor Name',
 role: 'Reformer & Mat Instructor',
 bio: 'Replace with bio — qualifications, specialisations, and what they love about movement.',
 },
];

const teamSchema = {
 '@context': 'https://schema.org',
 '@type': 'ItemList',
 name: 'Limber Team',
 itemListElement: team.map((member, i) => ({
 '@type': 'ListItem',
 position: i + 1,
 item: {
 '@type': 'Person',
 name: member.name,
 jobTitle: member.role,
 worksFor: { '@type': 'Organization', name: 'Limber' },
 },
 })),
};
---

<BaseLayout
 title="Our Tribe"
 description="Meet the Limber team — the instructors and humans behind the studio who are here to support your movement journey."
 schema={teamSchema}
>
 <section class="bg-limber-green py-24 lg:py-36">
 <div class=" px-4 sm:px-6 lg:px-8">
 <a href="/about" class="inline-flex items-center gap-2 font-headline text-xs text-limber-cream/60 hover:text-limber-cream transition-colors mb-10">
 <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
 About
 </a>
 <p class="font-headline text-xs text-limber-vibe mb-4">About Us</p>
 <h1 class="font-headline text-5xl md:text-6xl lg:text-7xl text-limber-cream leading-tight mb-6">
 Our Tribe
 </h1>
 <p class="font-sans text-lg text-limber-cream/80 leading-relaxed">
 We're a passionate crew of movement geeks who genuinely care about helping you feel great in your body.
 </p>
 </div>
 </section>

 <section class="py-20 bg-limber-cream-bg">
 <div class=" px-4 sm:px-6 lg:px-8">
 <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10">
 {
 team.map((member, i) => {
 const bgs = ['bg-limber-green', 'bg-limber-tericotta', 'bg-limber-vibe'];
 return (
 <div>
 <!-- TODO: replace with real instructor photos -->
 <div class:list={['aspect-[3/4] rounded-2xl overflow-hidden mb-6', bgs[i % 3]]}>
 <div class="w-full h-full flex items-end p-5">
 <span class="font-headline text-xs text-white/40">Photo coming soon</span>
 </div>
 </div>
 <h2 class="font-headline text-2xl text-limber-green mb-0.5">{member.name}</h2>
 <p class="font-headline text-xs text-limber-tericotta mb-3">{member.role}</p>
 <p class="font-sans text-sm text-limber-brown/80 leading-relaxed">{member.bio}</p>
 </div>
 );
 })
 }
 </div>
 </div>
 </section>

 <section class="bg-limber-tericotta py-20">
 <div class=" px-4 sm:px-6 text-center">
 <h2 class="font-headline text-4xl md:text-5xl text-limber-cream mb-4">
 And then there's you
 </h2>
 <p class="font-sans text-limber-cream/80 leading-relaxed mb-8 ">
 <!-- TODO: community copy -->
 Our community is what makes Limber special. Members of all ages, abilities, and backgrounds coming together to move, support each other, and have a good time doing it.
 </p>
 <a href="/book-now" class="inline-flex items-center px-8 py-4 font-headline text-sm text-limber-tericotta bg-limber-cream hover:bg-limber-bright border-2 border-neutral-900 rounded-full transition-colors">
 Join the Community
 </a>
 </div>
 </section>
</BaseLayout>
